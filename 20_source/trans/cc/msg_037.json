[
 {
  "k": "387:15",
  "jh": "b43af83eea30",
  "eh": "46980f75f221",
  "ko": "즐거운 일……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:16",
  "jh": "ace1a463c3f6",
  "eh": "f8bfd5b111bd",
  "ko": "　　있잖아요, 그대가\\n　　좋아하던 노래를\\n　　들려주세요……{bpage}\\n　　내가 모르는\\n　　먼 세계의\\n　　멋진 노래를……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:17",
  "jh": "670cd12f3127",
  "eh": "4aac779e5f33",
  "ko": "노래……?{wait(15)}\\n그런 것,\\n나는 모르오.{bpage}\\n노래 따위 불러서\\n어쩌자는 거요?{bpage}\\n무슨 득이라도\\n있단 말이오?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:18",
  "jh": "21695bcedc30",
  "eh": "e748eb0f1fea",
  "ko": "가엾은 사람……{wait(15)}\\n노래는 사람을\\n행복하게 해요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:19",
  "jh": "c3ad5f630770",
  "eh": "841e341db533",
  "ko": "　　슬플 때는 그 슬픔을\\n　　다정하게 감싸 주고……{bpage}\\n　　즐거울 때는\\n　　함께 웃어 주죠.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:20",
  "jh": "9f858c962bae",
  "eh": "701a8cf21e93",
  "ko": "노래란\\n그런 거예요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:21",
  "jh": "b142e1b1a178",
  "eh": "9f531e01a530",
  "ko": "그렇소……{bpage}\\n하지만 안타깝게도\\n내게 노래는 상관없소.{bpage}\\n웃는 법도 우는 법도\\n오래전에 잊어버렸으니.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:22",
  "jh": "6274203e75e1",
  "eh": "85231bd89611",
  "ko": "몹시 그리운 느낌이오.{bpage}\\n아주 먼 옛날 어딘가에서\\n어렴풋이 들은 것 같은……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:23",
  "jh": "442d16f653e3",
  "eh": "9cd57da0cc11",
  "ko": "따스한 빛에 감싸이는 듯한\\n신비로운 노래로다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:24",
  "jh": "c5f7193a5add",
  "eh": "33cfc2d95a11",
  "ko": "우리 섬에 전해 오는\\n소중한 노래예요.{bpage}\\n노래를 모르는 그대의\\n마음에도 닿은 모양이네요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:25",
  "jh": "4acbcf1ed7ca",
  "eh": "1484a575fa35",
  "ko": "그럼 약속해요……{bpage}\\n그대를 구해 준 대가로\\n이 노래를 내게 불러 줘요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:26",
  "jh": "4cb1b54f4012",
  "eh": "27abf3a1c482",
  "ko": "기다려 주오!\\n그런 일은\\n내겐 무리요!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:27",
  "jh": "c6c4b01de0f0",
  "eh": "2ec8336678ba",
  "ko": "“못 하는” 것과\\n“안 하는” 것은 달라요.{wait(15)}\\n약속이에요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:28",
  "jh": "6c7b661ee8e6",
  "eh": "70502d66ccf2",
  "ko": "기다려……\\n가지 마오!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:29",
  "jh": "d558de601c1c",
  "eh": "eabe85368041",
  "ko": "{color(GRAY)}하아……{color(0)}\\n역시 나에게\\n음악 따윈\\n무리로다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:30",
  "jh": "0a07277192c6",
  "eh": "0fccdc73a62b",
  "ko": "곤란한 모양이네요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:31",
  "jh": "2ead079090dc",
  "eh": "6c2ac8d44ab0",
  "ko": "그대들은……!?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:32",
  "jh": "2e1ca30d97bd",
  "eh": "1252659d9df3",
  "ko": "언니는\\n그대가 노래할 때까지\\n나오지 않을 거예요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:33",
  "jh": "6bc31e168247",
  "eh": "2d4f34b8f648",
  "ko": "부탁이오!\\n내게 노래를 가르쳐 주오.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:34",
  "jh": "ef9aff3ee7e5",
  "eh": "dd973fa213b9",
  "ko": "음악과 노래는\\n가르치거나 배우는 게\\n아니에요.{bpage}\\n느끼는 거죠!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:35",
  "jh": "95279cab0b72",
  "eh": "460b0b16b22f",
  "ko": "우선 소리를\\n내 봐요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:36",
  "jh": "329c29b94fae",
  "eh": "d615d51fc463",
  "ko": "……안 되겠네요.\\n아무 감정도\\n담겨 있지 않아요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:37",
  "jh": "3431e433bc0a",
  "eh": "28e17c2fe51f",
  "ko": "잘하지 않아도 되니까\\n자기 마음을 담아야 해요.{bpage}\\n말로는 표현할 수 없는\\n그대의 마음을……{bpage}\\n그대의 악기로\\n들려주세요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:38",
  "jh": "5679b3217fea",
  "eh": "2789be8a669e",
  "ko": "그래요……{wait(30)}\\n그대로 계속해요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:39",
  "jh": "22f004cf69bf",
  "eh": "d8e652794d34",
  "ko": "그대는\\n다정한 사람이군요.{wait(15)}\\n소리를 들으면 알아요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:40",
  "jh": "f548609ac95f",
  "eh": "8d4481053419",
  "ko": "후후…… 바로 그거예요!{wait(15)}\\n왠지 즐거워지네요!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:41",
  "jh": "f35ed07bb8db",
  "eh": "73bd50f439f2",
  "ko": "어떻소……?{wait(15)}\\n그대 생각은?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:42",
  "jh": "36cd18da3cdb",
  "eh": "962778c41d38",
  "ko": "정말 멋져요……\\n음 하나하나가\\n온몸을 감싸는 듯해요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:43",
  "jh": "68d4807a498a",
  "eh": "e91c9b169931",
  "ko": "그럼 내게로 오오,\\n사랑스러운 바다의 요정이여……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:44",
  "jh": "17c0f3d22790",
  "eh": "c375a5c32182",
  "ko": "온 세상이 손을 맞잡고\\n살 수 있는 날이 오면……{bpage}\\n그날 나는 반드시 그대를\\n이 아름다운 섬으로\\n데려오리다.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:45",
  "jh": "67b949cb119c",
  "eh": "c5911edf994b",
  "ko": "그리고……{wait(15)}\\n그제야 비로소……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:46",
  "jh": "79d15cf798d3",
  "eh": "72ba0b091f86",
  "ko": "인간과 자연이\\n함께 살 수 있는……{bpage}\\n그리고 이 노래가\\n언제까지나 울려 퍼지는……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:47",
  "jh": "120bb16c4974",
  "eh": "6780b176b35a",
  "ko": "그런 멋진 세계를\\n함께 만들어 가오.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:48",
  "jh": "976f6732189a",
  "eh": "5b2b3d8b8e5e",
  "ko": "자, 그대여……\\n오시오!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:49",
  "jh": "c7560e84a641",
  "eh": "97cbcc81a355",
  "ko": "이기는 것이\\n전부였던 나날은\\n끝났다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:50",
  "jh": "03890d2692be",
  "eh": "1137fb6fc789",
  "ko": "어제의 벗은 내일의 적……{wait(15)}\\n그것은 배신과 증오의\\n나날이었다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:51",
  "jh": "ef615b3a4280",
  "eh": "56bfcbefde6b",
  "ko": "정상에 오르고 나면\\n남는 것은\\n추락뿐……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:52",
  "jh": "7ce09d6306ed",
  "eh": "fb1edad2ab53",
  "ko": "모든 것을 잃고……\\n영광의 훈장이었던\\n무수한 상처들도\\n아파 오기 시작한다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:53",
  "jh": "606f4a83a2fa",
  "eh": "c8b2ee32d0d9",
  "ko": "아아, 깨어났는가……?\\n여기는 어디인가……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:54",
  "jh": "56671273c591",
  "eh": "385aa1ff9da2",
  "ko": "바다 어딘가에 숨어 있다는\\n고래들의 무덤인가……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:55",
  "jh": "dfdf3155781d",
  "eh": "1e3bd652cab6",
  "ko": "이쪽……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:56",
  "jh": "a8301d57f701",
  "eh": "3dcd88986074",
  "ko": "누가 있는가……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:57",
  "jh": "d01efb653fee",
  "eh": "8bd78a9f0313",
  "ko": "이쪽이에요……!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:58",
  "jh": "5504d7e1052e",
  "eh": "ae1590cb1155",
  "ko": "그대가 만약\\n슬픔 끝에\\n절망하게 된다면……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:59",
  "jh": "5842cee6f819",
  "eh": "23a4810c64a9",
  "ko": "이 노래를 흥얼거리며\\n떠올려 줘요……{bpage}\\n지금 이 순간……\\n그대와 나의 마음이\\n서로 울리고 있었다는 걸……{bpage}\\n그리고 그것은\\n영원히 이어지는\\n노래라는 걸……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:60",
  "jh": "2d330a2dff78",
  "eh": "c2e88038f6ff",
  "ko": "보세요! 별들이\\n우리 노래에 맞춰\\n반짝이고 있어요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:61",
  "jh": "78fe3190b71f",
  "eh": "775842c3d117",
  "ko": "가장 밝게 빛나는 저것이\\n디어머드의 별……{bpage}\\n그리고 그 옆에 희미하게\\n보이는 것이 그라냐의 별……{bpage}\\n우리 뱃사람은 저 두 별을\\n길잡이 삼아\\n배를 몰지!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:62",
  "jh": "ac5c830cdab8",
  "eh": "c22a353d6d0f",
  "ko": "잘 아시네요!\\n별에 이름이 있는 줄은\\n몰랐어요.{bpage}\\n그저 밤하늘에 빛나는\\n보석 같은 거라고만\\n생각했어요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:63",
  "jh": "dea89d0bac26",
  "eh": "ca27651e5f16",
  "ko": "나는 별이 이토록\\n아름다운 줄\\n몰랐소……{bpage}\\n이렇게 느긋하게\\n별을 바라보는 것조차\\n예전의 나는 못 했지……{bpage}\\n별들은 언제나 내게\\n노래하고 있었는데도.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:64",
  "jh": "476cc5c237de",
  "eh": "1fd9632e9093",
  "ko": "요 며칠\\n그대와 날마다\\n노래하면서……{bpage}\\n눈에 보이는 것만이\\n전부가 아님을\\n깨달았소……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:65",
  "jh": "e759598d328e",
  "eh": "5f847d67322b",
  "ko": "별들이 반짝이는 소리도……{wait(15)}\\n파도가 우는 소리도……{wait(15)}\\n침묵마저도……{bpage}\\n모두가 그대와 나와\\n함께 노래하고 있소……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:66",
  "jh": "c31ebaf02fdf",
  "eh": "2091508316bb",
  "ko": "그대가 살던 세계도\\n같은 별 아래 있다니\\n참 신기해요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:67",
  "jh": "732215d1d8e7",
  "eh": "4975a3d44e1e",
  "ko": "그러고 보니\\n나는 곧 내 세계로\\n돌아가야 하오.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:68",
  "jh": "0c1d210e9915",
  "eh": "6dbc3fd937d1",
  "ko": "어째서요?\\n여기가 싫은가요?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:69",
  "jh": "4ad5f7806a27",
  "eh": "9d0a31c60e77",
  "ko": "추격자들이 가까이 왔소……\\n내가 여기 있으면\\n그대들이 위험해지오……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:70",
  "jh": "712d96b32b2a",
  "eh": "39ee2b38ceba",
  "ko": "그럼 나도\\n함께 가게 해 줘요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:71",
  "jh": "060d27e785eb",
  "eh": "3312f1116b8b",
  "ko": "그런 위험한 일은\\n허락할 수 없소!{bpage}\\n여기서 한 발짝만 나가면\\n거센 폭풍과\\n슬픈 싸움이 기다리고 있소.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:72",
  "jh": "69e9d9804b95",
  "eh": "72cf27852dc6",
  "ko": "그래도……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:73",
  "jh": "9d269c52dcfd",
  "eh": "b83a547b9446",
  "ko": "그래도 그대는\\n나와 함께\\n가겠다는 거요?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:74",
  "jh": "a002b4b66b1e",
  "eh": "3f8dee3679b5",
  "ko": "그건 알고 있어요……{bpage}\\n하지만 세상 어딘가에\\n싸움이 있는데\\n여기만 평화롭다니……\\n그건 이상한 거예요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "387:75",
  "jh": "17648ee006ae",
  "eh": "9b33ad963f7d",
  "ko": "우리가 나누는 사랑을\\n온 세상과 나눌 수\\n있을지도 몰라요.{bpage}\\n분명 모든 사람과 자연이\\n손을 맞잡을 수\\n있을 거예요……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "388:0",
  "jh": "2a29b33e77df",
  "eh": "d83c4cd88c00",
  "ko": "현자:\\n호호오……{wait(15)}\\n마침내 해냈구먼,\\n그 녀석들!{bpage}\\n자, 모두 보게나.\\n우리 마블이 눈앞일세.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "388:1",
  "jh": "89a56c617ba6",
  "eh": "97ac93fe25e0",
  "ko": "현자:\\n자……\\n바다 백성의 근성을\\n보여 주자꾸나!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "388:2",
  "jh": "bbec11cfdd14",
  "eh": "5a8da78d00cc",
  "ko": "현자:\\n나머지는 자네들\\n하기에 달렸네……{mend}",
  "status": "draft",
  "note": ""
