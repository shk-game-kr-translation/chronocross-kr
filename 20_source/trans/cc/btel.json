 {
  "k": "478:0",
  "jh": "82194acb7e59",
  "eh": "8fe035b0c19b",
  "ko": "솔튼:\\n이번엔 지지 않습니다!{bpage}\\n슈가르가 사 주신 강력하게 강력한\\n엘레멘트로 산산조각 내\\n버리겠습니다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:1",
  "jh": "2afca3d72702",
  "eh": "6b3299b18962",
  "ko": "슈가르:\\n그 소환 엘레멘트 말인 거다?\\n이제 흔들리는 거다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:2",
  "jh": "b2b46accbf78",
  "eh": "2fe98081ab9c",
  "ko": "솔튼:\\n비극적으로 비극적입니다!!!\\n말씀드리기 뭣하지만, 슈가르……{bpage}\\n가지고 있던 소환 엘레멘트를\\n잃어버린 게 방금 생각났습니다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:3",
  "jh": "7554e0f749b3",
  "eh": "59ae013293ca",
  "ko": "슈가르:\\n……!?\\n“잃어버렸다”니 무슨 소리인 거다?{bpage}\\n떨어뜨렸다거나 개가 먹었다거나\\n그런 바보 같은 핑계는 아닌 거다?{bpage}\\n제대로 한번 흔들려 보고 싶은 거다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:4",
  "jh": "bd183a048392",
  "eh": "3c12e892c4c0",
  "ko": "솔튼:\\n저 그렇게 바보같이\\n바보는 아닙니다, 슈가르!{bpage}\\n사실을 말씀드리자면……\\n히드라 늪의 지네 괴물에게\\n도둑맞았습니다!{bpage}\\n그때까지는 신나게 신나는\\n탐사였는데……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:5",
  "jh": "36f0a002fb58",
  "eh": "76b0595bca52",
  "ko": "슈가르:\\n지네 괴물이 엘레멘트를\\n훔쳤다니 무슨 소리인 거다???{bpage}\\n뒤로 몰래 와서 수백 개 다리로\\n주머니를 다 털어 간\\n거다!?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:6",
  "jh": "20cca0805551",
  "eh": "ac6c925d4336",
  "ko": "솔튼:\\n아뇨, 슈가르.{bpage}\\n훔쳤다는 건 소매치기했다는\\n뜻이 아닙니다!{bpage}\\n트랩 엘레멘트를 깔아서 제 엘레멘트가\\n걸려들게 해 빼앗았다는 뜻입니다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:7",
  "jh": "b01fc127592a",
  "eh": "dfb8c1ea9385",
  "ko": "슈가르:\\n대체 무슨 소리인 거다?{bpage}\\n그 흔들리는 트랩 엘레멘트가\\n뭔지 설명해 보는 거다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:8",
  "jh": "cd1cc1e2ed00",
  "eh": "1e6c79a9fdef",
  "ko": "솔튼:\\n그게……{wait(10)}\\n음……{bpage}\\n말로 설명하기가 어렵게 어려우니\\n직접 보여 드리겠습니다, 슈가르.{bpage}\\n제가 슈가르 앞에 트랩을 깔 테니\\n슈가르는 특제 엘레멘트를\\n하나 써 보십시오.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:9",
  "jh": "9a2457c94cb0",
  "eh": "3c1072620811",
  "ko": "슈가르:\\n좋아.\\n해 보는 거다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:10",
  "jh": "ad80bef69718",
  "eh": "8f5e56069d10",
  "ko": "솔튼:\\n알겠습니다, 슈가르!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:11",
  "jh": "fa1d2936dfb7",
  "eh": "743ccf66a6ef",
  "ko": "솔튼:\\n보셨죠? 제가 슈가르의\\n엘레멘트를 빼앗은 걸?{bpage}\\n“블랙홀” 엘레멘트만 잡는\\n전용 트랩 엘레멘트를 썼습니다!{bpage}\\n트랩 엘레멘트는 한 종류의\\n엘레멘트에만 통합니다.{bpage}\\n정해진 것 말고 다른 엘레멘트는\\n잡을 수 없습니다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:12",
  "jh": "7c04b84dd935",
  "eh": "bff88ab40f6c",
  "ko": "슈가르:\\n흔들린다!{wait(10)}\\n흐음……{bpage}\\n소환 엘레멘트를 도둑맞았다는 게\\n무슨 말인지 알겠는 거다……{bpage}\\n좋아, 이제 알았다.{wait(10)}\\n그럼 내 블랙홀 엘레멘트를\\n돌려주는 거다!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:13",
  "jh": "71d80d45564a",
  "eh": "5ecbe65570ef",
  "ko": "솔튼:\\n앗!\\n말씀드렸어야 했는데.\\n돌려드릴 수가 없습니다.{bpage}\\n다른 몬스터가 어리석게도\\n엘레멘트를 잡히지 않는 한\\n그 엘레멘트는 다시 못 얻습니다……{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:14",
  "jh": "2b63b96c6e3e",
  "eh": "40cdfae1f484",
  "ko": "슈가르:\\n어……?{bpage}\\n뭐, 상관없는 거다. 이제 네가\\n갖고 있으니까……{bpage}\\n그럼……{wait(10)} 방금 잡은 그 엘레멘트를\\n어서 적에게\\n쓰는 거다!{bpage}\\n자! 뭘 기다리는 거다?{bpage}\\n어……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "478:15",
  "jh": "61246cbb7945",
  "eh": "618951a744aa",
  "ko": "솔튼:\\n엘레멘트는 제대로 장비해야\\n쓸 수 있다는 거 아시잖습니까!{bpage}\\n그러니 이 전투가 끝나고 다시\\n장비해야 쓸 수 있습니다!{bpage}\\n……{wait(20)}\\n앗!{mend}",
  "status": "draft",
  "note": ""
 },
 {
