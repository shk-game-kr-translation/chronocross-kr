 {
  "k": "418:0",
  "jh": "96e507529262",
  "eh": "ec47f7439008",
  "ko": "토룡:\\n{speed(80)}……때가 찼느니라.{bpage}\\n운명이라는 이름의 영원한 사슬을\\n끊으려는 자에게\\n나의 힘을 내리겠노라.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:1",
  "jh": "5f099ca0e919",
  "eh": "322fb7cae487",
  "ko": "토룡:\\n{speed(96)}그대는 무엇을 바라느냐?\\n　　　바라는 것은 없다\\n　　　용신의 가호를{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:2",
  "jh": "5949ccf5da44",
  "eh": "1bc409c54594",
  "ko": "토룡:\\n죽음의 바다를 건너기 위해\\n우리 잠든 용들의 힘이\\n필요하단 말이냐?{bpage}\\n운명의 사슬을 끊으려\\n한단 말이냐?\\n인간의 자식이 운명의 여신에게\\n맞서려 한단 말이냐?{bpage}\\n{speed(64)}흥미롭구나……\\n그렇다면 나의 시련을 넘어 보거라.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:3",
  "jh": "8483b262d1c6",
  "eh": "4e528c452a80",
  "ko": "토룡:\\n{speed(80)}……훌륭하도다, 인간의 자식이여.{bpage}\\n그 강함은 나의 힘을\\n받을 자격이 있느니라.\\n나의 기도를 가져가거라.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:4",
  "jh": "cb31e25a91c1",
  "eh": "8c3a89610854",
  "ko": "토룡:\\n{speed(96)}……약하도다.{wait(5)}\\n그대들의 힘은 고작 그 정도냐?\\n나를 실망시키지 마라.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:5",
  "jh": "8705d0f7ee99",
  "eh": "7dac40147122",
  "ko": "토룡:\\n{speed(96)}아까의 기세는 어디로 갔느냐?{bpage}\\n나를 쓰러뜨리지 못한다면\\n운명의 여신에게는\\n상대조차 되지 않으리라.{bpage}\\n여기서 걸음을 멈추겠느냐,\\n운명에 묶인 채 살아가겠느냐?\\n　　　지금은 포기한다\\n　　　다시 한번 시련을 받는다{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:6",
  "jh": "b09d7209c4a2",
  "eh": "6ea2d821d580",
  "ko": "토룡:\\n{speed(96)}다시 한번 나의 시련에\\n도전하겠다는 것이냐.{bpage}\\n그 기개, 갸륵하도다……\\n잃어버린 힘을\\n되돌려 주마.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "418:7",
  "jh": "c5c8b03b1de8",
  "eh": "357b0ef2fa04",
  "ko": "토룡:\\n자, 오너라!{wait(20)}\\n그대의 힘을 보여 다오,\\n인간의 자식이여!{mend}",
  "status": "draft",
