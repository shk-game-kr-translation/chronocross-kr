 {
  "k": "434:0",
  "jh": "0759724ca67c",
  "eh": "a78c3ba86269",
  "ko": "으음.{bpage}\\n아무래도 천룡은\\n이 섬을 떠난 모양이야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:1",
  "jh": "0759724ca67c",
  "eh": "a78c3ba86269",
  "ko": "으음.{bpage}\\n아무래도 천룡은\\n이 섬을 떠난 모양이야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:2",
  "jh": "5039caadca1e",
  "eh": "368b5b362cc5",
  "ko": "위쪽 분위기가\\n아무래도 이상해.{bpage}\\n아, 아니, 난 안 가.\\n가 보려면 너희끼리 가.\\n하하하…… {color(GRAY)}식은땀……{color(0)}{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:3",
  "jh": "40cf94e3a5a2",
  "eh": "da055c65bb97",
  "ko": "이 섬은 천룡이 사는 곳이라고\\n전해졌는데\\n어디론가 가 버린 모양이야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:4",
  "jh": "7461dc868006",
  "eh": "019c7c2ccf6b",
  "ko": "지하에는 전설의 용인들의\\n유적이 있다고 해.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:5",
  "jh": "65ea5447690e",
  "eh": "a44a05944015",
  "ko": "천룡님이 떠나셨다고\\n주민들이 난리야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:6",
  "jh": "65ea5447690e",
  "eh": "a44a05944015",
  "ko": "천룡님이 떠나셨다고\\n주민들이 난리야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:7",
  "jh": "afff5d038167",
  "eh": "9c735a551459",
  "ko": "천룡님이 돌아오셨다고\\n주민들이 난리야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "434:8",
  "jh": "29aff7fad40c",
  "eh": "28d0dcea855d",
  "ko": "이 섬은 주민들이 절대\\n가까이 가지 않는 신성한 곳이야.{bpage}\\n하지만 모험가의 끝없는\\n탐구심에 금기 따윈 없지.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "435:0",
  "jh": "6d34c4108d4a",
  "eh": "4dc829ff5cd2",
  "ko": "여기는 옛 용인들의\\n유적이 아닐까요?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "435:1",
  "jh": "f8bc63adeba1",
  "eh": "1f32d1a67d37",
  "ko": "이 나무 아래에\\n석상이 잔뜩 늘어서 있어요.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "436:0",
  "jh": "83f62bd2b556",
  "eh": "fe879581e3f4",
  "ko": "약 100년 전 대륙 사람들이\\n이 땅에 들어오기 전까지는\\n용족과 아인이\\n아직 많이 남아 있었대.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "436:1",
  "jh": "4433b05dbce6",
  "eh": "640a2004bc21",
  "ko": "이 섬은 그 용족들이\\n남긴 유적인 것 같아.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:0",
  "jh": "f2b7a446724b",
  "eh": "63a185b15ced",
  "ko": "어이,\\n네 배는 찾았냐?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:1",
  "jh": "8bd5cafceb00",
  "eh": "e871e2cc1cc8",
  "ko": "그 녀석은 나가 버렸어.{bpage}\\n은자의 오두막에 간다고\\n하던데.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:2",
  "jh": "2b6a883040d7",
  "eh": "f15fc7f2f3d1",
  "ko": "뭐야, 본체는 그렇게\\n쪼그만 녀석이었어?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:3",
  "jh": "027499a6f46d",
  "eh": "ab49baa926aa",
  "ko": "여긴 엄청난 몬스터가\\n있다고!{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:4",
  "jh": "9b1f92f5b2b8",
  "eh": "41c5db9a4291",
  "ko": "그런데 별의 조각을\\n안 갖고 있으면\\n덤비지 않는 모양이야.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "437:5",
  "jh": "754a4fb829e9",
  "eh": "dd738a5b16b0",
  "ko": "여기 몬스터를 만나고 싶으면\\n해파리 바다에 있는\\n별의 조각을 가져오지 그래?{bpage}\\n다만 별의 조각이\\n있는 곳은 트로픽스의\\n둥지란 걸 명심해!{mend}",
  "status": "draft",
  "note": ""
 },
 {
