 },
 {
  "k": "403:0",
  "jh": "9799790e2d6e",
  "eh": "de0b118114d7",
  "ko": "주술 의사:\\n말도 안 돼!?\\n자네들이\\n흑룡을 잠재웠다고?{bpage}\\n말도 안 돼, 믿을 수 없어.\\n만약 그게 사실이라면\\n자네들은……{bpage}\\n아니, 아무것도 아냐!\\n난 인정 못 해.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "403:1",
  "jh": "adf0c81262b0",
  "eh": "0d40ff083161",
  "ko": "주술 의사:\\n용이다!\\n흑룡이 깨어났어!{bpage}\\n벌써 몇 년이나\\n잠들어 있어서\\n안 깨어날 줄 알았는데\\n마침내 깨어났구먼!{bpage}\\n대체 무슨 일이\\n일어난 게야!?{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "403:2",
  "jh": "008ac04f9f73",
  "eh": "614af928c190",
  "ko": "주술 의사:\\n……\\n호오, 별일이구먼.{bpage}\\n겉모습은 아인인데\\n속은 인간이라고?{bpage}\\n흥, 그 저주는\\n내가 풀 수 없어.\\n썩 가거라, 인간.{mend}",
  "status": "draft",
  "note": ""
 },
 {
  "k": "403:3",
  "jh": "13cfe2ac2a81",
  "eh": "f89d3e197fbd",
