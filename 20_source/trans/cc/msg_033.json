  "status": "draft",
  "note": ""
 },
 {
  "k": "346:10",
  "jh": "01fb06837a19",
  "eh": "ba99af4d5c2b",
  "ko": "{MARCY%}:\\n그런데 이 반짝반짝한\\n조각들은 뭐야……?{mend}",
  "status": "draft",
  "note": ""
 },
 {
