[
 {
  "k": "4",
  "id": "3",
  "jh": "4fc100439d52",
  "eh": "0fd0b8d1d118",
  "ko": "월드 맵이나 운명의 서 근처에서\n\n파티 멤버를 교체할 수\n\n있습니다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "7",
  "id": "6",
  "jh": "3580e5861690",
  "eh": "1f8b8387fe99",
  "ko": "키키의 아버지가 10년 전 어부가\n\n되기로 결심했을 때 만든\n\n사자상어 이빨 부적.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "10",
  "id": "9",
  "jh": "a18c26f978a2",
  "eh": "4d7e7eb02dc9",
  "ko": "별빛을 띤 작은 부적.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "13",
  "id": "12",
  "jh": "e693405afbd1",
  "eh": "c7977155b860",
  "ko": "이 방울 소리에 늪의 식물이 반응해\n\n직접 건드리지 않아도 휘어져\n\n길이 열린다고 한다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "16",
  "id": "15",
  "jh": "02ba2d0ed817",
  "eh": "1156b3386681",
  "ko": "이거, 피파족에 전해지는 신기한\n\n피리인 거다나. 이걸로 로잘리를\n\n길들일 수 있는 거다나.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "19",
  "id": "18",
  "jh": "620d57702566",
  "eh": "0b29bc61c861",
  "ko": "가라이가 쓰던 전설의 용의 검.\n\n마검 그랜드리온의 사기를\n\n떨칠 수 있는 유일한 검.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "22",
  "id": "21",
  "jh": "2e414e035439",
  "eh": "b75b8d9bc57f",
  "ko": "루카가 만든, 불 끄는 데 딱 맞는\n\n급속 냉동총.\n\n어린이는 만지면 안 된다고 한다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "25",
  "id": "24",
  "jh": "42f1abf1262a",
  "eh": "4b38ef16d736",
  "ko": "수룡에게 받은, 펄펄 끓는 마그마도\n\n얼려 버리는 차가운\n\n숨결.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "28",
  "id": "27",
  "jh": "080a89296b6d",
  "eh": "4a1e36f1be8a",
  "ko": "헤케란의 정강이뼈. 수프 육수를\n\n내거나 스튜를 끓이면\n\n맛있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "31",
  "id": "30",
  "jh": "3a0f86ff54aa",
  "eh": "c6aaa8b0e843",
  "ko": "화석 계곡에서만 피는\n\n아름다운 파란 꽃.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "34",
  "id": "33",
  "jh": "5260245a3cf7",
  "eh": "305ec9eb5739",
  "ko": "화석 계곡에서 주운 거대한 알.\n\n무슨 알인지는 알 수 없다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "37",
  "id": "36",
  "jh": "d676407e0538",
  "eh": "4671d939f6ba",
  "ko": "광대 화장을 한 해골.\n\n잃어버린 기억과 몸을 찾고 있다고\n\n한다. 보기보다 무겁다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "40",
  "id": "39",
  "jh": "519f87dffdb0",
  "eh": "902a8b8573e7",
  "ko": "생전에 할머니의 가르침이 좋았는지\n\n자세가 아주 바른\n\n등뼈였던 것 같다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "43",
  "id": "42",
  "jh": "fa7be7022e52",
  "eh": "af7ed878e907",
  "ko": "생전에 공 타기부터 공중그네까지\n\n뭐든 해내는 다부진\n\n체격이었던 것 같다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "46",
  "id": "45",
  "jh": "34d531b9aff5",
  "eh": "a5752c862c73",
  "ko": "생전에 허리가 아주 튼튼했던\n\n것 같다. 무슨 일이든\n\n허리가 중요하다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "49",
  "id": "48",
  "jh": "38c18880205b",
  "eh": "a1e87450dcca",
  "ko": "생전에 늘 무언가에 분노하고 있었다.\n\n그건 자신에 대한 분노였는지도\n\n모른다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "52",
  "id": "51",
  "jh": "5fb080519b6a",
  "eh": "5fe28a309a06",
  "ko": "어느 게 어느 뼈인지 알 수 없다.\n\n적당히 맞춰 붙이는 수밖에\n\n없을 것 같다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "55",
  "id": "54",
  "jh": "1799f9f656a2",
  "eh": "56179ad51878",
  "ko": "몸에 지니고 식물을 조사하면\n\n열매가 달라붙는\n\n효능이 있다고 한다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "58",
  "id": "57",
  "jh": "174ee838a306",
  "eh": "61bf0a054b7e",
  "ko": "가르디아 지방에서만 나는 귀한\n\n진미 모케모케 버섯……\n\n과 닮은 버섯.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "61",
  "id": "60",
  "jh": "2f833af46f6d",
  "eh": "31c66e6874db",
  "ko": "사골관 본관 입구 열쇠. 용사육장\n\n할아버지에게서 빌린 것.\n\n사골의 문장이 새겨져 있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "64",
  "id": "63",
  "jh": "9215e7e585ac",
  "eh": "f12cb1043d74",
  "ko": "히드라 체액으로 정제한 해독제.\n\n히드라의 독을 중화하는\n\n유일한 방법.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "67",
  "id": "66",
  "jh": "01c0e440d1d7",
  "eh": "e2c2696e7d57",
  "ko": "사골관 지하에서 주운 객실 열쇠.\n\n게으른 병사가 숨겨 둔\n\n모양이다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "70",
  "id": "69",
  "jh": "ec7f0fc5983b",
  "eh": "403bd716a4c1",
  "ko": "사골관 지하 감옥을 열 수\n\n있는 열쇠.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "73",
  "id": "72",
  "jh": "7fbf5b3fe730",
  "eh": "d97f18ad2bf6",
  "ko": "전설의 비보 중 하나. 상대와 정신을\n\n바꿔 몸을 빼앗는 등\n\n신비한 힘이 있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "76",
  "id": "75",
  "jh": "c650e2eb342f",
  "eh": "b7ba0415d197",
  "ko": "천룡의 섬에서 천룡에게 받은\n\n백룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "79",
  "id": "78",
  "jh": "59730895bc2a",
  "eh": "66951d66fa11",
  "ko": "마블에서 흑룡에게 받은\n\n흑룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "82",
  "id": "81",
  "jh": "be77d9ad8e5b",
  "eh": "30081b202eef",
  "ko": "사염산에서 화룡에게 받은\n\n적룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "85",
  "id": "84",
  "jh": "2afba2523a3b",
  "eh": "7e713468856a",
  "ko": "수룡의 섬에서 수룡에게 받은\n\n청룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "88",
  "id": "87",
  "jh": "8ba5f786357b",
  "eh": "b279df214383",
  "ko": "토룡의 섬에서 토룡에게 받은\n\n황룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "91",
  "id": "90",
  "jh": "44fefd29cd7c",
  "eh": "377cdd12348e",
  "ko": "세계의 배꼽에서 녹룡에게 받은\n\n녹룡신의 비보.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "94",
  "id": "93",
  "jh": "05a2b5eeeb2e",
  "eh": "f922ff0ec477",
  "ko": "인조인간 식물 개량종 피오에게\n\n생명을 줄 수 있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "97",
  "id": "96",
  "jh": "5184ca6d6fe7",
  "eh": "7da49cf6a546",
  "ko": "도마뱀 비늘로 찰랑찰랑한 목걸이를\n\n만드는 게 아르니 마을\n\n여자애들 사이에서 유행 중.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "100",
  "id": "99",
  "jh": "b1fd208d2208",
  "eh": "61f28c80291f",
  "ko": "불가사리처럼 보이지만\n\n비밀의 힘이 있다고 한다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "103",
  "id": "102",
  "jh": "5b5f919fb1a3",
  "eh": "596e88b750fa",
  "ko": "고도의 기술로 만들어진\n\n복제 불가능한 카드형\n\n암호 키.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "106",
  "id": "105",
  "jh": "bb4ff2a74f34",
  "eh": "52c1a6b1169c",
  "ko": "조사대가 쓰는 폭약.\n\n위험물이므로 취급 주의.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "109",
  "id": "108",
  "jh": "1f530bd23e68",
  "eh": "33a90499b43c",
  "ko": "용의 눈물 조각.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "112",
  "id": "111",
  "jh": "1f530bd23e68",
  "eh": "33a90499b43c",
  "ko": "용의 눈물 조각.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "115",
  "id": "114",
  "jh": "19a67e65ab5c",
  "eh": "6c25ffc3f755",
  "ko": "이 패스가 없으면\n\n개찰구를 지날 수 없다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "118",
  "id": "117",
  "jh": "f0b85bc54067",
  "eh": "7f8a6197e131",
  "ko": "로잘리한테 붙어 있던 씨앗, 피파족이\n\n키운 거다나. 한입 먹으면\n\n로잘리는 만족하는 거다나.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "121",
  "id": "120",
  "jh": "4fef6a199894",
  "eh": "15022a39ae86",
  "ko": "정교한 세공이 된 작은\n\n펜던트.\n\n다리오 어머니의 유품.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "124",
  "id": "123",
  "jh": "ed58435c6af9",
  "eh": "1853c89be7b2",
  "ko": "한쪽이 소켓 모양인\n\n크랭크 핸들. 카지노\n\n속임수의 증거품.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "127",
  "id": "126",
  "jh": "c473a6a81a48",
  "eh": "d8767d22ee99",
  "ko": "가라이의 추억이 어떤 것이었는지\n\n이제 와서는 알 길이\n\n없다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "130",
  "id": "129",
  "jh": "d712fdddc85b",
  "eh": "46ea5755f471",
  "ko": "실전에는 쓸모없어 보인다.\n\n오로지 장식용으로 만든\n\n예쁜 방패.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "133",
  "id": "132",
  "jh": "bd164d4708d8",
  "eh": "3df98ad71dda",
  "ko": "한쪽 집게가 보석처럼 파랗게 빛나는\n\n농게 조각상. 밀물과 썰물을\n\n조종할 수 있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "136",
  "id": "135",
  "jh": "2007bec6b2b2",
  "eh": "91d912085926",
  "ko": "잃어버린 일곱 번째 색 속성을 지닌\n\n궁극의 엘레멘트.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "139",
  "id": "138",
  "jh": "1fb78f2f50a8",
  "eh": "16b886312642",
  "ko": "독 늪 등에 가볍게 들어가는\n\n초보자를 위해 조사대가\n\n여분으로 준비한 방독복.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "142",
  "id": "141",
  "jh": "d86f8077b5d0",
  "eh": "02dea7f8220e",
  "ko": "둘로 쪼개진 듯한 파란 돌이\n\n박힌 브로치.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "145",
  "id": "144",
  "jh": "3159cf63d654",
  "eh": "b842ba28d1f9",
  "ko": "극장 폐허에서 주운\n\n연극용 소품 검.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "148",
  "id": "147",
  "jh": "98fd799f0265",
  "eh": "d76bd58e9cf3",
  "ko": "용의 신사에 예부터 전해지는\n\n전통 문장. 어디선가 본 듯한\n\n무늬다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "151",
  "id": "150",
  "jh": "78a813e75b3b",
  "eh": "c8674d30e71c",
  "ko": "제목도 없는, 조금 싸구려 같은\n\n수제 책.\n\n덩굴풀 무늬의 간단한 장식.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "154",
  "id": "153",
  "jh": "7b9cc030eb67",
  "eh": "13a49ff3cb70",
  "ko": "「인체 해부 신서」\n\n인체의 신비가 밝혀져 있다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "157",
  "id": "156",
  "jh": "69cfd5bd3959",
  "eh": "fde3c1dfdac3",
  "ko": "용사 3종 세트 중 하나.\n\n진정한 용사의 증표라고 한다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "160",
  "id": "159",
  "jh": "9b8ba09b3512",
  "eh": "64106bf66845",
  "ko": "전설의 수수께끼 아이템.\n\n시간의 벽을 넘을 수 있다고\n\n하는데.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "184",
  "id": "183",
  "jh": "21fe3d23a042",
  "eh": "d0bbdc0a5d98",
  "ko": "자신은 전투에 참가하지 않고\n\n동료가 대신 싸워 준다.",
  "status": "draft",
  "note": ""
 },
 {
  "k": "187",
  "id": "186",
  "jh": "3ab40a54f00f",
  "eh": "d8a0015502e5",
  "ko": "플레이 속도를 조절\n{ButtonFast}      : 빨리 감기\n{ButtonSlow}      : 슬로 재생",
  "status": "draft",
  "note": ""
 },
 {
  "k": "190",
  "id": "189",
  "jh": "176a479cc92e",
  "eh": "b0ad51832d19",
  "ko": "설령 땅끝이라도 손님이 있으면\n\n날아간다. 그것이 대장장이\n\n장인의 고집이다.",
  "status": "draft",
  "note": ""
 }
]