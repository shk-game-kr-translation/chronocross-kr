  "note": ""
 },
 {
  "i": 3219,
  "addr": "0x01CB41",
  "jh": "83b7db6319a4",
  "eh": "61ff06439a2a",
  "ko": "  • 나이프로 벤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3220,
  "addr": "0x01CB53",
  "jh": "258004cd2e8e",
  "eh": "df991013bfe6",
  "ko": "  • 상황을 살핀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3221,
  "addr": "0x01CB61",
  "jh": "94421dba6cec",
  "eh": "93ec4b1c1175",
  "ko": "  • 물러난다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3222,
  "addr": "0x01CB6F",
  "jh": "8367eecee60d",
  "eh": "efa6b13f3027",
  "ko": "  녀석의 옆으로 달려 들어가는 동시에 나이프를 겨누었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3223,
  "addr": "0x01CB90",
  "jh": "1fe2f77f3210",
  "eh": "e60624848eb3",
  "ko": "  나이프가 데몬의 얇은 가죽을 찢었다.\n",
