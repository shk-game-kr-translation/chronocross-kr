 },
 {
  "i": 3130,
  "addr": "0x01C129",
  "jh": "eb1e3ee56506",
  "eh": "55b46a6cbe5b",
  "ko": "  “이, 이걸... 밟고 가자고?”\n  키드가 농담하지 마! 하고 격렬하게 고개를 젓고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3131,
  "addr": "0x01C15E",
  "jh": "c291ee726f6f",
  "eh": "3ebd39164224",
