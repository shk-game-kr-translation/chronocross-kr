 },
 {
  "i": 3693,
  "addr": "0x020B47",
  "jh": "87a484bb02f5",
  "eh": "fd14f37a9b47",
  "ko": "  나는 말없이 고개를 끄덕이고, 그녀가 잠든 방을 뒤로했다.\n",
  "status": "draft",
  "note": ""
 },
 {
