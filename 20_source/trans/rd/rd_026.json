[
 {
  "i": 6500,
  "addr": "0x03B143",
  "jh": "37a31d46c33f",
  "eh": "7d50a85ed6a3",
  "ko": "  “안 돼! 못 피하겠어!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6501,
  "addr": "0x03B155",
  "jh": "d7394f892c69",
  "eh": "85092fc2e832",
  "ko": "  점점 지쳐 가고, 다리가 휘청거리기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6502,
  "addr": "0x03B174",
  "jh": "6fa725e1a0f8",
  "eh": "f524db9d7b7d",
  "ko": "  외눈박이가 따라잡더니 내가 서 있는 자리를 향해 거대한 주먹을 휘둘렀다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6503,
  "addr": "0x03B1A2",
  "jh": "9575b29d3730",
  "eh": "92726e5cb6bc",
  "ko": "  “어때, 키드? 넌 상대가 안 돼.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6504,
  "addr": "0x03B1C0",
  "jh": "5e75acf59ac7",
  "eh": "f8e66c91af00",
  "ko": " 그러니까 쉽게 끝내자. 항복하지 그래?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6505,
  "addr": "0x03B1D3",
  "jh": "c22a4415d509",
  "eh": "7afc40ee17c9",
  "ko": "  그럼 나도 필요 이상으로 너를 다치게 하지 않아도 되잖아.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6506,
  "addr": "0x03B1FB",
  "jh": "ec67eecc6e45",
  "eh": "22e66311964a",
  "ko": "  “그르르르아아아아그르르르르!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6507,
  "addr": "0x03B217",
  "jh": "55e89d11d2f6",
  "eh": "64bdb9874f9f",
  "ko": "  내 말은 쇠귀에 경 읽기였고, 키드 괴물은 건물도 무너뜨릴 만한 포효를 터뜨렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6508,
  "addr": "0x03B249",
  "jh": "827a063fa0d9",
  "eh": "b43e5f087a4c",
  "ko": "  “키드! 괜찮아!? 키드!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6509,
  "addr": "0x03B257",
  "jh": "1f3d0bf1a2b6",
  "eh": "4949059fe58d",
  "ko": "  어떻게든 말이 통하게 하려 했지만, ‘걸어 다니는 병기’ 인격이 완전히 자리 잡은 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6510,
  "addr": "0x03B28E",
  "jh": "21a78d808ddd",
  "eh": "3d10fe06faf9",
  "ko": "  “거기 있어? 내 말 들려!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6511,
  "addr": "0x03B2A2",
  "jh": "6d1bd1a5f1ba",
  "eh": "03ff16286c71",
  "ko": "  나는 거대해진 키드를 향해 있는 힘껏 소리쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6512,
  "addr": "0x03B2C0",
  "jh": "08113ca41c60",
  "eh": "176475d63ba2",
  "ko": "  잠시, 키드(괴물?)가 멈춰 섰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6513,
  "addr": "0x03B2DD",
  "jh": "ec3da2c1dc41",
  "eh": "48300feeefbb",
  "ko": "  잠깐 몸이 굳는 듯하더니, 이내 귀청이 터질 듯한 포효를 내질렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6514,
  "addr": "0x03B301",
  "jh": "047cf8ae9a57",
  "eh": "7a328d411671",
  "ko": "  “크르르그르르우우르르그으으!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6515,
  "addr": "0x03B319",
  "jh": "12ffc7a27806",
  "eh": "10c93992acd8",
  "ko": "  그리고 정신을 차려 보니 괴물의 거대한 주먹이 나를 향해 허공을 가르고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6516,
  "addr": "0x03B339",
  "jh": "893a314c44ca",
  "eh": "25b51be4dea4",
  "ko": "  {콰콰콰콰쾅!!!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6517,
  "addr": "0x03B34F",
  "jh": "03e8538697f5",
  "eh": "1cf85cb6bc59",
  "ko": "  간신히 제때 피할 수 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6518,
  "addr": "0x03B369",
  "jh": "4947f83c02b6",
  "eh": "748d27b4c7c5",
  "ko": "  “키이이드!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6519,
  "addr": "0x03B373",
  "jh": "41989cfc3f1a",
  "eh": "6a8201b649b0",
  "ko": "  키드에게 닿으려 했지만, 외눈박이의 눈은 무심한 위협으로 번뜩이며 다시 나를 노렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6520,
  "addr": "0x03B3A9",
  "jh": "847687c5be7c",
  "eh": "d1024d5e5032",
  "ko": "  “키드, 그만해! 이러면 안 돼!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6521,
  "addr": "0x03B3BC",
  "jh": "616f86e67f1b",
  "eh": "c469cbeec3d8",
  "ko": "  나는 말로 해 보기로 했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6522,
  "addr": "0x03B3CE",
  "jh": "4be857e6a606",
  "eh": "cc1d2ccb32a7",
  "ko": "  “키드, 내 말 알아듣지? 들리지?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6523,
  "addr": "0x03B3EB",
  "jh": "a653b7d31c04",
  "eh": "cf467d5cb518",
  "ko": "  거대한 외눈박이 근육 거인이든 아니든, 키드는 그 안 어딘가에 있었다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6524,
  "addr": "0x03B406",
  "jh": "89c757a2c601",
  "eh": "c8bd2fb6061d",
  "ko": " 나는 정말로 키드와 싸우고 싶지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6525,
  "addr": "0x03B419",
  "jh": "aab4202c37ae",
  "eh": "7dfae16bf06b",
  "ko": "  하지만 그 눈은 깜빡이지도 않고, 감정도 없는 듯 나를 노려볼 뿐이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6526,
  "addr": "0x03B43A",
  "jh": "a2f068e95a13",
  "eh": "9819c6db665a",
  "ko": "  “그라아아오오우!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6527,
  "addr": "0x03B454",
  "jh": "2615a24ecc22",
  "eh": "5820c0bb7f8d",
  "ko": "  괴물이 짐승 같은 포효를 내질렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6528,
  "addr": "0x03B467",
  "jh": "e2e220cbf8d8",
  "eh": "9ffb9a3dd4b9",
  "ko": "  그 불길한 외눈에서는 연민이나 자비라곤 한 조각도 보이지 않았다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6529,
  "addr": "0x03B47F",
  "jh": "59f676c6ac6c",
  "eh": "642502a9c370",
  "ko": "  “키드...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6530,
  "addr": "0x03B495",
  "jh": "50688542f05d",
  "eh": "5c92438ac01c",
  "ko": "  “다시는 말 안 해, 키드. 넌 절대 이길 수 없어!",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6531,
  "addr": "0x03B4B8",
  "jh": "bbfc181562c5",
  "eh": "ce4d87ebbd77",
  "ko": " 그러니까 나랑 싸워 봐야 의미가 없다고! 이미 다치게 한 것보다 더 다치게 하고 싶지 않아!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6532,
  "addr": "0x03B4E4",
  "jh": "9762512c654e",
  "eh": "b3c684e7376c",
  "ko": "  하지만 그 거대하고 불안한 눈은 계속 나를 노려볼 뿐이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6533,
  "addr": "0x03B504",
  "jh": "71bfff03f140",
  "eh": "dc8e1b24a3ca",
  "ko": "  “키드! 제발! 우리가 왜 싸워야 하는데!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6534,
  "addr": "0x03B51F",
  "jh": "1c55127c8dc2",
  "eh": "2dba0518af21",
  "ko": "  하지만 키드는 공격을 멈출 생각이 전혀 없는 게 분명했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6535,
  "addr": "0x03B534",
  "jh": "eb8a68cbd379",
  "eh": "e35a08fb079c",
  "ko": "  또다시 거대한 주먹이 내리꽂혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6536,
  "addr": "0x03B547",
  "jh": "b43317f11182",
  "eh": "7bf252f8b040",
  "ko": "  {콰지지직!!!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6537,
  "addr": "0x03B55F",
  "jh": "a984212cc3a4",
  "eh": "dc00b5b78f12",
  "ko": "  나는 옆으로 굴러 또 한 번 간신히 위기를 벗어났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6538,
  "addr": "0x03B57A",
  "jh": "f3c3d6f93319",
  "eh": "c70c8120fe2f",
  "ko": "  하지만 맹공은 무자비했고, 거대한 주먹은 계속 날아들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6539,
  "addr": "0x03B59F",
  "jh": "7e5a50bf5ada",
  "eh": "f2f1916002cb",
  "ko": "  “키드! 넌 날 절대 못 이—!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6540,
  "addr": "0x03B5B2",
  "jh": "cb3f0f719345",
  "eh": "1f4a51843828",
  "ko": "  {쿠웅!!!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6541,
  "addr": "0x03B5BE",
  "jh": "e1af279c2028",
  "eh": "ed8cebf72701",
  "ko": "  바위만 한 손이 날아왔지만 나는 가볍게 옆으로 피했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6542,
  "addr": "0x03B5E1",
  "jh": "393f87b868b4",
  "eh": "b50fa5805fb8",
  "ko": "  “키드! 그만하라고, 제발!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6543,
  "addr": "0x03B5F4",
  "jh": "81aeec7a5109",
  "eh": "4a2796e9ed0c",
  "ko": "  “그만하라고 했잖—!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6544,
  "addr": "0x03B604",
  "jh": "3ce4fb2032bc",
  "eh": "874075fbd695",
  "ko": "  {쿠웅!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6545,
  "addr": "0x03B610",
  "jh": "1d4c8a8775ba",
  "eh": "43518efcdeb6",
  "ko": "  또 하나의 거대한 주먹.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6546,
  "addr": "0x03B621",
  "jh": "e94ced24e556",
  "eh": "067533d5fbc1",
  "ko": "  {콰앙!!!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6547,
  "addr": "0x03B634",
  "jh": "948dd7076b71",
  "eh": "3b72862ea35f",
  "ko": "  방패로 간신히 막았지만, 그 충격에 나는 뒤로 날아갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6548,
  "addr": "0x03B671",
  "jh": "f631721efe3e",
  "eh": "ec0bf85f85b7",
  "ko": "  “키드, 제발!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6549,
  "addr": "0x03B683",
  "jh": "96a7e334342f",
  "eh": "c53c4b55f1b6",
  "ko": "  내 필사적인 호소가 키드에게 닿고 있는지 알 수 없었다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6550,
  "addr": "0x03B69D",
  "jh": "ce44a3c4c56b",
  "eh": "53f31bf80b59",
  "ko": "  저 안에 정말 키드가 있기는 한 걸까?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6551,
  "addr": "0x03B6B7",
  "jh": "945945cb4708",
  "eh": "9f0247102d24",
  "ko": "  거인은 다친 몸을 움직이기 힘들어 보였지만, 여전히 공격을 계속할 작정인 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6552,
  "addr": "0x03B6E3",
  "jh": "db1f2a6c5e4e",
  "eh": "0323bd0aa47e",
  "ko": "  내가 무슨 말을 해도 통하지 않았다. 놈은 무슨 일이 있어도 공격을 계속할 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6553,
  "addr": "0x03B713",
  "jh": "a14f268684c9",
  "eh": "03560321046d",
  "ko": "  {콰지끈!!!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6554,
  "addr": "0x03B724",
  "jh": "408f21bdc7a9",
  "eh": "313b6903456b",
  "ko": "  일격이 방패 윗부분에 처박히며 방패가 찌그러졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6555,
  "addr": "0x03B752",
  "jh": "628686880861",
  "eh": "0c5cfc6d2e35",
  "ko": "  내 몸은 부케처럼 우아한 포물선을 그리며 날아가더니, 벽돌 더미처럼 땅에 처박혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6556,
  "addr": "0x03B782",
  "jh": "676ff40f2749",
  "eh": "dad827dad811",
  "ko": "  “안 돼... 키드... 이러면 안 돼...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6557,
  "addr": "0x03B793",
  "jh": "62cd5523fd2e",
  "eh": "f25574b05665",
  "ko": "  나는 검과 방패를 내던졌다. 그것들이 내 옆 땅바닥에 덜그럭 떨어졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6558,
  "addr": "0x03B7AB",
  "jh": "89437b703e6b",
  "eh": "f6aa41bace23",
  "ko": "  “그만하라고 했잖아! 제발!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6559,
  "addr": "0x03B7BC",
  "jh": "7fcca320f82b",
  "eh": "8bc0ef3fe75f",
  "ko": "  더는 싸울 생각이 없다는 걸 보여 주려고 두 팔을 활짝 벌리고 필사적으로 외쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6560,
  "addr": "0x03B7E0",
  "jh": "0f345ab79f0b",
  "eh": "f784a4696864",
  "ko": "  나는 그 외눈을 애원하듯 바라보며 닿기를 간절히 바랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6561,
  "addr": "0x03B800",
  "jh": "0cde0a409874",
  "eh": "8c9be44d45e8",
  "ko": "  방금 맞은 일격이 커서 고통을 견디는 것만으로도 벅찼지만, 나는 이를 악물고 계속 바라보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6562,
  "addr": "0x03B82C",
  "jh": "465d2404f080",
  "eh": "d69a165c421f",
  "ko": "  하지만 소용없었다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6563,
  "addr": "0x03B830",
  "jh": "af977939ecfb",
  "eh": "398c4feb0f56",
  "ko": " 이건 멈추지 않을 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6564,
  "addr": "0x03B840",
  "jh": "15a6843a8275",
  "eh": "fbc0022a7f42",
  "ko": "  놈은 시선을 떼지 않은 채 위에서 또 한 번 거대한 주먹을 내리쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6565,
  "addr": "0x03B861",
  "jh": "148446d9031e",
  "eh": "00a4e020f414",
  "ko": "  “끝이다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6566,
  "addr": "0x03B86C",
  "jh": "855005f303cb",
  "eh": "918181725ccb",
  "ko": "  이번엔 피할 수 없었다. 끝장이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6567,
  "addr": "0x03B87E",
  "jh": "d03ee7c44fc9",
  "eh": "64c4b30c8910",
  "ko": "  나는 눈을 감고 충격에 대비해 몸을 굳혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6568,
  "addr": "0x03B8A6",
  "jh": "481ae2b8deab",
  "eh": "90d6571992d0",
  "ko": "  {콰아아앙!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6569,
  "addr": "0x03B8B7",
  "jh": "81d2706c90c7",
  "eh": "3ec947c2148e",
  "ko": "  “어... 나... 어라!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6570,
  "addr": "0x03B8C9",
  "jh": "8d8a8600ed86",
  "eh": "53762dd435bb",
  "ko": "  어째서인지 일격이 닿지 않았다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6571,
  "addr": "0x03B8DB",
  "jh": "9227ecc3586e",
  "eh": "76004caa235e",
  "ko": "  올려다보니 주먹이 내 바로 앞에서 멈춰 있었다. 아니... 그건... 멈춰진 거였다... 내가 아닌 무언가에 의해...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6572,
  "addr": "0x03B8FA",
  "jh": "7b9fc38e3c24",
  "eh": "0d3901484056",
  "ko": "  “길!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6573,
  "addr": "0x03B903",
  "jh": "008963459c1b",
  "eh": "83a8b05b6051",
  "ko": "  길이 마지막 순간에 끼어들어 나 대신 일격을 막아 준 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6574,
  "addr": "0x03B92A",
  "jh": "be9764405c9e",
  "eh": "98fad34fb2d3",
  "ko": "  “여긴 어떻게 왔어!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6575,
  "addr": "0x03B939",
  "jh": "77007bd1afea",
  "eh": "0671dd9ea9ba",
  "ko": "  “그건 나중에 말하지. ",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6576,
  "addr": "0x03B949",
  "jh": "ea8950c853d8",
  "eh": "3439fbef4ce8",
  "ko": "쉴 수 있을 때 좀 쉬어 둬라.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6577,
  "addr": "0x03B957",
  "jh": "a54caba0de4e",
  "eh": "4367f5b993cb",
  "ko": "  “하지만... 저기 저 괴물... 저게 키드야!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6578,
  "addr": "0x03B966",
  "jh": "1b63c0c849ac",
  "eh": "9d8002e46c2f",
  "ko": "  “안다. 키드는 내게 맡겨라.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6579,
  "addr": "0x03B97D",
  "jh": "7447d0a30d7e",
  "eh": "0cfc3a12cd36",
  "ko": "  그럴 수밖에 없었다. 바로 그 순간 몸에서 힘이 남김없이 빠져나가, 나는 속절없이 바닥에 주저앉았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6580,
  "addr": "0x03B9C2",
  "jh": "8d66c39e0772",
  "eh": "6f76315d7124",
  "ko": "  • 맞서 싸웠다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6581,
  "addr": "0x03B9CE",
  "jh": "9d07c8fd9e1a",
  "eh": "1af07a2833a3",
  "ko": "  • 돌아서서 도망쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6582,
  "addr": "0x03B9DA",
  "jh": "c065d93283b1",
  "eh": "3bba2931316e",
  "ko": "  • 키드에게 말을 걸어 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6583,
  "addr": "0x03B9E3",
  "jh": "caa7688f6574",
  "eh": "786ee43c0be2",
  "ko": "  나는 방패를 바닥에 내던지고 검을 두 손으로 잡았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6584,
  "addr": "0x03B9FA",
  "jh": "61c2ee106917",
  "eh": "ba6161b5a3e4",
  "ko": "  무슨 수를 써서라도 이 괴물을 멈춰야 했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6585,
  "addr": "0x03BA13",
  "jh": "51fa79a5b659",
  "eh": "55b4b7b4359b",
  "ko": "  놈의 눈을 노리고, 검을 높이 치켜든 채 뛰어올랐다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6586,
  "addr": "0x03BA47",
  "jh": "1687517be472",
  "eh": "71b865e8de8f",
  "ko": "  나는 멍하니 길을 바라보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6587,
  "addr": "0x03BA59",
  "jh": "21dcb7915066",
  "eh": "c477cfbad5ea",
  "ko": "  • “여긴 웬일이야?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6588,
  "addr": "0x03BA6F",
  "jh": "c6f3e1efffd0",
  "eh": "eb58033142a3",
  "ko": "  • “방해하지 마!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6589,
  "addr": "0x03BA83",
  "jh": "543e4cebb14f",
  "eh": "4f22e0f1edb7",
  "ko": "  • “고마워, 길.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6590,
  "addr": "0x03BA97",
  "jh": "6cd1e7c0a8a0",
  "eh": "2f1fc835d79c",
  "ko": "  • “살았다...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6591,
  "addr": "0x03BAAC",
  "jh": "b433ec25e05f",
  "eh": "8d20d6c044de",
  "ko": "  • “키드는...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6592,
  "addr": "0x03BABE",
  "jh": "9d821c6a6f60",
  "eh": "6db532157845",
  "ko": "  • “키드가 이런 꼴인데 어떻게 해야 하지...?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6593,
  "addr": "0x03BAD2",
  "jh": "6f8b2bd7c509",
  "eh": "821c9dd8b5e4",
  "ko": "  • “.........”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6594,
  "addr": "0x03BADD",
  "jh": "c8fea09873c1",
  "eh": "443d0df773c6",
  "ko": "  “길... 여긴 웬일이야?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6595,
  "addr": "0x03BAEE",
  "jh": "54efd0fcb418",
  "eh": "c4388a10c059",
  "ko": "  지금 상황에 가장 적절한 질문은 아니었을지 모르지만, 길이 갑자기 나타나는 바람에 정신이 없었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6596,
  "addr": "0x03BB14",
  "jh": "0b71f5164528",
  "eh": "c45e5f54d6fc",
  "ko": "  “무슨 소리냐? 너와 키드를 도우러 왔지.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6597,
  "addr": "0x03BB2C",
  "jh": "0262b26ca1d4",
  "eh": "ea197a8bd372",
  "ko": "  바보 같을지 몰라도... 뻔한 대답인데도 길의 입으로 들으니 정말 든든했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6598,
  "addr": "0x03BB46",
  "jh": "d5446ef02925",
  "eh": "b8c13dcd7f19",
  "ko": "  “하지만 지금 가장 걱정해야 할 건 키드다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6599,
  "addr": "0x03BB63",
  "jh": "1e301219c657",
  "eh": "509f2c85cb43",
  "ko": "  길은 생각에 잠겨 눈을 가늘게 뜨고 외눈박이 거인을 돌아보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6600,
  "addr": "0x03BB7C",
  "jh": "c59988c33925",
  "eh": "67307d301d1a",
  "ko": "  “내 앞에서 비켜!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6601,
  "addr": "0x03BB8E",
  "jh": "d350a03ad368",
  "eh": "f382accd7960",
  "ko": "  나는 외눈박이를 쓰러뜨리겠다는 집착에 완전히 사로잡혀 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6602,
  "addr": "0x03BBAF",
  "jh": "b6dc104ca561",
  "eh": "1ceafae66516",
  "ko": "  “정신 차려라!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6603,
  "addr": "0x03BBBB",
  "jh": "e69325423d62",
  "eh": "ad89409210ec",
  "ko": "  {짝!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6604,
  "addr": "0x03BBC8",
  "jh": "17a2dacf14e3",
  "eh": "7eef94b3ab9a",
  "ko": "  뺨이 화끈거렸다. 길이 내 뺨을 때린 것이다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6605,
  "addr": "0x03BBE4",
  "jh": "281377065f3a",
  "eh": "fd38c38de599",
  "ko": "  “[NAME], 잊지 마라. 저 외눈박이는 키드다! 필요 이상으로 다치게 해선 안 된다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6606,
  "addr": "0x03BC0F",
  "jh": "71d7317c2294",
  "eh": "1835091f685a",
  "ko": "  나는 괴물 쪽을 바라보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6607,
  "addr": "0x03BC22",
  "jh": "cb3eb8e25a1e",
  "eh": "25c870f721bb",
  "ko": "  잠시 마음을 가라앉히고 보니, 놈은 끔찍한 상태였다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6608,
  "addr": "0x03BC3E",
  "jh": "7a109f2ab60e",
  "eh": "50be3269a3c7",
  "ko": " 그리고 그건 전부 내가 한 짓이었다. 내가 그렇게 잔인했다니 믿을 수 없었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6609,
  "addr": "0x03BC50",
  "jh": "72c6f05068a3",
  "eh": "6634c8350dd3",
  "ko": "  등골이 오싹해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6610,
  "addr": "0x03BC5D",
  "jh": "dcb13cf58dc8",
  "eh": "84f051a58099",
  "ko": "  “...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6611,
  "addr": "0x03BC6A",
  "jh": "a5e9b4911094",
  "eh": "06df105667c0",
  "ko": "  “고마워, 길.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6612,
  "addr": "0x03BC76",
  "jh": "2f182753811e",
  "eh": "52e09fcd3bbb",
  "ko": "  길이 싸울 태세를 갖추었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6613,
  "addr": "0x03BC86",
  "jh": "ce675b85321a",
  "eh": "9ec418312385",
  "ko": "  길이 괴물을 노려보는 동안 사방이 조용했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6614,
  "addr": "0x03BC99",
  "jh": "a218781f6744",
  "eh": "d42e1ba0857a",
  "ko": "  갑자기 외눈박이의 눈에서 생기가 싹 사라졌다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6615,
  "addr": "0x03BCB4",
  "jh": "db45304382db",
  "eh": "83e93f37f3cd",
  "ko": "  {쿠우웅!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6616,
  "addr": "0x03BCCF",
  "jh": "835e02faf9ca",
  "eh": "0d867f85a1f6",
  "ko": "  거대한 몸이 쓰러지며 땅이 흔들렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6617,
  "addr": "0x03BCEA",
  "jh": "99d4390823df",
  "eh": "f972fe7e9f34",
  "ko": "  “어라?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6618,
  "addr": "0x03BCF9",
  "jh": "213b6b4ec56d",
  "eh": "f97d39290bc3",
  "ko": "  “살았다...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6619,
  "addr": "0x03BD05",
  "jh": "5151dee078c1",
  "eh": "5747c9cd070b",
  "ko": "  길이 왔으니 이제 괜찮을 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6620,
  "addr": "0x03BD19",
  "jh": "a33c7ca0f7bb",
  "eh": "271efbce1ce3",
  "ko": "  나는 가슴을 쓸어내리며 안도의 한숨을 쉬었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6621,
  "addr": "0x03BD2E",
  "jh": "0043b3c897b6",
  "eh": "933d5008c31d",
  "ko": "  “키드는 이대로...",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6622,
  "addr": "0x03BD37",
  "jh": "dfcd3ff9a036",
  "eh": "4a175dce9812",
  "ko": " 원래대로 돌려놓을 수 있어?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6623,
  "addr": "0x03BD58",
  "jh": "b6c1014ace1b",
  "eh": "7e19bfd3ee68",
  "ko": "  “두고 봐야지.” 확답을 피하는 대답이 돌아왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6624,
  "addr": "0x03BD60",
  "jh": "26e28e7ade97",
  "eh": "c5391ec00767",
  "ko": "  길의 시선이 다시 외눈박이에게로 향했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6625,
  "addr": "0x03BD87",
  "jh": "5782e2f27cf2",
  "eh": "0c46c4f5e7d3",
  "ko": "  “마, 만약 키드가 이 모습으로 {죽으면}...",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6626,
  "addr": "0x03BD96",
  "jh": "dd2762091d3e",
  "eh": "4d7175321cf3",
  "ko": " 아니, 그러니까 저 외눈박이인지 뭔지가 이대로 죽으면—”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6627,
  "addr": "0x03BDB0",
  "jh": "0af6fbadb374",
  "eh": "060a260bb18b",
  "ko": "  {찰싹!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6628,
  "addr": "0x03BDBD",
  "jh": "a3ffbcc00386",
  "eh": "169a0110e2ec",
  "ko": "  길이 내 뺨을 때렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6629,
  "addr": "0x03BDCF",
  "jh": "630efd40d256",
  "eh": "83eed8a0c90f",
  "ko": "  “정신 차려라.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6630,
  "addr": "0x03BDDB",
  "jh": "74d28723e5ae",
  "eh": "00a423c1d525",
  "ko": "  감정 없는 그 목소리에 나는 정신이 번쩍 들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6631,
  "addr": "0x03BDF1",
  "jh": "89d691b2e614",
  "eh": "7e761c25d2c1",
  "ko": "  “저 안에 있는 건 여전히 키드다. 평소보다 더... 골치 아픈 버전이긴 하지만, 그래도 키드다...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6632,
  "addr": "0x03BE15",
  "jh": "d9b030562d59",
  "eh": "84f051a58099",
  "ko": "  “...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6633,
  "addr": "0x03BE1E",
  "jh": "b29a224f9262",
  "eh": "60973b47c07c",
  "ko": "  뭐라고 해야 할지 몰랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6634,
  "addr": "0x03BE30",
  "jh": "638baabb4846",
  "eh": "78ee6c0daf2d",
  "ko": "  {와 줘서 다행이야...} {이 외눈박이는 대체 뭐야?} {여긴 어디지?} {키드를 되돌릴 수 있을까?} {진짜 세계로는 어떻게 돌아가지?}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6635,
  "addr": "0x03BE6D",
  "jh": "86969c838c5f",
  "eh": "794b5c2edddf",
  "ko": "  온갖 생각이 머릿속을 내달렸지만, 하나도 입 밖으로 나오지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6636,
  "addr": "0x03BE87",
  "jh": "4cb1c20f7018",
  "eh": "ec4bf605efdc",
  "ko": "  그때 어디선가 간주의 목소리가 흘러왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6637,
  "addr": "0x03BEAE",
  "jh": "39c11b0c95cf",
  "eh": "a6b26764d3e8",
  "ko": "  “누군가 또 이곳에 합류한 모양이군.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6638,
  "addr": "0x03BED4",
  "jh": "5ea380019118",
  "eh": "f8b662efee4f",
  "ko": " 좋소, 좋소. 슬슬 끝낼 때가 되지 않았나 생각하던 참이었소.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6639,
  "addr": "0x03BF0A",
  "jh": "f83ab5b070cb",
  "eh": "1eeafb04b1fd",
  "ko": "  그리고 그가 다시 우리 앞에 나타났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6640,
  "addr": "0x03BF21",
  "jh": "a70cb30cebd4",
  "eh": "69b98d3f53b2",
  "ko": "  “자, 콜로세움을 사랑하는 관객 여러분! 오늘 이 용감한 전사들이 보여 준 놀라운 광경에 찬사를 보내 주시오!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6641,
  "addr": "0x03BF63",
  "jh": "8df25df564d9",
  "eh": "f91d09b761fd",
  "ko": "  “와아아아아아아아!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6642,
  "addr": "0x03BF76",
  "jh": "d470913413d7",
  "eh": "370996f15040",
  "ko": "  관객석에서 엄청난 함성이 터져 나왔지만, 여전히 그곳이 텅 비어 있다는 이상한 느낌이 들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6643,
  "addr": "0x03BF9E",
  "jh": "4f2d29097196",
  "eh": "d8da73011262",
  "ko": "  “자, 그럼...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6644,
  "addr": "0x03BFA8",
  "jh": "0cfee2669b6b",
  "eh": "51f9992cf79e",
  "ko": "  그 말과 함께 거대한 외눈박이의 몸이 눈부신 흰빛으로 빛나기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6645,
  "addr": "0x03BFD3",
  "jh": "cceb1ba26482",
  "eh": "9c09edecacdf",
  "ko": "  너무 밝아서 거의 앞이 보이지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6646,
  "addr": "0x03BFEC",
  "jh": "bde2b2621827",
  "eh": "af3f4d0b203f",
  "ko": "  그리고 빛이 잦아들자, 우리 앞에 키드가 누워 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6647,
  "addr": "0x03C00D",
  "jh": "7d7b09d64ae9",
  "eh": "605d436339aa",
  "ko": "  내가 입힌 상처는 사라져 있었다. 그걸 보고 나는 안도의 한숨을 쉬었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6648,
  "addr": "0x03C021",
  "jh": "b5163de549d9",
  "eh": "521807c0babf",
  "ko": "  내 상처도 거의 나았고, 원래 모습으로 돌아와 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6649,
  "addr": "0x03C058",
  "jh": "1b3df0e8ea91",
  "eh": "998921214ecd",
  "ko": "  “정말 매 순간이 즐거웠소. 진심으로. 검투사 중의 검투사와 걸어 다니는 병기의 대결은 상상했던 만큼이나 짜릿했소!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6650,
  "addr": "0x03C0CE",
  "jh": "ae78db410938",
  "eh": "3185257c2adb",
  "ko": "  “하지만 고백하건대, [NAME] 군은 내가 찾던 굳센 강함을 지니지 못한 것 같소.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6651,
  "addr": "0x03C0F8",
  "jh": "a1bab39ac64b",
  "eh": "633058cb9ff7",
  "ko": "  어쩌면 내가 준 힘이 감당하기엔 너무 컸는지도 모르겠소.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6652,
  "addr": "0x03C112",
  "jh": "62a6ce4ce4db",
  "eh": "0cc8ecf6de62",
  "ko": "  간주가 길 쪽을 바라보았다.\n  “그렇긴 하나... 그대들은 정말 흥미로운 악당 일행이군.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6653,
  "addr": "0x03C161",
  "jh": "b3a797348a7c",
  "eh": "3185257c2adb",
  "ko": "  “하지만 고백하건대, [NAME] 군은 내가 찾던 굳센 강함을 지니지 못한 것 같소.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6654,
  "addr": "0x03C18A",
  "jh": "3893c78ec955",
  "eh": "8d0d1774c5aa",
  "ko": "  아니, 어려운 상황을 극복할 의지의 힘이 몹시 부족해 보였소.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6655,
  "addr": "0x03C1BB",
  "jh": "62a6ce4ce4db",
  "eh": "0cc8ecf6de62",
  "ko": "  간주가 길 쪽을 바라보았다.\n  “그렇긴 하나... 그대들은 정말 흥미로운 악당 일행이군.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6656,
  "addr": "0x03C20A",
  "jh": "b3a797348a7c",
  "eh": "3185257c2adb",
  "ko": "  “하지만 고백하건대, [NAME] 군은 내가 찾던 굳센 강함을 지니지 못한 것 같소.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6657,
  "addr": "0x03C233",
  "jh": "6b5aa8961937",
  "eh": "1635eb310651",
  "ko": "  행동에 일관성이 보이지 않았소. 결단이 필요할 때 망설였지.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6658,
  "addr": "0x03C269",
  "jh": "62a6ce4ce4db",
  "eh": "0cc8ecf6de62",
  "ko": "  간주가 길 쪽을 바라보았다.\n  “그렇긴 하나... 그대들은 정말 흥미로운 악당 일행이군.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6659,
  "addr": "0x03C2AD",
  "jh": "5d02535915c9",
  "eh": "af06bd758b6a",
  "ko": "  “그리고 특히 그대, [NAME] 군. 그대야말로 내가 오랫동안 찾아 온 굳센 강함을 지니고 있는지도 모르겠소!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6660,
  "addr": "0x03C2D6",
  "jh": "80c6617ee331",
  "eh": "d6e6c08d1942",
  "ko": "  그대의 여정에 동행하는 영광을 허락해 주겠소?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6661,
  "addr": "0x03C2F8",
  "jh": "21ec5e11d867",
  "eh": "87175129e695",
  "ko": "  • “좋아.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6662,
  "addr": "0x03C302",
  "jh": "beefdc5d5e1e",
  "eh": "5aee92ee0386",
  "ko": "  • “싫어!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6663,
  "addr": "0x03C30A",
  "jh": "f8403c6f7ab5",
  "eh": "2357c2e46d11",
  "ko": "  “자, 그대들을 원래 세계로 돌려보내 주겠소.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6664,
  "addr": "0x03C324",
  "jh": "c4b6f3e79f94",
  "eh": "d14591ec3449",
  "ko": " 셋 모두.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6665,
  "addr": "0x03C334",
  "jh": "846e39e0d030",
  "eh": "c7ade2eb19d5",
  "ko": "  간주의 입에서 그 말이 떨어지자마자 모든 것이 다시 눈부시게 하얘졌다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6666,
  "addr": "0x03C35C",
  "jh": "6066bbbe7484",
  "eh": "90caaa08c27c",
  "ko": "  빛이 잦아들고 주위를 둘러보니, 우리는 야마네코의 방 뒤에 있는 비밀 방으로 돌아와 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6667,
  "addr": "0x03C37C",
  "jh": "0a43fa8ac536",
  "eh": "a96890b1f379",
  "ko": "  “...방금 대체 무슨 일이 있었던 거지?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6668,
  "addr": "0x03C390",
  "jh": "b6c1014ace1b",
  "eh": "eecdfe18a883",
  "ko": "  “누가 알겠나.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6669,
  "addr": "0x03C398",
  "jh": "2b049c1c8998",
  "eh": "0c3d75fca191",
  "ko": "  ‘웃는 돼지’ 주점에서 밤새 퍼마시고 막 깨어난 기분이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6670,
  "addr": "0x03C3BF",
  "jh": "ea1d67afb460",
  "eh": "16571a3a319b",
  "ko": "  “으응...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6671,
  "addr": "0x03C3CC",
  "jh": "46bb72b0d07e",
  "eh": "22661792650c",
  "ko": "  키드가 정신을 차리고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6672,
  "addr": "0x03C3DC",
  "jh": "fb7bac79a1b7",
  "eh": "ed31f49f08d4",
  "ko": "  “어이, 키드! 키드! 괜찮아?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6673,
  "addr": "0x03C3E7",
  "jh": "deff7c03f07d",
  "eh": "623aa90d372d",
  "ko": "  “키드. 기분은 어떠냐?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6674,
  "addr": "0x03C3F1",
  "jh": "bbdab1aba8b3",
  "eh": "8763d1fae7da",
  "ko": "  “뭐... 뭐야... 무슨 일이...?\n  내가 방금 평생 제일 이상한 꿈을 꾼 건가...?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6675,
  "addr": "0x03C421",
  "jh": "87260c9970c4",
  "eh": "85f2c2d2d445",
  "ko": "  키드는 곧 평정을 되찾고 방 안을 둘러보기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6676,
  "addr": "0x03C449",
  "jh": "232fa1425114",
  "eh": "58b46a730d07",
  "ko": "  “으악!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6677,
  "addr": "0x03C455",
  "jh": "2434ee3ba8a2",
  "eh": "05fe1a93129d",
  "ko": "  “키드! 왜 그래!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6678,
  "addr": "0x03C461",
  "jh": "c9e21d33d8dd",
  "eh": "391fbefc2f2f",
  "ko": "  “망할 수정이 없어졌잖아, 그게 문제야!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6679,
  "addr": "0x03C46C",
  "jh": "b44cbab3a483",
  "eh": "65585865bfbc",
  "ko": "  키드 말이 맞았다. 석판에 박혀 있던 수정이 사라져 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6680,
  "addr": "0x03C485",
  "jh": "4341d6d953fd",
  "eh": "514b44fa9e61",
  "ko": "  “그래서? 대체 어디로 간 거야!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6681,
  "addr": "0x03C496",
  "jh": "0ac51121b9d2",
  "eh": "cb67212ea178",
  "ko": "  “나한테 묻지 마!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6682,
  "addr": "0x03C4A3",
  "jh": "476d80cfcc4c",
  "eh": "8a9ea26c9eec",
  "ko": "  “하, 진짜 기가 막히네. 그 고생을 하고 건진 게 하나도 없다니!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6683,
  "addr": "0x03C4C1",
  "jh": "6a2c57e5a02c",
  "eh": "0c247391feaa",
  "ko": "  키드는 낙담한 한숨을 쉬며 일어섰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6684,
  "addr": "0x03C4D3",
  "jh": "eb622b641e14",
  "eh": "d3a0d421f0a6",
  "ko": "  “허탕이었어. 여기서 나가자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6685,
  "addr": "0x03C4E9",
  "jh": "4b252020f506",
  "eh": "e91b3a7f421e",
  "ko": "  우리는 키드를 따라 방을 나왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6686,
  "addr": "0x03C4FC",
  "jh": "73ad0b179dfd",
  "eh": "c7936d693bcb",
  "ko": "  키드가 환상의 투기장에서 있었던 일을 기억하기는 할까...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6687,
  "addr": "0x03C526",
  "jh": "f2ed9d54f2c5",
  "eh": "2556b1bb68e8",
  "ko": "  “걱정 마시오. 그대들에게 짐이 될 만큼 따라다니지는 않을 테니. 사실 그럴 수도 없소.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6688,
  "addr": "0x03C553",
  "jh": "fe12ce1d2461",
  "eh": "8b685608aa5c",
  "ko": " 원래 있던 곳으로 돌아가면 거대한 석판 한가운데의 수정을 빼내어 가지고 다니시오.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6689,
  "addr": "0x03C588",
  "jh": "1370f7a5eb3c",
  "eh": "22f3a434931f",
  "ko": " 거대한 외눈박이의 힘이 필요할 때 소리 내어 바라기만 하면, 그 괴물이 그대들의 명령을 따를 것이오.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6690,
  "addr": "0x03C5E6",
  "jh": "2eb3072dc2d4",
  "eh": "d7ac58a0288c",
  "ko": "  “우와아!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6691,
  "addr": "0x03C5F1",
  "jh": "3d2602cb3b22",
  "eh": "f5bafbcf5021",
  "ko": "  석판의 수정에 눈이 가자 키드가 감탄의 탄성을 내질렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6692,
  "addr": "0x03C614",
  "jh": "adfb0ccf5e2b",
  "eh": "ab8ae78d7c79",
  "ko": "  보석이 전보다 더 밝게 빛나는 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6693,
  "addr": "0x03C632",
  "jh": "52bb084baa40",
  "eh": "96e1f51f3f2e",
  "ko": "  “이것 좀 봐! 이걸 두고 나갈 순 없지. 자존심 있는 도둑이라면 다 그럴걸!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6694,
  "addr": "0x03C649",
  "jh": "1a28fe8acd80",
  "eh": "097a0728d36a",
  "ko": "  키드는 재빨리 석판에서 수정을 비틀어 빼내 주머니에 쏙 넣었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6695,
  "addr": "0x03C66B",
  "jh": "a5b02ee0a765",
  "eh": "cdadccd13ede",
  "ko": "  “좋았어! 이 기세로 계속 가자고! 내 생각대로 이 낡은 저택엔 보물이 잔뜩이야!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6696,
  "addr": "0x03C690",
  "jh": "5d1b84b8c367",
  "eh": "73e55027a9ea",
  "ko": "  다른 사람도 같은 기분인지는 잠깐도 생각하지 않고, 키드는 신이 나서 방을 나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6697,
  "addr": "0x03C6A9",
  "jh": "2cb312ffbf9b",
  "eh": "cc3dee9f0740",
  "ko": "  나와 길의 눈이 마주쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6698,
  "addr": "0x03C6BB",
  "jh": "65350d37256b",
  "eh": "8fd7b255a34e",
  "ko": "  “아무것도 기억 못 하나 봐, 그렇지?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6699,
  "addr": "0x03C6CB",
  "jh": "b6c1014ace1b",
  "eh": "eecdfe18a883",
  "ko": "  “누가 알겠나.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6700,
  "addr": "0x03C6D3",
  "jh": "659b880669de",
  "eh": "25df75129217",
  "ko": "  이제 수수께끼의 환술사 수정의 당당한 주인이 된 우리는 키드를 따라 방을 나왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6701,
  "addr": "0x03C712",
  "jh": "03ee52a97d53",
  "eh": "10733806ded9",
  "ko": "  “으라차!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6702,
  "addr": "0x03C721",
  "jh": "13a8476f52d2",
  "eh": "0b57c27e896c",
  "ko": "  키드는 문 너머 방을 한번 들여다보더니 목청껏 소리치며 뛰어들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6703,
  "addr": "0x03C740",
  "jh": "a2dc07910472",
  "eh": "e2151b659c0b",
  "ko": "  길과 나도 뒤따라 들어갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6704,
  "addr": "0x03C76A",
  "jh": "bcf089a839ff",
  "eh": "406ae1bc8dcc",
  "ko": "  우리 앞에 무척 괴상한 머리 모양을 한 남자가 서 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6705,
  "addr": "0x03C788",
  "jh": "d70df5bd18e6",
  "eh": "699232758994",
  "ko": "  “드디어 찾았다, 야마네코!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6706,
  "addr": "0x03C79C",
  "jh": "d1e69c609c77",
  "eh": "0b078f6ef763",
  "ko": "  우리가 찾던 위대한 보물이 우리 사이에 놓여 희미한 진홍빛을 내뿜고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6707,
  "addr": "0x03C7B9",
  "jh": "0221b56679ab",
  "eh": "bc5cb4c5f4b7",
  "ko": "  “얼어붙은 불꽃이다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6708,
  "addr": "0x03C7C3",
  "jh": "5f17e658d494",
  "eh": "5b2731a2aa97",
  "ko": "  흥분한 나머지 나도 모르게 그 이름을 외칠 뻔했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6709,
  "addr": "0x03C7D8",
  "jh": "f2ba9f9a2949",
  "eh": "d449db2a1def",
  "ko": "  “그렇다, 바로 그 보석이지.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6710,
  "addr": "0x03C7E8",
  "jh": "b94b98ae2957",
  "eh": "290fafddce1d",
  "ko": "  그에 응하듯 진홍빛이 더 강해지는 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6711,
  "addr": "0x03C804",
  "jh": "30c8b955e862",
  "eh": "a0722d0c4e5e",
  "ko": "  “드디어 왔군.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6712,
  "addr": "0x03C818",
  "jh": "55f69cb74de8",
  "eh": "bf9b8f17299e",
  "ko": " 영영 안 나타나는 게 아닌가 걱정하기 시작했다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6713,
  "addr": "0x03C829",
  "jh": "8ef0d110661b",
  "eh": "bd8a850bca7a",
  "ko": "  “오, 그럴 걱정은 전혀 없었지! 그나저나 우리가 훔치러 온 돌이랑 같이 여기서 기다려 줘서 고마워. 일이 훨씬 쉬워졌거든.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6714,
  "addr": "0x03C85C",
  "jh": "e0389ca6bea4",
  "eh": "5d6fc227f371",
  "ko": "  일석이조라고. 생일이 한꺼번에 몰려온 기분이야!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6715,
  "addr": "0x03C89A",
  "jh": "dedd204180e0",
  "eh": "613550487e02",
  "ko": "  “우리는 얼어붙은 불꽃만을 위해 온 걸로 합의했을 텐데.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6716,
  "addr": "0x03C8B0",
  "jh": "e826f97a4fb2",
  "eh": "ed510acaf9d6",
  "ko": "  길이 불만스럽게 중얼거렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6717,
  "addr": "0x03C8BE",
  "jh": "bf368335d9e0",
  "eh": "1a4ad26ba227",
  "ko": "  키드는 아랑곳하지 않고 앞으로 나서서 당당하게 야마네코를 가리켰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6718,
  "addr": "0x03C8DA",
  "jh": "8971000cd913",
  "eh": "a571f4d7a432",
  "ko": "  “기다리게 해서 미안해, 야마네코! 하지만 이제 왔다고!",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6719,
  "addr": "0x03C8FD",
  "jh": "7208d769faa0",
  "eh": "2e8d50023993",
  "ko": " 그러니까 실례지만, 너를 흠씬 두들겨 패고 얼어붙은 불꽃은 기념품으로 챙겨 가겠어.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6720,
  "addr": "0x03C92F",
  "jh": "6c4aa8eb89e0",
  "eh": "effdfff88138",
  "ko": "  키드는 자기 연설이 무척 마음에 든 모양이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6721,
  "addr": "0x03C940",
  "jh": "8c6ac7e7ed53",
  "eh": "7ca05afe4fc0",
  "ko": "  “흥. 자신감은 넘치는군... 하지만 일이 바라는 대로 끝나지는 않을 것 같구나.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6722,
  "addr": "0x03C963",
  "jh": "2b4e838ce60a",
  "eh": "e94c78fffe47",
  "ko": "  야마네코는 불길하게 웃고 있었다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6723,
  "addr": "0x03C9A5",
  "jh": "3b9ee22dbd4a",
  "eh": "478a6f9ac2ba",
  "ko": "  “메카 야마네코, 발진 절차 개시!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6724,
  "addr": "0x03C9B7",
  "jh": "221dbb57bf57",
  "eh": "e9800e165cd3",
  "ko": "  “뭐야—!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6725,
  "addr": "0x03C9C2",
  "jh": "86db8d632af4",
  "eh": "bdad11e1c822",
  "ko": "  야마네코의 명령에 우리 사이의 바닥에 커다란 구멍이 열리기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6726,
  "addr": "0x03C9EC",
  "jh": "a9fb6e9bcb30",
  "eh": "05ba8185a4e0",
  "ko": "  {위이이이이잉!}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6727,
  "addr": "0x03CA0C",
  "jh": "1bc30b750470",
  "eh": "1cc91ac404ee",
  "ko": "  거대한 야마네코처럼 생긴 것이 아래에서 천천히 솟아올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6728,
  "addr": "0x03CA22",
  "jh": "e23a2f3fb711",
  "eh": "af814a4e209b",
  "ko": "  “저게 대체 뭐야!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6729,
  "addr": "0x03CA2C",
  "jh": "a5be989bb890",
  "eh": "2175f22bac59",
  "ko": "  거대한 기계가 움직이기 시작하더니 그 육중한 몸으로 천장을 들이받았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6730,
  "addr": "0x03CA4F",
  "jh": "75e1fb651740",
  "eh": "54f674dceb11",
  "ko": "  지붕 전체가 무너지며 잔해가 우르르 쏟아졌고, 별이 흩뿌려진 밤하늘에 걸린 보름달이 드러났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6731,
  "addr": "0x03CA95",
  "jh": "589e19292ade",
  "eh": "86ded6f517bd",
  "ko": "  “우와!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6732,
  "addr": "0x03CAA0",
  "jh": "5763d7d6f095",
  "eh": "cd04ab7118b3",
  "ko": "  “뭐야!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6733,
  "addr": "0x03CAA9",
  "jh": "0fe3c5aee926",
  "eh": "6288034fea6f",
  "ko": "  “{이런} 거 있다는 얘기는 아무도 안 했잖아!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6734,
  "addr": "0x03CAC0",
  "jh": "c4065d1f9935",
  "eh": "b81aa38d2163",
  "ko": "　로봇의 등장에 우리 모두 보기 좋게 허를 찔렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6735,
  "addr": "0x03CAD1",
  "jh": "17b3551a990c",
  "eh": "013d9021c53d",
  "ko": "  • 돌아서서 도망쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6736,
  "addr": "0x03CADC",
  "jh": "da84873fb02a",
  "eh": "63ea98ba0045",
  "ko": "  • 맞서 싸웠다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6737,
  "addr": "0x03CAE7",
  "jh": "6979f96c521b",
  "eh": "e280c5f2471f",
  "ko": "  • 잠시 생각해 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6738,
  "addr": "0x03CAEF",
  "jh": "6a12d6821184",
  "eh": "a7aa5231ffc0",
  "ko": "  “일단 물러나서 작전을 세워야 해...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6739,
  "addr": "0x03CB09",
  "jh": "3da9e455b91c",
  "eh": "3d30f73af585",
  "ko": "  “좋아! 싸우자는 거라면...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6740,
  "addr": "0x03CB20",
  "jh": "bcb398e417c4",
  "eh": "a6848307b889",
  "ko": "  “윽. 어떡하지!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6741,
  "addr": "0x03CB39",
  "jh": "63681e172831",
  "eh": "eb378e70f1ca",
  "ko": "  “에헴! 실례하오.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6742,
  "addr": "0x03CB47",
  "jh": "ec5e79b63794",
  "eh": "6692743e0094",
  "ko": "  뒤에서 작은 목소리가 들려왔다. 우리는 화들짝 놀라 돌아보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6743,
  "addr": "0x03CB71",
  "jh": "99dd8ab3f86b",
  "eh": "60fb1cf3d01b",
  "ko": "  “뭐, 뭐야—!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6744,
  "addr": "0x03CB80",
  "jh": "5d9d975a42b2",
  "eh": "72eedb96e5a2",
  "ko": "  밝은 빛을 내뿜는 수정 하나가 공중에 떠 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6745,
  "addr": "0x03CB9D",
  "jh": "1f807c0ad185",
  "eh": "cb3cbfe6f7ad",
  "ko": "  “나요. 일이 재미있어질 것 같아서 따라왔소.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6746,
  "addr": "0x03CBCD",
  "jh": "d7345595766c",
  "eh": "f0d250a92c6c",
  "ko": "  “간주로군...” 길이 중얼거렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6747,
  "addr": "0x03CBE4",
  "jh": "a9426bd319e9",
  "eh": "00095f7899ee",
  "ko": "  “{너는} 대체 뭘 원하는 건데?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6748,
  "addr": "0x03CBF3",
  "jh": "9e139ec518a6",
  "eh": "d1bbd0a42cc8",
  "ko": "  “도움이 될까 해서 말이오.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 6749,
  "addr": "0x03CC06",
  "jh": "998e1bef2cb5",
  "eh": "d1993d628380",
  "ko": " 그 방에서 풀어 준 은혜도 있으니.",
  "status": "draft",
  "note": ""
 }
]