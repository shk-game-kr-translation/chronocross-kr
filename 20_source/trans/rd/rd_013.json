[
 {
  "i": 3250,
  "addr": "0x01CEBF",
  "jh": "f40b3643d38b",
  "eh": "694b4dfb45f3",
  "ko": "  사방에서 개굴, 개굴 하는 기분 나쁜 합창이 일어났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3251,
  "addr": "0x01CEE8",
  "jh": "83e78c956f39",
  "eh": "326ceb9f02d7",
  "ko": "  시선을 옮기자 벽 전체가 요란한 원색으로 덧칠되어 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3252,
  "addr": "0x01CF10",
  "jh": "3297ad617833",
  "eh": "8b08db136f79",
  "ko": "  아니, 그게 아니야!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3253,
  "addr": "0x01CF1C",
  "jh": "c94f4bbded83",
  "eh": "8553cbcf6270",
  "ko": "  “개... 개구리이이이!!!!”\n  키드가 펄쩍 뛰어올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3254,
  "addr": "0x01CF45",
  "jh": "af34526de4d9",
  "eh": "bc1394c29ec9",
  "ko": "  빨강과 노랑 얼룩무늬의 두꺼비들이 벽에 빽빽이 들러붙어 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3255,
  "addr": "0x01CF71",
  "jh": "ebd2977be4bf",
  "eh": "1854c78dadb1",
  "ko": "  “꺄아악!! 개, 개구리!!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3256,
  "addr": "0x01CF8F",
  "jh": "727631d10e16",
  "eh": "99dea1811e33",
  "ko": "  키드가 날카로운 목소리로 비명을 지르고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3257,
  "addr": "0x01CFA7",
  "jh": "c2c6663dfa29",
  "eh": "e7aa4d3d23c5",
  "ko": "  두꺼비 한 마리가 폴짝 키드를 향해 뛰어올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3258,
  "addr": "0x01CFC5",
  "jh": "218167730de0",
  "eh": "f1fe374c824f",
  "ko": "  “싫어! 오지 마!!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3259,
  "addr": "0x01CFD5",
  "jh": "ab514a9b07e5",
  "eh": "4e5d8cedb7a3",
  "ko": "  그만해!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3260,
  "addr": "0x01CFDD",
  "jh": "b910b4ee9aa0",
  "eh": "216c32f16510",
  "ko": "  히이익!!”\n  키드는 반쯤 실성한 상태였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3261,
  "addr": "0x01CFF7",
  "jh": "7b9a478505d1",
  "eh": "6ad9a61c4223",
  "ko": "  독살스러운 개구리들이 온몸의 혹에서 주황색 안개를 쉬익 뿜어냈다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3262,
  "addr": "0x01D033",
  "jh": "b65dddf9febe",
  "eh": "bac8c1e9552b",
  "ko": "  자욱하게 깔리는 안개. 구역질이 나기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3263,
  "addr": "0x01D04B",
  "jh": "89c7fb393b4d",
  "eh": "d35f7faeed97",
  "ko": "  어둠을 길의 화염 마법이 찢어발겼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3264,
  "addr": "0x01D06E",
  "jh": "66fd696f95db",
  "eh": "6b3f15c3eed0",
  "ko": "  불길이 판자처럼 펼쳐져 통로를 막았다.\n  데몬의 환각으로부터 우리를 지키듯이.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3265,
  "addr": "0x01D0A1",
  "jh": "08995fbe6d25",
  "eh": "f1f58386746e",
  "ko": "  길 덕분에 두꺼비들은 사라졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3266,
  "addr": "0x01D0B5",
  "jh": "23c5a475310b",
  "eh": "8c6d274a1806",
  "ko": "  키드의 굳어 있던 표정이 원래대로 돌아왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3267,
  "addr": "0x01D0CB",
  "jh": "6aa37331a80f",
  "eh": "6f9207c4fd2e",
  "ko": "  불의 벽 너머로 보니, 녀석은 허공에 손가락을 놀리며 무언가를 쓰고 있었다. 복잡한 도형이 어렴풋이 떠올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3268,
  "addr": "0x01D10B",
  "jh": "e75d8a5bb5f2",
  "eh": "437bfcbaa827",
  "ko": "  “앗 뜨거!”\n  나와 키드가 비명을 지르며 뛰어 물러났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3269,
  "addr": "0x01D126",
  "jh": "9a98ab842dc2",
  "eh": "5a9e5a8c86fb",
  "ko": "  바닥이 질척질척 녹아내리기 시작한 것이다. 펄펄 끓는 냄비 바닥처럼 뜨거웠다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3270,
  "addr": "0x01D156",
  "jh": "e6273ef45902",
  "eh": "867b51552950",
  "ko": "  굵은 땀방울이 솟구쳤다. 땀은 바닥에 뚝 떨어지자마자 치익 하고 증발했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3271,
  "addr": "0x01D18B",
  "jh": "7deaeb527e4c",
  "eh": "7d28aefcb52a",
  "ko": "  “길, 어떻게 좀 해 봐!!”\n  키드가 날카로운 소리를 질렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3272,
  "addr": "0x01D1AB",
  "jh": "287505f1f0f4",
  "eh": "6d5513e7ca4f",
  "ko": "  녀석은 날개를 퍼덕여 강풍을 일으켜 불의 벽을 꺼 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3273,
  "addr": "0x01D1DA",
  "jh": "38c310808284",
  "eh": "83c510c29a63",
  "ko": "  그 바람에 섞여 바늘 같은 얼음이 날아왔다. 길이 응전하여 마법을 날렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3274,
  "addr": "0x01D205",
  "jh": "8d1b61b95fbd",
  "eh": "1c97953a8a99",
  "ko": "  화염이 그물처럼 펼쳐졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3275,
  "addr": "0x01D227",
  "jh": "3be3a9f85a99",
  "eh": "23bcdcf00a4e",
  "ko": "  불길은 바람에 섞인 얼음 바늘을 녹이며 데몬에게 덮쳐들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3276,
  "addr": "0x01D24C",
  "jh": "300d8333c232",
  "eh": "36a2910715eb",
  "ko": "  불의 그물이 데몬의 몸에 휘감겼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3277,
  "addr": "0x01D264",
  "jh": "a8c2ba90c2c5",
  "eh": "4129cd981667",
  "ko": "  살갗이 순식간에 녹아내려, 주위에 악취가 자욱해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3278,
  "addr": "0x01D28F",
  "jh": "7c8a52cc266a",
  "eh": "e3aa23ab5097",
  "ko": "  “휴우, 쪄 죽는 줄 알았네.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3279,
  "addr": "0x01D2AA",
  "jh": "c75098e66bb7",
  "eh": "8c9fb5f99cc0",
  "ko": "  땀으로 끈적해진 몸을 신경 쓰며 키드가 투덜거렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3280,
  "addr": "0x01D2CB",
  "jh": "f9615097624e",
  "eh": "576f6847a70d",
  "ko": "  “화염계는 연달아 쓰지 말라고...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3281,
  "addr": "0x01D2E3",
  "jh": "4023a9ba5921",
  "eh": "70f9007ccb69",
  "ko": "  열기에 체력을 조금 빼앗긴 것 같다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3282,
  "addr": "0x01D311",
  "jh": "6606bd6d8dc2",
  "eh": "c04bda9372a1",
  "ko": "  나보다는 개구리에 혼비백산했던 키드가 더 걱정이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3283,
  "addr": "0x01D336",
  "jh": "6e3f8638fa19",
  "eh": "2002bee5bcc7",
  "ko": "  “괜찮아? 키드?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3284,
  "addr": "0x01D343",
  "jh": "189fb26efcac",
  "eh": "cf6790675109",
  "ko": "  “무슨 소리야?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3285,
  "addr": "0x01D34F",
  "jh": "bb286b9cb3fd",
  "eh": "a898cb9c9d95",
  "ko": "  시치미를 떼고 개구리 일을 얼버무릴 생각이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3286,
  "addr": "0x01D36D",
  "jh": "5b89b6f2e163",
  "eh": "aea871bfd391",
  "ko": "  개구리를 무서워하다니...\n  나는 웃음을 참느라 필사적이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3287,
  "addr": "0x01D396",
  "jh": "fc41e9785b48",
  "eh": "5264aa2ea9fc",
  "ko": "  “여긴 맡겨!”\n  나는 외쳤다. 키드도 외쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3288,
  "addr": "0x01D3B6",
  "jh": "6c35d835c63f",
  "eh": "be601de23ff7",
  "ko": "  나는 왼쪽으로 돌아 데몬의 옆으로 파고들었다. 데몬이 낫을 치켜들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3289,
  "addr": "0x01D3DB",
  "jh": "5cbb2872536e",
  "eh": "5f029a498f77",
  "ko": "  {휙!!} 낫이 코끝을 스쳤다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3290,
  "addr": "0x01D3F7",
  "jh": "511ac9e13d17",
  "eh": "1e4998fbbb75",
  "ko": "  하마터면 코가 잘려 나갈 뻔했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3291,
  "addr": "0x01D411",
  "jh": "fad143fb9e7d",
  "eh": "9470c61713aa",
  "ko": "  그 틈에 키드가 뒤에서 녀석을 베었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3292,
  "addr": "0x01D431",
  "jh": "5f0f92f3775b",
  "eh": "086c6c61fdc5",
  "ko": "  끄악 하는 기분 나쁜 비명을 지르며 데몬이 바닥에 쓰러졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3293,
  "addr": "0x01D455",
  "jh": "0d65dfb5f239",
  "eh": "f07c8dcce27a",
  "ko": "  “너를 미끼로 삼고 내가 마무리하는 작전인가. 우연치고는 잘 맞아떨어졌네.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3294,
  "addr": "0x01D484",
  "jh": "bfae7d28b9a2",
  "eh": "c24c10c65ca0",
  "ko": "  키드가 만족스럽게 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3295,
  "addr": "0x01D494",
  "jh": "ada6ac344e80",
  "eh": "4e7e1ee5322e",
  "ko": "  마물 특유의 푸른 피를 줄줄 흘리며, 녀석은 바닥을 데굴데굴 구르고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3296,
  "addr": "0x01D4C1",
  "jh": "dc1359363aa8",
  "eh": "d82a95b2b667",
  "ko": "  무시무시한 형상으로 이쪽을 노려보며, 손가락으로 바닥을 가리키고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3297,
  "addr": "0x01D4E7",
  "jh": "52987473d5a3",
  "eh": "fa22c74258b3",
  "ko": "  심상치 않은 기척에 자세를 잡는 키드.\n  “해 보자는 거냐, 다 죽어 가는 주제에!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3298,
  "addr": "0x01D50E",
  "jh": "d762151d8989",
  "eh": "3220a947ede8",
  "ko": "  데몬은 자신의 푸른 피로 바닥에 글자를 써 나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3299,
  "addr": "0x01D52C",
  "jh": "12de8f74e3c2",
  "eh": "f2ba1694d3a7",
  "ko": "  피로 쓴 글자가 요사스러운 빛을 띠었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3300,
  "addr": "0x01D543",
  "jh": "32aa4584418f",
  "eh": "7dbf4e2154a3",
  "ko": "  섬광이 내달렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3301,
  "addr": "0x01D55C",
  "jh": "1e6c2c2bf5da",
  "eh": "de32199c4522",
  "ko": "  발밑에서 번개가 튀었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3302,
  "addr": "0x01D572",
  "jh": "97f880504136",
  "eh": "8c5eb0f8284e",
  "ko": "  녀석의 바로 곁에 있던 키드도 움찔 몸을 움츠렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3303,
  "addr": "0x01D58F",
  "jh": "fe0b2a368582",
  "eh": "8b586a48b332",
  "ko": "  녀석이 다시 피로 글자를 쓰려 했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3304,
  "addr": "0x01D5A8",
  "jh": "f444c296a3cb",
  "eh": "5977076b8a2a",
  "ko": "  키드가 그 작은 틈을 놓치지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3305,
  "addr": "0x01D5BB",
  "jh": "63d3d8603240",
  "eh": "106c3f806fbf",
  "ko": "  몸을 비틀며 다리를 뻗었다.\n  녀석의 배에 깔끔한 자세의 발차기가 꽂혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3306,
  "addr": "0x01D5ED",
  "jh": "bca392e4e1f2",
  "eh": "b0131d968fd0",
  "ko": "  녀석이 철퍼덕 피로 쓴 글자 위로 쓰러졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3307,
  "addr": "0x01D608",
  "jh": "07e8259b089f",
  "eh": "c799ed348f15",
  "ko": "  더 이상 데몬은 일어나지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3308,
  "addr": "0x01D626",
  "jh": "bb11d32fd551",
  "eh": "8bae395bee01",
  "ko": "  만약을 위해 안전한 곳까지 조금 물러났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3309,
  "addr": "0x01D63F",
  "jh": "ef77b486bc42",
  "eh": "48abf1442f27",
  "ko": "  나와 반대로, 키드는 데몬에게 몇 걸음 다가갔다.\n  “이런 녀석쯤! 나 혼자서도!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3310,
  "addr": "0x01D66E",
  "jh": "e10fabd34978",
  "eh": "acd01c7d4703",
  "ko": "  키드는 용맹하게 외치더니 데몬의 품으로 뛰어들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3311,
  "addr": "0x01D68B",
  "jh": "ff51ca12a648",
  "eh": "36b1b53df05f",
  "ko": "  “그렇게 긴 낫으로는 싸우기 힘들걸!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3312,
  "addr": "0x01D6A2",
  "jh": "84bdf8d7efa2",
  "eh": "510dd7ef3121",
  "ko": "  데몬은 충분한 거리를 잡지 못해 낫을 주체하지 못했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3313,
  "addr": "0x01D6C8",
  "jh": "a2d50258a50a",
  "eh": "377e46f75c3d",
  "ko": "  키드가 날카롭게 베어 들어간, 그때!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3314,
  "addr": "0x01D6DF",
  "jh": "e728e4e69849",
  "eh": "a026c7487777",
  "ko": "  녀석의 긴 꼬리가 사각에서 키드를 덮쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3315,
  "addr": "0x01D6FC",
  "jh": "3e2e6907e381",
  "eh": "fb80735ad00c",
  "ko": "  꼬리는 길게 뻗어 키드의 왼쪽 발목에 휘감겼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3316,
  "addr": "0x01D71B",
  "jh": "8e25ec613de9",
  "eh": "40240c8aed48",
  "ko": "  비명을 지를 새도 없이, 키드의 몸이 거꾸로 매달려 들어 올려졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3317,
  "addr": "0x01D73D",
  "jh": "4947f83c02b6",
  "eh": "def424d143b4",
  "ko": "  “키드!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3318,
  "addr": "0x01D746",
  "jh": "3e1663514a78",
  "eh": "f9d17c5ac3d0",
  "ko": "  녀석은 낫으로 나를 견제했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3319,
  "addr": "0x01D75D",
  "jh": "86f5f4e44679",
  "eh": "e5067816d5f5",
  "ko": "  키드가 매달린 자세에서 진자처럼 반동을 붙여 데몬의 날개를 베었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3320,
  "addr": "0x01D792",
  "jh": "f4506c52cec3",
  "eh": "c9df7e0ced11",
  "ko": "  “어때, 꼴좋다!”\n  꼬리가 격통에 느슨해진 틈에 키드는 사뿐히 뛰어내렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3321,
  "addr": "0x01D7C3",
  "jh": "8c25ef53d6e1",
  "eh": "3b4664d05641",
  "ko": "  하지만 틈도 주지 않고 이번에는 녀석의 혀가 뻗어 왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3322,
  "addr": "0x01D7E4",
  "jh": "95a0a82058bc",
  "eh": "dffef7198c8e",
  "ko": "  섬뜩한 광택을 띤 혀가 무서운 속도로 키드의 가는 목에 휘감겼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3323,
  "addr": "0x01D814",
  "jh": "67b99ed790d4",
  "eh": "1965235a6dc7",
  "ko": "  “우웩, 징그러~, 콜록, 콜록.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3324,
  "addr": "0x01D836",
  "jh": "d9b1572b5ba1",
  "eh": "033d2667746c",
  "ko": "  캑캑거리면서도 욕을 퍼붓고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3325,
  "addr": "0x01D84C",
  "jh": "5df155c394f8",
  "eh": "17a23f370b16",
  "ko": "  녀석은 나를 향해 주문을 내뱉었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3326,
  "addr": "0x01D864",
  "jh": "57ffe5ab91b8",
  "eh": "53b97a9a6c72",
  "ko": "  갑자기 통로 안쪽이 술렁이기 시작했다. 무언가가 달려오고 있다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3327,
  "addr": "0x01D885",
  "jh": "5e0e76ede02c",
  "eh": "0bbe86691ee1",
  "ko": "  불쾌한 동물 냄새가 코를 찔렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3328,
  "addr": "0x01D8A2",
  "jh": "5aec41a9028a",
  "eh": "380b6aa18a94",
  "ko": "  시궁쥐, 곰쥐, 생쥐, 햄스터, 기니피그, 다람쥐...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3329,
  "addr": "0x01D8D8",
  "jh": "07585df35e55",
  "eh": "707fd0bc19ed",
  "ko": "  “설치류 대군...??”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3330,
  "addr": "0x01D8EC",
  "jh": "c4f4d9e9a6b0",
  "eh": "6178605e2fd0",
  "ko": "  뜻밖의 등장인물에 나는 당황했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3331,
  "addr": "0x01D902",
  "jh": "0ba585bdcdab",
  "eh": "fb843ebde6b2",
  "ko": "  쥐들은 작고 동그란 눈으로 이쪽을 보더니, 씨익 앞니를 드러냈다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3332,
  "addr": "0x01D929",
  "jh": "e29b6dda4b7a",
  "eh": "230fa92fa666",
  "ko": "  두 개의 앞니가 내 신발을 갉아 대기 시작했다.\n  {갉작갉작갉작갉작...}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3333,
  "addr": "0x01D956",
  "jh": "09fd2f0188d7",
  "eh": "7077cfa06d94",
  "ko": "  “우왓, 그만해!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3334,
  "addr": "0x01D965",
  "jh": "78b5491463c1",
  "eh": "28f57c2cf72b",
  "ko": "  다리를 붕붕 휘둘러 쫓아냈다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3335,
  "addr": "0x01D97D",
  "jh": "c1f807c2dd99",
  "eh": "0ca44ecae711",
  "ko": "  휘두르는 다리를 타고, 쥐들이 능숙하게 몸을 기어올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3336,
  "addr": "0x01D9A3",
  "jh": "853107771e22",
  "eh": "3c7b7e4b9ed8",
  "ko": "  어깨에 앉은 다람쥐가 머리카락을 잡아당겨 뭉텅뭉텅 뽑더니 볼에 채워 넣었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3337,
  "addr": "0x01D9D6",
  "jh": "0ef7f4f78462",
  "eh": "2891b2d7cb7d",
  "ko": "  “아야야야얏!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3338,
  "addr": "0x01D9E2",
  "jh": "27dcb58837ec",
  "eh": "8b8858e8c091",
  "ko": "  쥐들은 옷을 갉아 먹고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3339,
  "addr": "0x01D9F7",
  "jh": "b927fd3bc713",
  "eh": "6af3277364fc",
  "ko": "  햄스터가 그 조각을 부지런히 볼주머니에 채워 넣고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3340,
  "addr": "0x01DA24",
  "jh": "c5cb60e5be77",
  "eh": "8bab7b680f55",
  "ko": "  {갉작갉작갉작갉작...}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3341,
  "addr": "0x01DA39",
  "jh": "50985a71d854",
  "eh": "1d6fc3f31f7d",
  "ko": "  이대로라면 언젠가 내 몸도 갉아 먹히고 말 거다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3342,
  "addr": "0x01DA57",
  "jh": "16add08c4f2f",
  "eh": "3fb7e405206e",
  "ko": "  옷이며 머리카락으로 볼이 빵빵해진 쥐들을 잡아떼어 휙휙 던졌지만... 끝이 없었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3343,
  "addr": "0x01DA90",
  "jh": "c70543ae3707",
  "eh": "e87b2dbdd458",
  "ko": "  “젠장! 끈질기네!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3344,
  "addr": "0x01DA9F",
  "jh": "33586e4307bb",
  "eh": "358bde8253ae",
  "ko": "  쥐를 상대로 고전하는 내 귀에 갈라진 목소리가 들어왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3345,
  "addr": "0x01DAC5",
  "jh": "456886c735e2",
  "eh": "ed56c1584a9e",
  "ko": "  “숨, 이, 막, 혀...”\n  녀석의 혀에 졸려 키드가 몸부림치고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3346,
  "addr": "0x01DAF0",
  "jh": "028ce761cce7",
  "eh": "f9f7b544ee34",
  "ko": "  그렇지, 우선 키드를 구해야 해.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3347,
  "addr": "0x01DB05",
  "jh": "070a09fb4ed1",
  "eh": "7a1757f0e1be",
  "ko": "  쥐를 주렁주렁 매단 채로 어떻게든 달려갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3348,
  "addr": "0x01DB27",
  "jh": "1a3bbb994237",
  "eh": "dc248d1e73e9",
  "ko": "  나는 나이프를 손에 들고 데몬에게 덤벼들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3349,
  "addr": "0x01DB3D",
  "jh": "24940fd4a018",
  "eh": "9b042e26d019",
  "ko": "  키드의 목에 휘감긴 혀를 잘라 냈다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3350,
  "addr": "0x01DB58",
  "jh": "df0d8bb1ef25",
  "eh": "ab6980fd354b",
  "ko": "  녀석은 기겁한 얼굴로 나를 본 채, 목에 혀가 걸려 죽었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3351,
  "addr": "0x01DB8B",
  "jh": "745e9ae41959",
  "eh": "c92e8207fe6b",
  "ko": "  쥐의 환각이 사라지고, 찢어진 옷도 갉아 먹힌 신발도 원래대로 돌아와 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3352,
  "addr": "0x01DBB6",
  "jh": "3c578e4d5c42",
  "eh": "2bdbb1527fb9",
  "ko": "  내가 건넨 손수건으로 목 주위를 닦으며 키드가 몸을 떨었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3353,
  "addr": "0x01DBDE",
  "jh": "2f77cd75f63f",
  "eh": "7ce1119587f7",
  "ko": "  “아직도 끈적거려~”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3354,
  "addr": "0x01DBF0",
  "jh": "d02ae22b72c0",
  "eh": "768f1bbac041",
  "ko": "  키드는 꽤 기분이 나빴던 모양이지만, 어쨌든 무사해서 다행이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3355,
  "addr": "0x01DC2A",
  "jh": "cd4a1c1d4328",
  "eh": "4b0bb1253b07",
  "ko": "  문을 열고 키드가 스르륵 안으로 들어갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3356,
  "addr": "0x01DC64",
  "jh": "cd4a1c1d4328",
  "eh": "d64d7c178241",
  "ko": "  문을 열고 키드가 스르륵 안으로 들어갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3357,
  "addr": "0x01DCC4",
  "jh": "5090f0bd8a58",
  "eh": "9c31a89cab18",
  "ko": "  아무래도 야마네코의 방인 것 같은데, 아무도 없는 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3358,
  "addr": "0x01DCE3",
  "jh": "b69bd673145a",
  "eh": "f27b9ef18861",
  "ko": "  “그 녀석, 이 몸이 올 걸 알고 도망쳤구먼!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3359,
  "addr": "0x01DD0C",
  "jh": "64cf3c722c94",
  "eh": "6a65288e94c3",
  "ko": "  “역시 없나...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3360,
  "addr": "0x01DD1C",
  "jh": "f3d0791a9666",
  "eh": "5b5f5d36cb47",
  "ko": "  키드의 목소리가 고요함에 삼켜졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3361,
  "addr": "0x01DD30",
  "jh": "783b851ea7f8",
  "eh": "e1a64999477c",
  "ko": "  그런데... 취향 한번 고약한 방이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3362,
  "addr": "0x01DD46",
  "jh": "1702d0b97638",
  "eh": "809ef53b12aa",
  "ko": "  가구의 만듦새나 색감 같은 것 하나하나는 이상해 보이지 않는데, 방 전체로 바라보면 전혀 조화가 느껴지지 않는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3363,
  "addr": "0x01DD8A",
  "jh": "36ec19bbd9bf",
  "eh": "e09276653210",
  "ko": "  그것은 마치 야마네코의 격렬한 내면을 암시하는 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3364,
  "addr": "0x01DDC3",
  "jh": "3935e18333d3",
  "eh": "b4bd27fcc03d",
  "ko": "  “어쨌든, 안을 조사해 보자고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3365,
  "addr": "0x01DDD7",
  "jh": "0e85b9f7a0e3",
  "eh": "2a45191b5764",
  "ko": "  책상 서랍, 벽에 걸린 그림, 사이드 테이블 위의 물병...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3366,
  "addr": "0x01DE09",
  "jh": "76a7dd17e235",
  "eh": "d151bef60c27",
  "ko": "  우리는 자잘한 것까지 조사해 나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3367,
  "addr": "0x01DE1F",
  "jh": "4ade8d481e2e",
  "eh": "35e9788c2951",
  "ko": "  딱히 수상한 곳은 없는데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3368,
  "addr": "0x01DE33",
  "jh": "c929875fd0c6",
  "eh": "8f8d6cbcf8fe",
  "ko": "  방을 둘러보던 내 눈에 기묘한 것이 비쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3369,
  "addr": "0x01DE52",
  "jh": "54461f8eb536",
  "eh": "577f97bc1724",
  "ko": "  방 한쪽 구석에 놓인 받침대...\n  받침대 위에는 의미심장하게 진홍빛 천이 씌워져 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3370,
  "addr": "0x01DE8D",
  "jh": "821224a3c811",
  "eh": "24f79c144b6a",
  "ko": "  나는 살며시 손을 뻗었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3371,
  "addr": "0x01DE9E",
  "jh": "98b0373f4fe8",
  "eh": "ce99955ef61d",
  "ko": "  “함부로 만지지 않는 게 좋을 거다.”\n  길의 경고에 허둥지둥 손을 거두었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3372,
  "addr": "0x01DECA",
  "jh": "6f0ce04eaf12",
  "eh": "0a34accc57e8",
  "ko": "  그런데 아무것도 하지 않았는데 진홍빛 천이 펄럭 걷혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3373,
  "addr": "0x01DEF2",
  "jh": "e7d23682e31e",
  "eh": "a46c60d6917f",
  "ko": "  “저절로 걷혔어?”\n  키드가 눈을 동그랗게 떴다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3374,
  "addr": "0x01DF0F",
  "jh": "b08bcd592c64",
  "eh": "e6bd037c6bd0",
  "ko": "  호기심에 이끌려, 우리는 새빨간 천 안쪽을 들여다보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3375,
  "addr": "0x01DF38",
  "jh": "e960031fabcb",
  "eh": "516cd6b6f465",
  "ko": "  그것은 커다란 거울이었다.\n  아라베스크로 장식된 골동품 거울.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3376,
  "addr": "0x01DF66",
  "jh": "31d66c42efd2",
  "eh": "19e74c16db95",
  "ko": "  오래된 저택이라면 반드시 있을 법한 흔한 물건이다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3377,
  "addr": "0x01DF85",
  "jh": "6216a365b689",
  "eh": "27b914059cfa",
  "ko": " 하지만...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3378,
  "addr": "0x01DF8D",
  "jh": "a16655a3ae50",
  "eh": "5bf481a97285",
  "ko": "  “좀 이상한 느낌이 드는데...”\n  하고 키드가 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3379,
  "addr": "0x01DFAB",
  "jh": "6660f4d35a90",
  "eh": "4c277311d0d1",
  "ko": "  내 눈은 거울에 비친 비너스상에 빨려 들어갔다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3380,
  "addr": "0x01DFD3",
  "jh": "c532a8018ed2",
  "eh": "b1c195952206",
  "ko": "  그러자 놀랍게도 비너스의 눈동자가 빛나기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3381,
  "addr": "0x01DFF6",
  "jh": "23a75cc0b227",
  "eh": "b08ffa76ac8d",
  "ko": "  “무슨 용건이신지요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3382,
  "addr": "0x01E008",
  "jh": "001c2133afd3",
  "eh": "7862bfde8c18",
  "ko": "  거울 속 비너스는 황홀할 만큼 허스키한 미성을 울렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3383,
  "addr": "0x01E039",
  "jh": "202788aad379",
  "eh": "881b73e158d8",
  "ko": "  “마, 말했다!”\n  나는 저도 모르게 몸을 젖혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3384,
  "addr": "0x01E054",
  "jh": "7501d92871e6",
  "eh": "c643ce410dec",
  "ko": "  “속삭임의 거울이다.”\n  길이 평소의 말투로 그렇게 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3385,
  "addr": "0x01E072",
  "jh": "23ea3618698a",
  "eh": "7476397ffb2a",
  "ko": "  “뭐야, 그게?”\n  하고 의아한 표정의 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3386,
  "addr": "0x01E08D",
  "jh": "f5077333a080",
  "eh": "4fceace21276",
  "ko": "  “정령이 깃든 마법의 거울이다.",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3387,
  "addr": "0x01E0A0",
  "jh": "ff8c9412bfc0",
  "eh": "ec47da64fd6e",
  "ko": " 거울 속을 자유롭게 오가는 정령은, 묻는 자에게 조언을 준다고 하지...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3388,
  "addr": "0x01E0D3",
  "jh": "dfe69a2ad0dd",
  "eh": "0b01fa6409b6",
  "ko": "  뭔가 질문해 보는 게 어떤가?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3389,
  "addr": "0x01E0EA",
  "jh": "22f3d4fa34f1",
  "eh": "9e5c597af1aa",
  "ko": "  나는 큰맘 먹고 예전부터 알고 싶었던 것을 물어보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3390,
  "addr": "0x01E110",
  "jh": "6419360783e6",
  "eh": "c683635305fc",
  "ko": "  • 키드에 대해 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3391,
  "addr": "0x01E121",
  "jh": "60a1bbf90014",
  "eh": "26c228b8dc87",
  "ko": "  • 길에 대해 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3392,
  "addr": "0x01E12F",
  "jh": "7557ac7775dc",
  "eh": "7005b99f81dc",
  "ko": "  “키드의 과거를 알고 싶어.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3393,
  "addr": "0x01E141",
  "jh": "20f0b382a7db",
  "eh": "7ec00addfe9b",
  "ko": "  “무슨 소리를 하는 거야, 너!”\n  키드가 발끈했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3394,
  "addr": "0x01E160",
  "jh": "5f6c484ebe3b",
  "eh": "a5ec2f63490b",
  "ko": "  “알겠습니다.”\n  나에게 달려드는 키드를 무시하고 속삭임의 거울에서 목소리가 들려왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3395,
  "addr": "0x01E190",
  "jh": "8afe13ac5fc5",
  "eh": "dff7588ac48d",
  "ko": "  거울 표면에 잔물결이 일며 비너스상이 잘게 떨렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3396,
  "addr": "0x01E1B7",
  "jh": "db0cbd441a57",
  "eh": "913f55343095",
  "ko": "  거울은 서서히 어두워져 갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3397,
  "addr": "0x01E1CF",
  "jh": "c97d56c21e5c",
  "eh": "49874fe1944b",
  "ko": "  이윽고 칠흑 같은 거울 표면에 변경 레지오나의 풍경이 떠오르고, 그 위로 차례차례 그림자가 나타났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3398,
  "addr": "0x01E210",
  "jh": "0e49ce1d58fe",
  "eh": "1668e8cada81",
  "ko": "  어린아이들에게 둘러싸인 젊은 아가씨...\n  아이들은 초라한 차림이지만, 모두 즐거운 듯 웃고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3399,
  "addr": "0x01E256",
  "jh": "49dbefc23562",
  "eh": "6b91974d5a6f",
  "ko": "  그곳에 갑자기 불길이 치솟고, 무장한 사내들이 우르르 몰려들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3400,
  "addr": "0x01E280",
  "jh": "14085c0cf33f",
  "eh": "e601b84ffe13",
  "ko": "  억지로 끌려가는 아가씨와 불길 속에 삼켜지는 아이들...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3401,
  "addr": "0x01E2AE",
  "jh": "08e67511b6ea",
  "eh": "6d2aeb7e6457",
  "ko": "  불길을 등지고 한 여자아이가, 그을음으로 새까매진 얼굴을 눈물로 적시며 하늘을 향해 무언가를 외치고 있었다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3402,
  "addr": "0x01E2F3",
  "jh": "d7a540c8ccc2",
  "eh": "693bf79108ab",
  "ko": "  소녀의 오른쪽 눈동자가 고양이처럼 가늘어지며...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3403,
  "addr": "0x01E311",
  "jh": "02327984e314",
  "eh": "ed5836925942",
  "ko": "  “그만해!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3404,
  "addr": "0x01E31E",
  "jh": "2e48669b973b",
  "eh": "672deffd068f",
  "ko": "  키드가 절규했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3405,
  "addr": "0x01E32A",
  "jh": "635f14152cd8",
  "eh": "da236a1db36c",
  "ko": "  스윽 거울의 영상이 멀어졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3406,
  "addr": "0x01E34C",
  "jh": "3440c9cd4d9a",
  "eh": "3afbb088118b",
  "ko": "  주먹을 꽉 쥐고 고개를 숙이는 키드.\n  방 안을 침묵이 지배했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3407,
  "addr": "0x01E377",
  "jh": "5c01ccfea4e3",
  "eh": "cf21ccc6c869",
  "ko": "  나는 걱정이 되어 말을 걸었다.\n  “키드...",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3408,
  "addr": "0x01E37F",
  "jh": "073f07ca540d",
  "eh": "c34773a644e7",
  "ko": " 미안...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3409,
  "addr": "0x01E39B",
  "jh": "336d638e4cc6",
  "eh": "9b18cc33cf6f",
  "ko": "  “가자.”\n  키드는 갑자기 휙 발길을 돌려 문으로 향했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3410,
  "addr": "0x01E3C4",
  "jh": "78c1f2801512",
  "eh": "b12691a9daf2",
  "ko": "  “잠깐, 키드!”\n  나는 허둥지둥 그 뒤를 쫓았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3411,
  "addr": "0x01E3EB",
  "jh": "ec3e1b29e50b",
  "eh": "2b8ed3ea48dd",
  "ko": "  “길의 과거를 알고 싶어.”\n  말하면서 나는 힐끗 길을 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3412,
  "addr": "0x01E41B",
  "jh": "27e9cd9097c6",
  "eh": "ab67ea7ae6dc",
  "ko": "  “알겠습니다.”\n  거울 속 비너스가 눈을 내리깔았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3413,
  "addr": "0x01E440",
  "jh": "63ba0c3d45cd",
  "eh": "d29adf834c63",
  "ko": "  그 순간 거울 표면에 어둠이 퍼졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3414,
  "addr": "0x01E459",
  "jh": "a5b022ebb1b9",
  "eh": "99d1c81b7ce7",
  "ko": "  하지만 거울은 어두운 어둠만 보여 줄 뿐, 아무것도 비추지 않았다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3415,
  "addr": "0x01E47C",
  "jh": "829b5ed0681c",
  "eh": "9b5628946dbf",
  "ko": "  어떻게 된 걸까?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3416,
  "addr": "0x01E495",
  "jh": "dc57fa533230",
  "eh": "91756fcb237c",
  "ko": "  “그런 맛이 간 거울 따위 내버려 두고, 일하러 돌아가자고.”\n  성미 급한 키드는 벌써 다른 것에 눈을 돌리고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3417,
  "addr": "0x01E4D8",
  "jh": "d66731a50d78",
  "eh": "f1abff280904",
  "ko": "  우리는 거울 앞을 떠나 다시 방을 뒤지기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3418,
  "addr": "0x01E501",
  "jh": "0b8ff6f738df",
  "eh": "7aa0e825d281",
  "ko": "  “알겠습니다.”\n  속삭임의 거울이 대답했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3419,
  "addr": "0x01E518",
  "jh": "8dc5a5430a10",
  "eh": "970fcd2caa66",
  "ko": "  거울 표면이 물처럼 흔들리더니, 화사한 색채가 떠올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3420,
  "addr": "0x01E549",
  "jh": "2b30debede01",
  "eh": "95f79e534d50",
  "ko": "  그곳은 색색의 꽃들이 흐드러지게 핀 아름다운 정원이었다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3421,
  "addr": "0x01E571",
  "jh": "cb13d5048fd6",
  "eh": "cc5111097652",
  "ko": "  잘 손질된 나무 그늘에서 남자아이와 여자아이가 놀고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3422,
  "addr": "0x01E599",
  "jh": "382e7543bee2",
  "eh": "e017ffe5dc26",
  "ko": "  남자아이의 눈동자에는 어딘가 길을 떠올리게 하는 데가 있는데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3423,
  "addr": "0x01E5BF",
  "jh": "392a5ffb8a35",
  "eh": "f3a11bbf3192",
  "ko": "  {어라, 이 여자아이, 서재에서 본 초상화 속 아가씨를 닮았는데... 설마...?}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3424,
  "addr": "0x01E5EE",
  "jh": "46087e2a299d",
  "eh": "ae2939e1b12d",
  "ko": "  거울 속에서 소리도 없이 두 사람은 즐겁게 이야기하고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3425,
  "addr": "0x01E60D",
  "jh": "82c3c9cab1b6",
  "eh": "a15c68e4013b",
  "ko": "  남자아이가 문득 진지한 눈빛으로 무언가를 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3426,
  "addr": "0x01E62D",
  "jh": "3c90c99ea9cd",
  "eh": "e9a3072787e2",
  "ko": "  여자아이는 놀란 듯 남자아이를 바라보더니, 이윽고 꼭 고개를 끄덕였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3427,
  "addr": "0x01E656",
  "jh": "c8f496685d3b",
  "eh": "108da20bbd5d",
  "ko": "  두 사람은 작은 손을 뻗어 새끼손가락을 걸었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3428,
  "addr": "0x01E673",
  "jh": "20694ade6597",
  "eh": "5ca55c6fc1f2",
  "ko": "  진지한 두 사람의 모습을 보고 있자니, 왠지 애틋해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3429,
  "addr": "0x01E699",
  "jh": "f5472b000efa",
  "eh": "31996313bba0",
  "ko": "  대체 무엇을 약속하고 있는 걸까?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3430,
  "addr": "0x01E6B1",
  "jh": "81c7f712f66b",
  "eh": "eaf11e9610a3",
  "ko": "  이윽고 거울의 영상은 수면에 비친 풍경처럼 흔들리며 사라져 갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3431,
  "addr": "0x01E6E9",
  "jh": "4a07e3cf51cf",
  "eh": "321f9ba125c9",
  "ko": "  “저는 부럽사와요. 이런 멋진 추억을 갖고 계시다니.”\n  비너스상이 쓸쓸하게 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3432,
  "addr": "0x01E72B",
  "jh": "5cda54d99de3",
  "eh": "c5201ee4ad84",
  "ko": "  길은 아무 대답도 하지 않고 거울에 등을 돌렸다.\n  “놀고 있을 틈은 없다. 다른 곳을 조사하자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3433,
  "addr": "0x01E75A",
  "jh": "ab98df61e7de",
  "eh": "02ac34cab005",
  "ko": "  키드가 어깨를 으쓱해 보였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3434,
  "addr": "0x01E76B",
  "jh": "d1a48e7ff60b",
  "eh": "d643c0580395",
  "ko": "  우리는 다시 방을 조사하기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3435,
  "addr": "0x01E785",
  "jh": "1df82e50595f",
  "eh": "1394e7f20592",
  "ko": "  나는 새삼 방 안을 둘러보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3436,
  "addr": "0x01E79A",
  "jh": "ffaeaed531ab",
  "eh": "0f4e7104dc45",
  "ko": "  {으음...} 조사한다고 해도... 딱히 대단한 게 있을 것 같지는 않다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3437,
  "addr": "0x01E7C5",
  "jh": "c37e9e2d6db0",
  "eh": "223addd657c3",
  "ko": "  {어떡하지?}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3438,
  "addr": "0x01E7D5",
  "jh": "49a129979cea",
  "eh": "bf2e682e81fd",
  "ko": "  • 키드의 감에 맡긴다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3439,
  "addr": "0x01E7E8",
  "jh": "4e0048c31150",
  "eh": "2bd565eaf201",
  "ko": "  • 길의 경험에 맡긴다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3440,
  "addr": "0x01E7FB",
  "jh": "c6226c4d21e3",
  "eh": "b87c8a930f94",
  "ko": "  • 일단 내가 어떻게든 해 본다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3441,
  "addr": "0x01E811",
  "jh": "26dc56bef528",
  "eh": "294f6d0e475e",
  "ko": "  “저기, 키드. 천재 도둑의 감에 뭔가 딱 오는 거 없어?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3442,
  "addr": "0x01E83F",
  "jh": "e49e13e4e1e5",
  "eh": "db4d666d29df",
  "ko": "  그 근처 서랍을 마구 뒤지던 키드가 휙 돌아보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3443,
  "addr": "0x01E865",
  "jh": "b94a870930d1",
  "eh": "e863e5b15ce7",
  "ko": "  양손에는 펜이 두 자루.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3444,
  "addr": "0x01E87A",
  "jh": "a45d62050c89",
  "eh": "2fd114da6af1",
  "ko": "  “하하하하하. 야마네코 자식, 이렇게 해 주마!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3445,
  "addr": "0x01E89E",
  "jh": "fc1b02403dac",
  "eh": "8720f8302644",
  "ko": "  여기저기 낙서를 시작하는 키드.\n  가구, 바닥, 벽에도 박박.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3446,
  "addr": "0x01E8CD",
  "jh": "4546149fbf3c",
  "eh": "ae7bd311814f",
  "ko": "  {“바보, 멍청이, 얼간이. 너네 엄마 배꼽 튀어나왔대. 덤으로 너는 왕배꼽.”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3447,
  "addr": "0x01E90A",
  "jh": "25ce88ad576e",
  "eh": "9e47de333aeb",
  "ko": "  완전히 평범한 거울로 돌아와 있는 속삭임의 거울에도 낙서해 나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3448,
  "addr": "0x01E933",
  "jh": "93b0f983aed3",
  "eh": "e2686b0fecae",
  "ko": "  “꺄아아! 너무하세요...”\n  속삭임의 거울이 비명을 질렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3449,
  "addr": "0x01E953",
  "jh": "75045e91ba89",
  "eh": "f6ffee012393",
  "ko": "  “아~, 속 시원하다.”\n  하고 펜을 내던지는 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3450,
  "addr": "0x01E974",
  "jh": "9afe4c97679c",
  "eh": "2e4737337f76",
  "ko": "  “저기, 어쩌려고 그래. 이렇게 해 놓고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3451,
  "addr": "0x01E98F",
  "jh": "b0b03bc81cc8",
  "eh": "770fcf800ef9",
  "ko": "  “난 모~른다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3452,
  "addr": "0x01E99E",
  "jh": "051479c91017",
  "eh": "9fcbd71db83e",
  "ko": "  속이 풀렸는지, 키드는 냉큼 문간으로 향했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3453,
  "addr": "0x01E9BD",
  "jh": "cd8ed4d64304",
  "eh": "abd8468f5966",
  "ko": "  나는 불쌍해서 속삭임의 거울을 깨끗이 닦아 준 다음, 몰라보게 변해 버린 야마네코의 방을 뒤로했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3454,
  "addr": "0x01EA04",
  "jh": "80940a3d29aa",
  "eh": "49011969a9ca",
  "ko": "  “길이라면 어디를 조사할 거야?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3455,
  "addr": "0x01EA15",
  "jh": "1686105801d8",
  "eh": "3f135e4d6415",
  "ko": "  길은 고개를 끄덕이더니, 곧바로 방 안의 온갖 그림자와 하나가 되기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3456,
  "addr": "0x01EA3A",
  "jh": "05080fa740bf",
  "eh": "3ba77090e77e",
  "ko": "  책상 그림자며 장식장 그림자가 생명을 얻은 듯 일렁였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3457,
  "addr": "0x01EA61",
  "jh": "cf9eaa75986c",
  "eh": "b7f88583da7e",
  "ko": "  이윽고 길이 선반 그림자에서 나타났다.\n  “이게 떨어져 있었다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3458,
  "addr": "0x01EA85",
  "jh": "6364d2125b48",
  "eh": "29b70a9fba2a",
  "ko": "  손에는 빛바랜 종잇조각 몇 장과 동전 세 닢이 쥐여 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3459,
  "addr": "0x01EAAF",
  "jh": "b2c58f6dcca0",
  "eh": "4309eb40a2bb",
  "ko": "  종잇조각은 변경 레지오나의 지도와 쓰지 않은 편지지였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3460,
  "addr": "0x01EADD",
  "jh": "dbec3e3523a1",
  "eh": "bd37b34caafb",
  "ko": "  “방 청소하러 온 게 아니라고.”\n  키드가 투덜거렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3461,
  "addr": "0x01EAFD",
  "jh": "c50ee585f5b9",
  "eh": "99c34c8dda15",
  "ko": "  “이제 됐어. 가자고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3462,
  "addr": "0x01EB0D",
  "jh": "19a1426865d4",
  "eh": "853219ed5b08",
  "ko": "  키드의 말에 재촉받아, 우리는 야마네코의 방을 뒤로했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3463,
  "addr": "0x01EB39",
  "jh": "b012342a1438",
  "eh": "acb62c6dd25d",
  "ko": "  {그래, 늘 남한테 기대기만 하는 것도 좋지 않지.}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3464,
  "addr": "0x01EB5C",
  "jh": "4986b9981ef7",
  "eh": "3fa7134b27a6",
  "ko": "  뭔가 숨길 만한 곳은... 하고.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3465,
  "addr": "0x01EB70",
  "jh": "8ab732ab86e4",
  "eh": "64c10bc0c994",
  "ko": "  창가에 놓인 넉넉하고 조금 큼직한 소파에 내 눈이 멈췄다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3466,
  "addr": "0x01EBA1",
  "jh": "50fbd67a3b70",
  "eh": "47e15c3d1e60",
  "ko": "  걸터앉았다가 벌렁 누워 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3467,
  "addr": "0x01EBBD",
  "jh": "f06994a5c664",
  "eh": "4a62cfa557ad",
  "ko": "  내 등에 뭔가가 닿았다. 쿠션 사이에 딱딱한 것이 끼어 있다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3468,
  "addr": "0x01EBEB",
  "jh": "a198cba7354c",
  "eh": "6c399b6d1ecc",
  "ko": "  나온 것은 갈색 병이었다.\n  안에 액체가 들어 있다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3469,
  "addr": "0x01EC14",
  "jh": "3d0efa85aaba",
  "eh": "fbed4179483a",
  "ko": "  “뭐야 뭐야, 피곤할 때 상쾌하게 회복?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3470,
  "addr": "0x01EC31",
  "jh": "b68f91866348",
  "eh": "7676d6c82f06",
  "ko": "  “네가 마셔 보든가?”\n  하고 키드가 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3471,
  "addr": "0x01EC47",
  "jh": "ab6d3830ccd4",
  "eh": "f945780fcc78",
  "ko": "  “영양 불량, 허약 체질, 식욕 부진, 수면 부족, 관절통, 냉증, 두통, 요통에 잘 듣는대.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3472,
  "addr": "0x01EC9A",
  "jh": "35addc08443f",
  "eh": "4e541b32052a",
  "ko": "  “쳇, 그럼 만병통치약이네.”\n  별로 기대하지 않고 마셔 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3473,
  "addr": "0x01ECCB",
  "jh": "cc4520a4f549",
  "eh": "115f257f9e0b",
  "ko": "  몸이 뜨거워지고, 혈액 순환이 좋아지는 것 같다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3474,
  "addr": "0x01ECFD",
  "jh": "f07fddd7925d",
  "eh": "aac0b34ff2ae",
  "ko": "  “어때?”\n  “응, 피로가 풀린 것 같아.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3475,
  "addr": "0x01ED18",
  "jh": "4c80e455b8fe",
  "eh": "4b53915daf66",
  "ko": "  “그럼 슬슬 가자고. 다른 재미있는 것도 없어 보이고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3476,
  "addr": "0x01ED40",
  "jh": "8ffa6fd498ea",
  "eh": "f711c16bf258",
  "ko": "  우리는 야마네코의 방을 뒤로했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3477,
  "addr": "0x01ED5C",
  "jh": "807a91c23aee",
  "eh": "9551db1f9e5f",
  "ko": "  “좋아, 이 방 어딘가에 보물고 열쇠의 단서가 있을 거야.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3478,
  "addr": "0x01ED80",
  "jh": "46e35ce961ce",
  "eh": "b3859d2525c7",
  "ko": "  우리는 방을 뒤지기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3479,
  "addr": "0x01ED93",
  "jh": "12843b9b87bc",
  "eh": "2a45191b5764",
  "ko": "  책상 서랍, 벽에 걸린 그림, 사이드 테이블 위의 물병...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3480,
  "addr": "0x01EDC4",
  "jh": "a2a9e8086a37",
  "eh": "83cec352b2d0",
  "ko": "  그런 자잘한 것까지 조사해 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3481,
  "addr": "0x01EDDB",
  "jh": "b44a2975f280",
  "eh": "35e9788c2951",
  "ko": "  수상한 곳은 이제 없을까...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3482,
  "addr": "0x01EDF2",
  "jh": "b202752e8657",
  "eh": "8f8d6cbcf8fe",
  "ko": "  방을 둘러보던 내 눈에 기묘한 것이 비쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3483,
  "addr": "0x01EE10",
  "jh": "4e33e91953c3",
  "eh": "577f97bc1724",
  "ko": "  방 한쪽 구석에 놓인 받침대.\n  받침대 위에는 의미심장하게 진홍빛 천이 씌워져 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3484,
  "addr": "0x01EE4A",
  "jh": "46a743b5b509",
  "eh": "24f79c144b6a",
  "ko": "  나는 천천히 손을 뻗었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3485,
  "addr": "0x01EE5B",
  "jh": "9664060f46e8",
  "eh": "9f3434ddc51a",
  "ko": "  타오르는 듯한 붉은 천을 살며시 걷어 내자, 커다란 거울 하나가 나타났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3486,
  "addr": "0x01EE88",
  "jh": "a7af2ef37dd8",
  "eh": "5221c30e7ca7",
  "ko": "  아라베스크 무늬가 들어간 흔한 옛 거울이다. 마침 비너스상이 비치고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3487,
  "addr": "0x01EEB9",
  "jh": "36782910e14d",
  "eh": "b1c195952206",
  "ko": "  갑자기 거울 속 비너스상의 눈이 빛났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3488,
  "addr": "0x01EEE2",
  "jh": "4eeddbbc00ce",
  "eh": "b08ffa76ac8d",
  "ko": "  “무슨 용건이신지요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3489,
  "addr": "0x01EEF8",
  "jh": "0a6802bb438b",
  "eh": "6ac90307ea46",
  "ko": "  “우왓, 거울이 말했다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3490,
  "addr": "0x01EF0B",
  "jh": "a82e45398d63",
  "eh": "1c094f017da8",
  "ko": "  곧바로 키드와 길이 다가왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3491,
  "addr": "0x01EF1E",
  "jh": "cd498574f178",
  "eh": "f82efc86ac8b",
  "ko": "  “놀랄 것 없다. 이건 속삭임의 거울이다.”\n  거울을 보며 길이 냉정하게 대답했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3492,
  "addr": "0x01EF44",
  "jh": "dc8fdfe6cf0c",
  "eh": "3c6604a6700b",
  "ko": "  “속삭임의 거울?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3493,
  "addr": "0x01EF4D",
  "jh": "b0e1ae674f53",
  "eh": "c13760e86b59",
  "ko": "  “정령이 깃든 마법의 거울이다. 거울의 정령은 거울 속을 자유롭게 오가며, 묻는 자에게 조언을 준다고 하지.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3494,
  "addr": "0x01EF98",
  "jh": "1e99636275ac",
  "eh": "f1a637b720d3",
  "ko": "  {흐음, 뭔가 물어볼까?}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3495,
  "addr": "0x01EFB2",
  "jh": "0d5e7a41cb63",
  "eh": "02e0cc69a369",
  "ko": "  • 보물고 열쇠가 있는 곳을 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3496,
  "addr": "0x01EFC8",
  "jh": "41c4e511475b",
  "eh": "b5e32eeda958",
  "ko": "  • 야마네코가 있는 곳을 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3497,
  "addr": "0x01EFDB",
  "jh": "17374371c957",
  "eh": "77d7ee24a990",
  "ko": "  • 키드의 신체 사이즈를 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3498,
  "addr": "0x01EFF3",
  "jh": "451fff941ed4",
  "eh": "90c88a815851",
  "ko": "  “보물고 열쇠가 어디 있는지 알면 가르쳐 줄 수 없을까?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3499,
  "addr": "0x01F018",
  "jh": "06373a2eed88",
  "eh": "56def12d859d",
  "ko": "  거울 표면이 물결쳤다... 책장이 잔뜩 늘어선 방이 비쳤다.\n",
  "status": "draft",
  "note": ""
 }
]