[
 {
  "i": 4500,
  "addr": "0x028597",
  "jh": "5d562d49c529",
  "eh": "a8ca93d44c1a",
  "ko": " 그, 그런~!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4501,
  "addr": "0x0285A8",
  "jh": "6b1f0f4ed9b0",
  "eh": "62d81f9242d2",
  "ko": "  앞으로 나서는 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4502,
  "addr": "0x0285B6",
  "jh": "02c9cd84da8f",
  "eh": "5bc65955a55d",
  "ko": "  슬금슬금 뒷걸음질 치는 그리폰.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4503,
  "addr": "0x0285C7",
  "jh": "65634c533a5d",
  "eh": "45a792161dbd",
  "ko": "  “기다려!!”\n  길이 키드를 말렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4504,
  "addr": "0x0285DE",
  "jh": "8dcc6db290e8",
  "eh": "a645adefa8d2",
  "ko": "  “들어나 보자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4505,
  "addr": "0x0285F2",
  "jh": "40b243972617",
  "eh": "818abeb47215",
  "ko": "  “아... 감사합니다!!”\n  안도해서 흐물흐물 풀려 버리는 그리폰.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4506,
  "addr": "0x02861F",
  "jh": "0ce2cfb7717b",
  "eh": "b66734c2b6a9",
  "ko": "  “쳇. 재미없네.”\n  키드는 볼을 부풀리며 고개를 돌렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4507,
  "addr": "0x028648",
  "jh": "6a6212cb19e2",
  "eh": "c9ab3c668f43",
  "ko": "  “잘 들으세요, 정 많은 밤의 나리.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4508,
  "addr": "0x028663",
  "jh": "4cdead425b4d",
  "eh": "90fb74d1003e",
  "ko": "  오른쪽으로 세 번...\n  왼쪽으로 두 번...\n  오른쪽으로 두 번...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4509,
  "addr": "0x02868C",
  "jh": "15b935aa4bf6",
  "eh": "acd0d44a2113",
  "ko": "  야마네코의 소용돌이 덫에 붙잡혔을 때는 제 말을 떠올려 주세요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4510,
  "addr": "0x0286B8",
  "jh": "a5e3b8257954",
  "eh": "03d25a74d4b6",
  "ko": "  그렇게 말하더니 그리폰은 다시 쥐의 모습으로 돌아가, 벽 구석에 뚫린 작은 구멍으로 뛰어들어 모습을 감춰 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4511,
  "addr": "0x0286F5",
  "jh": "6e4739e8ad6e",
  "eh": "36cdec6a88b2",
  "ko": "  “야마네코의 덫에 붙잡히면, 이라고?",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4512,
  "addr": "0x02870A",
  "jh": "7cb22292ecc9",
  "eh": "f04166313495",
  "ko": " 흥! 이 몸이 그런 실수를 할 리가 없잖아!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4513,
  "addr": "0x02872E",
  "jh": "478f903a6ce7",
  "eh": "81b2852b957a",
  "ko": "  가자. 엉뚱하게 시간만 버렸네.”\n  발길을 돌려 문간으로 향하는 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4514,
  "addr": "0x02875F",
  "jh": "8d859578c321",
  "eh": "0c9780001ee8",
  "ko": "  우리는 부엌을 뒤로했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4515,
  "addr": "0x02877F",
  "jh": "7346c890c7e9",
  "eh": "a5c5a9c24049",
  "ko": "  부엌 앞에서부터 오른쪽으로 통로가 뻗어 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4516,
  "addr": "0x02879B",
  "jh": "f69d998e63e5",
  "eh": "c0d45eb31b8c",
  "ko": "  우리는 통로를 되돌아갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4517,
  "addr": "0x0287BE",
  "jh": "744d602ebfb1",
  "eh": "cdee79e879c7",
  "ko": "  이 부엌에는 한 번 왔었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4518,
  "addr": "0x0287D0",
  "jh": "01d04907b7cd",
  "eh": "00ad0dd4e247",
  "ko": "  쥐의 모습은 이미 없다...\n  냄비의 요리도 없다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4519,
  "addr": "0x0287F3",
  "jh": "b6a8f2364da2",
  "eh": "8cda71a1d266",
  "ko": "  우리는 그대로 방을 나왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4520,
  "addr": "0x028851",
  "jh": "38e83ac3df76",
  "eh": "5bc07ae78f6b",
  "ko": "  아늑해 보이는 깔끔한 방이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4521,
  "addr": "0x02886C",
  "jh": "f30678c8cbb9",
  "eh": "755995d02a15",
  "ko": "  책상이나 선반 위의 소품들에서는 쓰임새보다 귀여움이 느껴졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4522,
  "addr": "0x028895",
  "jh": "a95da61bbad8",
  "eh": "666b2c05477c",
  "ko": "  호화로운 책상과 푹신푹신한 침대가 우아한 생활을 연상시켰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4523,
  "addr": "0x0288C2",
  "jh": "dbec3b8f24b2",
  "eh": "3eaf86ab51e9",
  "ko": "  “누구 있어요?”\n  갑자기 높은 여자 목소리가 들려, 우리는 몸을 숨겼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4524,
  "addr": "0x0288F3",
  "jh": "cbb3b81d79bf",
  "eh": "a46ad5c3652c",
  "ko": "  안쪽에서 나타난 것은 옅게 화장한 상냥해 보이는 소녀였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4525,
  "addr": "0x028915",
  "jh": "5acaa1261492",
  "eh": "66aad4f20431",
  "ko": "  야마네코의 딸, 리델이다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4526,
  "addr": "0x028924",
  "jh": "489a514e65df",
  "eh": "655abe31a512",
  "ko": "  “이상하네? 기분 탓인가?”\n  리델은 우리를 눈치채지 못했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4527,
  "addr": "0x028949",
  "jh": "f89ac0df03f3",
  "eh": "47be68d4b2ca",
  "ko": "  가만히 숨을 죽이고 상황을 살피던 내 눈이 이변을 포착했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4528,
  "addr": "0x02896F",
  "jh": "ed827eec77d5",
  "eh": "4847a4f10d56",
  "ko": "  방 안의 그림자란 그림자가 일렁일렁 흔들리기 시작한 것이다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4529,
  "addr": "0x028994",
  "jh": "13d0f9f74b6f",
  "eh": "31942f79b94b",
  "ko": "  설마 길...?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4530,
  "addr": "0x02899F",
  "jh": "f46c8166aadb",
  "eh": "c8ea8291230d",
  "ko": "  그렇게 생각한 순간, 그림자에서 길이 스윽 나타났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4531,
  "addr": "0x0289BD",
  "jh": "6f1927dd4ead",
  "eh": "7eb217895c2c",
  "ko": "  눈앞에 나타난 낯선 사내에게 리델은 잠시 멍해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4532,
  "addr": "0x0289E0",
  "jh": "40f4fb1e41d0",
  "eh": "0888da8fc248",
  "ko": "  소란을 피우면 곤란하다. 여기선 어떻게든 얼버무려야...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4533,
  "addr": "0x028A07",
  "jh": "3d2e195ad8d1",
  "eh": "2a4e4aa843d8",
  "ko": "  • 신문 구독 권유입니다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4534,
  "addr": "0x028A1B",
  "jh": "2c4930ec0671",
  "eh": "1999a297b03f",
  "ko": "  • 사실은 도둑입니다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4535,
  "addr": "0x028A29",
  "jh": "edf54587fe31",
  "eh": "31c10cf5bf8d",
  "ko": "  “신문 구독 권유입니다, 아가씨.”\n  나는 붙임성 있는 웃음을 띠었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4536,
  "addr": "0x028A54",
  "jh": "860d7ce16871",
  "eh": "2a98e98fe57c",
  "ko": "  “이미 보고 있어요.”\n  아직 사정을 파악하지 못한 리델은 반사적으로 대답했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4537,
  "addr": "0x028A89",
  "jh": "dda1cfa93faf",
  "eh": "68f0130ff2e5",
  "ko": "  키드가 내 귀를 꼬집었다.\n  “어설픈 거짓말 하지 마!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4538,
  "addr": "0x028AAD",
  "jh": "cee506dbde5e",
  "eh": "6e598219c98f",
  "ko": "  리델은 나와 키드의 얼굴을 번갈아 보더니, 겨우 상황을 이해한 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4539,
  "addr": "0x028AD9",
  "jh": "02a910cfb436",
  "eh": "c17083e34a7a",
  "ko": "  “어? 누구예요, 당신들...”\n  우리를 경계하며 뒷걸음질 쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4540,
  "addr": "0x028B05",
  "jh": "60af2e055e7b",
  "eh": "bf44f83004e0",
  "ko": "  어떻게든 우리가 위험하지 않은 착한 도둑이라는 걸 알려야 하는데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4541,
  "addr": "0x028B30",
  "jh": "ffddfd20ccde",
  "eh": "ed0bc1e61e06",
  "ko": "  “사실은 도둑이에요. 당신의 마음을 훔치러...”\n  초조한 나머지 이상한 소리를 내뱉고 말았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4542,
  "addr": "0x028B6B",
  "jh": "bed7ab1d521c",
  "eh": "0197e119312c",
  "ko": "  “촌스럽긴, 그런 대사로 등장하는 거야?”\n  키드가 싸늘하게 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4543,
  "addr": "0x028B94",
  "jh": "76d54f104f93",
  "eh": "37b1cfa0dd43",
  "ko": "  “그럼 키드는 어떤 게 좋은데?”\n  “당연히, 미소녀 괴도 키드, 등장!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4544,
  "addr": "0x028BC2",
  "jh": "e9a70c479b4a",
  "eh": "184102698094",
  "ko": "  우리가 옥신각신하고 있자, 리델의 얼굴이 창백해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4545,
  "addr": "0x028BDD",
  "jh": "8aad125111fb",
  "eh": "e5401b61aa9b",
  "ko": "  “누구예요, 당신들...”\n  겁먹은 눈으로 우리를 보고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4546,
  "addr": "0x028C05",
  "jh": "0c070e479989",
  "eh": "e1e80838d759",
  "ko": "  길은 떨고 있는 리델을 바라보며 다정한 말투로 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4547,
  "addr": "0x028C25",
  "jh": "feee18add00a",
  "eh": "a62f7912579d",
  "ko": "  “놀라게 해서 미안하다. 너를 해칠 생각은 없으니 안심해...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4548,
  "addr": "0x028C52",
  "jh": "1f782a37ad90",
  "eh": "9fd2f43d6b75",
  "ko": "  길의 설득도 허무하게 리델은 큰 소리를 질렀다.\n  “당신들, 도둑이죠! 가까이 오지 마요!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4549,
  "addr": "0x028C8A",
  "jh": "570aea5e4d60",
  "eh": "e1b39965b939",
  "ko": "  리델은 엄청난 비명을 지를 것 같았다.\n  어쩔 수 없다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4550,
  "addr": "0x028CB0",
  "jh": "1f9c596a77ef",
  "eh": "263a3efca710",
  "ko": "  • 재갈을 물린다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4551,
  "addr": "0x028CC1",
  "jh": "e2d0157b5d05",
  "eh": "43068397a540",
  "ko": "  • 기절시킨다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4552,
  "addr": "0x028CCD",
  "jh": "f829c8352189",
  "eh": "1ee7af5875ed",
  "ko": "  내가 침대에서 시트를 벗겨 내자, 키드가 크게 고개를 끄덕였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4553,
  "addr": "0x028CF4",
  "jh": "4bf3939b0bb3",
  "eh": "2e5ed6568214",
  "ko": "  “그래, 그걸로 둘둘 말아서 옷장에라도 처박아 두자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4554,
  "addr": "0x028D1E",
  "jh": "fc4e72ef3074",
  "eh": "92dd10e4e54e",
  "ko": "  그런데 길이 무서운 형상으로 내 손에서 시트를 빼앗았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4555,
  "addr": "0x028D49",
  "jh": "879515d21f60",
  "eh": "7252585ee91f",
  "ko": "  내가 살며시 나이프를 움켜쥐자, 키드가 알아채고 손으로 막았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4556,
  "addr": "0x028D6D",
  "jh": "4ca1c0a636ab",
  "eh": "bc2cdbc54c5f",
  "ko": "  “기절시킬 거면 내가 하는 게 덜 위험해.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4557,
  "addr": "0x028D8D",
  "jh": "a30673c8128e",
  "eh": "332ea230ca97",
  "ko": "  나이프를 손에 들고 소곤거리는 것을 보고, 리델이 두 손으로 얼굴을 감쌌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4558,
  "addr": "0x028DB4",
  "jh": "d7773f010204",
  "eh": "a3534adce860",
  "ko": "  그러자 길이 성큼성큼 우리에게 다가와 나이프를 쳐서 떨어뜨렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4559,
  "addr": "0x028DDE",
  "jh": "2f0befccedc7",
  "eh": "19d38c67b97b",
  "ko": "  “대체 당신은 누구예요?”\n  길 덕분에 신변의 위험이 사라진 것에 리델은 당혹스러워했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4560,
  "addr": "0x028E18",
  "jh": "73f66f6eb325",
  "eh": "311c772a3044",
  "ko": "  길은 대답하기 어려운 듯 리델에게서 눈을 돌렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4561,
  "addr": "0x028E32",
  "jh": "445f1de8368e",
  "eh": "76ca2420a7ba",
  "ko": "  “어떻게 된 거야? 배신할 셈이야?”\n  키드가 목소리를 낮추고 다그쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4562,
  "addr": "0x028E61",
  "jh": "5c55e903da96",
  "eh": "5b336a60f9f1",
  "ko": "  두 사람 사이에서 깊이 고민하는 길.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4563,
  "addr": "0x028E76",
  "jh": "c278b963d457",
  "eh": "e38754a7e235",
  "ko": "  이윽고 길은 숨을 한 번 고르고 리델을 향해 말을 걸었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4564,
  "addr": "0x028E95",
  "jh": "5cda6e19c31a",
  "eh": "3eab9a5e1633",
  "ko": "  “리델... 너에게는 소꿉친구인 남자아이가 있었을 거다. 기억하나?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4565,
  "addr": "0x028EC5",
  "jh": "1cdfa686d115",
  "eh": "8fb562a101d3",
  "ko": "  짚이는 데가 있는지, 리델은 몸을 내밀어 길을 바라보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4566,
  "addr": "0x028EF6",
  "jh": "4c9804cfdf6d",
  "eh": "ef7e0f896757",
  "ko": "  “...설마? 길버트?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4567,
  "addr": "0x028F0E",
  "jh": "dc1a92599a27",
  "eh": "26cd21862181",
  "ko": "  “뭐?! 아는 사이야?”\n  키드가 놀란 듯 외쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4568,
  "addr": "0x028F34",
  "jh": "85a79cc9c374",
  "eh": "acb04783e16a",
  "ko": "  “정말 길이네! 반가워라.”\n  리델은 친근하게 길의 손을 잡았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4569,
  "addr": "0x028F5E",
  "jh": "82bd4589ce1e",
  "eh": "9fd3384a68be",
  "ko": "  손이 닿은 순간, 길을 감싸고 있던 그림자의 분위기가 바뀌었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4570,
  "addr": "0x028F84",
  "jh": "b37faa690209",
  "eh": "a1fcae8accd0",
  "ko": "  “그때 갑자기 사라져서... 내가 얼마나 걱정했는지...”\n  감정이 북받친 길의 목소리다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4571,
  "addr": "0x028FBA",
  "jh": "2fbf431e3839",
  "eh": "3ad6881b3bff",
  "ko": "  길의 모습에 불안을 느낀 키드가 허둥지둥 끼어들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4572,
  "addr": "0x028FDA",
  "jh": "08399249a340",
  "eh": "9dc0620d0770",
  "ko": "  “야! 목적은 얼어붙은 불꽃이라고. 여자나 꼬시고 있을 때가...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4573,
  "addr": "0x029003",
  "jh": "ffdbb566f045",
  "eh": "4befb3258905",
  "ko": "  “얼어붙은 불꽃이라고요?”\n  리델이 목소리를 높였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4574,
  "addr": "0x02901D",
  "jh": "01b622b06d64",
  "eh": "61717eb71526",
  "ko": "  “아아, 이렇게 너를 만나기 전까지는.”\n  그렇게 대답한 길은 우리가 아는 냉정한 길과는 딴사람 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4575,
  "addr": "0x02905D",
  "jh": "dd30bc6b4b5a",
  "eh": "e12431ad8f6d",
  "ko": "  나는 불길한 예감이 들어 키드를 보았다.\n  키드도 나와 같은 눈으로 이쪽을 보고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4576,
  "addr": "0x029084",
  "jh": "ea95f12f4e59",
  "eh": "b15e6fbe6665",
  "ko": "  우리는 말없이 시선을 길에게 돌렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4577,
  "addr": "0x029097",
  "jh": "a6d0f09fe3ce",
  "eh": "9dc84af1b001",
  "ko": "  “오늘 밤 이렇게 만난 건 우리가 붉은 실로 이어져 있다는 증거다.”\n  길의 말투가 점점 열기를 띠어 갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4578,
  "addr": "0x0290DC",
  "jh": "4fbbb04f4056",
  "eh": "32ef7b07f9f9",
  "ko": "  머리가 멍해진다. 길의 변모를 따라갈 수가 없다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4579,
  "addr": "0x0290FF",
  "jh": "8b2942e16ecb",
  "eh": "aacefcb19372",
  "ko": "  키드가 안 돼, 안 돼 하며 고개를 저으며 정신을 유지하려 애쓰고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4580,
  "addr": "0x029128",
  "jh": "99d8f57dd5f2",
  "eh": "f094185e3efd",
  "ko": "  우리의 분투도 허무하게, 길의 기괴한 언행은 점점 더 심해져 갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4581,
  "addr": "0x02915D",
  "jh": "ef1e39fd7806",
  "eh": "753516784317",
  "ko": "  “나는 어릴 때부터 줄곧 너만 생각해 왔다... 그러니까...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4582,
  "addr": "0x029187",
  "jh": "77edcedbb9ae",
  "eh": "56732547e6cb",
  "ko": "  허둥지둥 리델이 길의 손을 뿌리쳤다.\n  “갑자기 무슨 소리예요? 다시 만난 지 얼마나 됐다고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4583,
  "addr": "0x0291C3",
  "jh": "00f361a0dec6",
  "eh": "25ccc13a5992",
  "ko": "  “약속했잖아, 리델! 나랑 결혼해 주겠다고!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4584,
  "addr": "0x0291E8",
  "jh": "c897ffafa6a0",
  "eh": "569edcb9c01f",
  "ko": "  길은 상당히 감정적이 되어 있었다.\n  눈을 피하며 얼굴을 숙이는 리델.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4585,
  "addr": "0x02921D",
  "jh": "e2bbd2e6ff9e",
  "eh": "adddd2902f09",
  "ko": "  • 길을 싫어하는 걸까.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4586,
  "addr": "0x029231",
  "jh": "00a30c866032",
  "eh": "7d8d697ca654",
  "ko": "  • 따로 좋아하는 사람이라도 있는 걸까.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4587,
  "addr": "0x029246",
  "jh": "d1ba7a8e072d",
  "eh": "f7952992bd4d",
  "ko": "  “그런 옛날 일은 꺼내지 마요!”\n  격렬하게 고개를 저으며 리델이 외쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4588,
  "addr": "0x029276",
  "jh": "2ed5fbd1af04",
  "eh": "330279193f68",
  "ko": "  “내가 싫은 건가?”\n  희미하게 길의 목소리가 떨리고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4589,
  "addr": "0x02929C",
  "jh": "774a58fa7176",
  "eh": "552e575e3f22",
  "ko": "  “그런 문제가 아니잖아요? 만나자마자 이런 이야기를...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4590,
  "addr": "0x0292C4",
  "jh": "0bf35faa8aef",
  "eh": "beb7a6875b2b",
  "ko": "  “그 약속은 거짓말이었나?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4591,
  "addr": "0x0292D7",
  "jh": "676a3962c1b9",
  "eh": "1464c21a3601",
  "ko": "  감정적인 길에게 압도당한 리델이 비통한 목소리로 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4592,
  "addr": "0x0292FD",
  "jh": "fc3b5ae5dff4",
  "eh": "8e786b2e7789",
  "ko": "  “아아! 옛날부터 그래요. 길은 내 마음은 조금도 생각해 주지 않아!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4593,
  "addr": "0x029326",
  "jh": "82ea65e57411",
  "eh": "bb8a61be78c7",
  "ko": "  다섯 살 때 생일에 준 손수 만든 쿠키도 다른 애들한테 다 나눠 줘 버리고.\n  마을 축제 댄스파티에서는 같이 춤도 안 춰 줬고, 그리고...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4594,
  "addr": "0x029392",
  "jh": "6204b1fbb923",
  "eh": "d4ebf5905288",
  "ko": "  여자애들은 왜 이렇게 사소한 일을 마음에 담아 두는 걸까?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4595,
  "addr": "0x0293B6",
  "jh": "f16c4350bd62",
  "eh": "41d67d886071",
  "ko": "  “오해다, 리델! 쿠키는 모두에게 자랑하고 싶었던 거다. 춤은...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4596,
  "addr": "0x0293E6",
  "jh": "c5378977399c",
  "eh": "1d83619cc91d",
  "ko": "  잘 출 자신이 없어서...!”\n  십수 년 전의 일에 대해 길은 필사적으로 변명했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4597,
  "addr": "0x02941E",
  "jh": "6e93ca4ec6b3",
  "eh": "bd3a768135fa",
  "ko": "  “이제 와서 사과해 봤자! 게다가 이렇게 갑자기 나타나다니!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4598,
  "addr": "0x029443",
  "jh": "611945641001",
  "eh": "1e200819cc0a",
  "ko": "  리델은 혼란스러워하고 있었다. 긴 속눈썹이 눈물에 젖어 반짝였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4599,
  "addr": "0x029469",
  "jh": "20450d1f4b98",
  "eh": "778229b5c80f",
  "ko": "  “그야, 갑자기 나타나서 좋아한다느니 결혼 약속이라느니, 너무 억지잖아. 여자애는 섬세하다고.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4600,
  "addr": "0x0294B0",
  "jh": "facb138e31f7",
  "eh": "3175b711d6c7",
  "ko": "  키드가 리델의 편을 들었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4601,
  "addr": "0x0294C1",
  "jh": "50ffdc7acd07",
  "eh": "4a7004be3229",
  "ko": "  “그래? 나는 약속을 믿어 온 길한테 동정이 가는데.”\n  그렇게 말하자 키드가 얼굴을 찡그렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4602,
  "addr": "0x0294FB",
  "jh": "85b0e580afbb",
  "eh": "a403ade1648c",
  "ko": "  그래서야 인기 없다고, 어쩌고 하고 말하고 싶은 얼굴이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4603,
  "addr": "0x029521",
  "jh": "2d0a102cd375",
  "eh": "25453747add3",
  "ko": "  리델은 차갑게 길을 피하고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4604,
  "addr": "0x029537",
  "jh": "478d40b85153",
  "eh": "1c70f676dc0c",
  "ko": "  “설마, 마음이 변한 건가?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4605,
  "addr": "0x02954B",
  "jh": "bb7c5aa75b78",
  "eh": "cd8b3351b517",
  "ko": "  따로 좋아하는 놈이 있는 건가?”\n  길이 격하게 다그쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4606,
  "addr": "0x02956E",
  "jh": "e9a0f5379c6f",
  "eh": "f8dd8fc0e963",
  "ko": "  “그런 식으로 말하지 마요. 나는...”\n  당장이라도 울음을 터뜨릴 것 같은 눈으로 리델은 어깨를 떨구었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4607,
  "addr": "0x0295A7",
  "jh": "7d673c14fcad",
  "eh": "7f7f1a3da978",
  "ko": "  “질투가 심하면 미움받는다, 길.”\n  두 사람을 어떻게든 진정시키려고 키드가 길을 나무랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4608,
  "addr": "0x0295DC",
  "jh": "99802c74f035",
  "eh": "93c8284b5a88",
  "ko": "  “쌓인 이야기는 다음 기회에 하자고. 저 애도 정신없어하잖아...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4609,
  "addr": "0x02960B",
  "jh": "8c9ea10eca15",
  "eh": "e02dc52072b1",
  "ko": "  “하지만 이대로 떠나기는 차마 견딜 수가 없다.”\n  길이 리델을 바라본 채 대답했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4610,
  "addr": "0x029636",
  "jh": "eb708f0c5853",
  "eh": "65309ede37a7",
  "ko": "  그래도 다른 목적이 있는 키드는 얼른 여기를 나가고 싶은 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4611,
  "addr": "0x02965B",
  "jh": "7211dc8eb951",
  "eh": "1111b279a718",
  "ko": "  키드는 폭발할 것 같은 걸 참으며 길의 어깨를 두드리고 끈기 있게 설득했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4612,
  "addr": "0x029687",
  "jh": "c843495647fd",
  "eh": "d6015f20e9f3",
  "ko": "  그런데 그 모습을 보던 리델이 매서운 표정으로 길을 노려보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4613,
  "addr": "0x0296AA",
  "jh": "ee59ab2b1b86",
  "eh": "6e29a2a6e94f",
  "ko": "  “나한테 이러쿵저러쿵하기 전에, 거기 아가씨와의 관계부터 들려주는 게 도리 아닌가요!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4614,
  "addr": "0x0296E7",
  "jh": "3f5224582df3",
  "eh": "16c7b983ffa1",
  "ko": "  길이 허둥지둥 설명했다.\n  “이 녀석은 그냥 일 동료다. 정말이다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4615,
  "addr": "0x029715",
  "jh": "529d7ff43c32",
  "eh": "4a76647f787c",
  "ko": "  폭발 직전인 키드를 나에게 떠넘기고 열변을 토하는 길.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4616,
  "addr": "0x029737",
  "jh": "43d27ce011f1",
  "eh": "84f312fc2fd2",
  "ko": "  “너 같은 미인과 장래를 맹세했는데, 다른 시시한 여자에게 정신이 팔릴 리가 없잖나?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4617,
  "addr": "0x029771",
  "jh": "0d4a5308015e",
  "eh": "934cf6583582",
  "ko": "  {미안하게 됐다! 시시한 여자라서!} 하고 외치려는 키드의 입을 나는 손으로 막았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4618,
  "addr": "0x02979C",
  "jh": "06936e00b966",
  "eh": "0e3f2da75089",
  "ko": "  “키드가 나서면 복잡해지잖아.”\n  진심이 통했는지 키드는 얌전해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4619,
  "addr": "0x0297CD",
  "jh": "3c703525820a",
  "eh": "d98064c64346",
  "ko": "  내 손에는 선명하게 잇자국이 남았지만...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4620,
  "addr": "0x0297EB",
  "jh": "cb6bf7f34f94",
  "eh": "341a0687152c",
  "ko": "  리델은 미인이라는 말을 듣고 완전히 기분이 좋아진 것 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4621,
  "addr": "0x02980E",
  "jh": "4b1d8b82da5c",
  "eh": "71225af1a042",
  "ko": "  “어머, 길도 참. 미인이라니.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4622,
  "addr": "0x029828",
  "jh": "80cdc3e25d12",
  "eh": "4c6db79a69ff",
  "ko": "  여자애들은 왜 이렇게 입에 발린 말에 약한 걸까?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4623,
  "addr": "0x029845",
  "jh": "dabcab1c5f5d",
  "eh": "04908e0f72ff",
  "ko": "  “정말이야, 리델. 너는 예뻐졌다. 나는 그게 기쁜 동시에 걱정되기도 한다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4624,
  "addr": "0x029880",
  "jh": "f4518da5229a",
  "eh": "2976e0641e71",
  "ko": "  “......느끼해.”\n  우리는 닭살 돋는 대사에 오싹해졌다. 이건 점점 더 평소의 길이 아니다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4625,
  "addr": "0x0298BE",
  "jh": "aa7e2ef23797",
  "eh": "05c6625da85a",
  "ko": "  그때 안쪽에서 중년 여성의 목소리가 들렸다.\n  “리델 아가씨, 뭔가 소란스럽지 않으신지요...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4626,
  "addr": "0x0298F6",
  "jh": "f52cc5aa2cd0",
  "eh": "76ec4f340bea",
  "ko": "  리델의 시녀인 듯한 그 여성은 우리를 보고 안색이 변했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4627,
  "addr": "0x02991B",
  "jh": "9bd045f0a169",
  "eh": "69a817f4bd91",
  "ko": "  “꺄악! 아가씨!”\n  패닉을 일으킬 것 같은 시녀에게 리델이 허둥지둥 설명했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4628,
  "addr": "0x029955",
  "jh": "2baccff3c4e8",
  "eh": "a327b651f82d",
  "ko": "  “놀랄 것 없어. 길버트야. 노엘라, 너도 알 거야.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4629,
  "addr": "0x029983",
  "jh": "23acf3ee733c",
  "eh": "27929b2e5081",
  "ko": "  노엘라라 불린 시녀는 길버트라는 말을 듣자 곧바로 짐작이 간 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4630,
  "addr": "0x0299B2",
  "jh": "1d98f9da1a18",
  "eh": "142e0ac5b128",
  "ko": "  굳어 있던 얼굴도 부드럽게 바꾸고, 반색하며 길에게 다가갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4631,
  "addr": "0x0299DD",
  "jh": "851f6a575f7f",
  "eh": "183e3cdf43ed",
  "ko": "  “어머, 이웃집 길버트 도련님? 훌륭하게 자라셨네요...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4632,
  "addr": "0x029A05",
  "jh": "b1b6f7e1801e",
  "eh": "0c83342b5ccb",
  "ko": "  “아아, 이제 뭐가 뭔지...”\n  키드가 머리를 감싸 쥐고 주저앉았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4633,
  "addr": "0x029A2B",
  "jh": "1eca011bb1ce",
  "eh": "ee995671c8e2",
  "ko": "  길은 어이없어하는 키드를 아랑곳하지 않고 시녀와 예의 바르게 인사를 나누고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4634,
  "addr": "0x029A55",
  "jh": "0c94c05e8ccd",
  "eh": "1786b01449b8",
  "ko": "  대체 길은 무슨 생각을 하는 걸까.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4635,
  "addr": "0x029A71",
  "jh": "098a2957bbfc",
  "eh": "ab65ef624056",
  "ko": "  • “우리를 배신할 생각은...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4636,
  "addr": "0x029A8A",
  "jh": "33fe3e800ca7",
  "eh": "04cc39de50a6",
  "ko": "  • “설마 리델을 인질로?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4637,
  "addr": "0x029A9D",
  "jh": "6a1e343185fb",
  "eh": "30abc9b1b5fb",
  "ko": "  내 목소리는 꽤 작고 낮았는데도 키드는 알아들은 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4638,
  "addr": "0x029AC4",
  "jh": "00835d002d39",
  "eh": "2003d83f9ad2",
  "ko": "  “그래, 길! 이러고 있을 때가 아니잖아!”\n  키드가 참다못해 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4639,
  "addr": "0x029AF6",
  "jh": "639a6cef0452",
  "eh": "f71afd6577e1",
  "ko": "  그 목소리에 시녀는 처음으로 키드를 보더니 새파래졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4640,
  "addr": "0x029B15",
  "jh": "a3dd1b2c8af3",
  "eh": "fc4470f8c110",
  "ko": "  “이 막돼먹어 보이는 계집은...!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4641,
  "addr": "0x029B28",
  "jh": "0df97ee9594e",
  "eh": "b288d1f4fe7f",
  "ko": "  “아, 이 둘은 제 일 동료입니다.”\n  길이 나와 키드를 간단히 소개했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4642,
  "addr": "0x029B56",
  "jh": "ac5d3faa0a72",
  "eh": "92dbb7a0c878",
  "ko": "  “어머, 그거 실례했습니다. 저는 리델 아가씨를 모시는 시녀장을 맡고 있는... 노엘라입니다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4643,
  "addr": "0x029B98",
  "jh": "0296471e03ec",
  "eh": "bc738f57b7df",
  "ko": "  “아, 이거, 처음 뵙겠습니다.”\n  나와 키드는 그만 덩달아 고개를 숙여 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4644,
  "addr": "0x029BC8",
  "jh": "fcfd634856ba",
  "eh": "00db4559c523",
  "ko": "  “저는 어릴 적 길 도련님을 잘 알고 있답니다...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4645,
  "addr": "0x029BF7",
  "jh": "3ca0f4707469",
  "eh": "79d3b6f12fcb",
  "ko": "  이 시녀는 길의 어린 시절 이야기를 들려주는 게 무척 즐거운 모양이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4646,
  "addr": "0x029C22",
  "jh": "5ac396090439",
  "eh": "80a622864db0",
  "ko": "  줄줄 멋대로 떠들고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4647,
  "addr": "0x029C38",
  "jh": "cbccbe62abea",
  "eh": "9b6ea5ca3f18",
  "ko": "  “...정말이지, 리델 아가씨와 길 도련님은 사이가 좋으셔서, 모두의 눈을 피해 먼 곳까지 놀러 가시곤...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4648,
  "addr": "0x029C79",
  "jh": "1926b5a00171",
  "eh": "2131b0de9908",
  "ko": "  “저기, 당신 얘기 들을 시간은...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4649,
  "addr": "0x029C94",
  "jh": "034c91ddf991",
  "eh": "02fecd0e20ca",
  "ko": "  참다못한 키드가 가로막았지만, 시녀는 자자, 지금부터가 들을 만한 대목이에요, 하고 눈짓했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4650,
  "addr": "0x029CC8",
  "jh": "6ba0077b238f",
  "eh": "610a1b715158",
  "ko": "  “두 분의 이야기 중 가장 유명한 건 뭐니 뭐니 해도 비밀의 화원에서의 맹세랍니다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4651,
  "addr": "0x029CFD",
  "jh": "3c26594554f1",
  "eh": "c92d90c37702",
  "ko": "  그 아름다운 정원에서 어린 두 분은 굳게 장래를 맹세하셨지요...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4652,
  "addr": "0x029D30",
  "jh": "408936d9d520",
  "eh": "5f4c2fa4115c",
  "ko": "  시녀는 황홀한 눈빛으로 말을 이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4653,
  "addr": "0x029D51",
  "jh": "7ca00dcb4a6e",
  "eh": "743c1a3ff17f",
  "ko": "  “리델 아가씨에게는 이미 마음에 정한 분이 계시다는 걸, 그야 이제 다들 알고 있지요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4654,
  "addr": "0x029D89",
  "jh": "dc0d48adefb9",
  "eh": "ab30a4d3a90b",
  "ko": "  정작 리델은 시무룩한 얼굴로 덧붙였다.\n  “이 노엘라가 다들 떠벌리고 다니는 바람에 혼담도 안 들어와.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4655,
  "addr": "0x029DCC",
  "jh": "00ce81e469fd",
  "eh": "1747db5d8edd",
  "ko": "  길의 눈이 기쁨으로 빛나 갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4656,
  "addr": "0x029DE0",
  "jh": "210336833fc5",
  "eh": "2e46dfee32e0",
  "ko": "  하지만 옆에서 얌전히 있던 키드는 이제 한계인 모양이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4657,
  "addr": "0x029DFD",
  "jh": "70c00880cdc4",
  "eh": "ed70c95f9ca2",
  "ko": "  눈을 부릅뜨더니 마침내 폭발한 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4658,
  "addr": "0x029E21",
  "jh": "e5e01b26cf54",
  "eh": "1eb6b381a07b",
  "ko": "  시녀가 날카로운 눈으로 나를 노려보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4659,
  "addr": "0x029E39",
  "jh": "a6e3a80945ab",
  "eh": "6af2d38aa35f",
  "ko": "  “어머, 당신들은...”\n  미심쩍은 듯 나와 키드를 보고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4660,
  "addr": "0x029E5B",
  "jh": "f671197153d5",
  "eh": "c70309341098",
  "ko": "  “어, 아, 수상한 사람이 아닙니다!”\n  작은 시녀의 눈에 쏘아보여 나는 말을 더듬었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4661,
  "addr": "0x029E96",
  "jh": "b279d02741b4",
  "eh": "d5685699708d",
  "ko": "  “겨, 결코 도적 같은 게 아니라...”\n  내 입이 또 바보 같은 소리를 해 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4662,
  "addr": "0x029EC8",
  "jh": "049d6d000229",
  "eh": "3c65720dc2f5",
  "ko": "  키드의 차가운 시선...\n  “바보.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4663,
  "addr": "0x029EE0",
  "jh": "3c24b4e99b37",
  "eh": "2a3585c39c40",
  "ko": "  풀이 죽은 나를 곁눈질하며 키드는 후 하고 숨을 내쉬었다.\n  “어쩔 수 없지, 얼른 결판을 내자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4664,
  "addr": "0x029F1D",
  "jh": "cda6b5eaeb28",
  "eh": "dc109cc23d7b",
  "ko": "  “할망구, 잘 들어! 나는 도적 키드, 오늘 밤 이 저택의...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4665,
  "addr": "0x029F48",
  "jh": "8fc7dd08fa57",
  "eh": "5d9f1c27ef47",
  "ko": "  키드의 기세 좋은 대사는 시녀의 용맹한 호통에 가로막혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4666,
  "addr": "0x029F73",
  "jh": "73112194d139",
  "eh": "3707a8298f39",
  "ko": "  “아가씨를 노리다니 괘씸하구나! 내가 혼쭐을 내 주마!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4667,
  "addr": "0x029F9B",
  "jh": "2684bfd7b52f",
  "eh": "b474ec40693d",
  "ko": "  “뭘 착각하는 거야! 난 이런 못난이한테 볼일 없어!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4668,
  "addr": "0x029FC1",
  "jh": "53e2f1c18a46",
  "eh": "7fc7010419a0",
  "ko": "  노려보는 두 사람 사이를 길이 중재했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4669,
  "addr": "0x029FD9",
  "jh": "e9b897f1c40a",
  "eh": "7041d237fea7",
  "ko": "  길은 시녀에게 말했다.\n  “괜찮습니다. 리델은 제가 지키겠습니다.”\n  “길버트 도련님...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4670,
  "addr": "0x02A00E",
  "jh": "32d5467ac940",
  "eh": "8fe8455ad7b1",
  "ko": "  이어서 길은 키드에게 말했다.\n  “오늘은 일단 물러나자.”\n  “하아?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4671,
  "addr": "0x02A03C",
  "jh": "d12683a41e3b",
  "eh": "5454a8e43ed1",
  "ko": "  키드와 시녀가 서로 얼굴을 마주 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4672,
  "addr": "0x02A053",
  "jh": "95158925df6a",
  "eh": "3dde1afba24d",
  "ko": "  두 사람의 머릿속에 동시에 한 가지 생각이 떠올랐다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4673,
  "addr": "0x02A075",
  "jh": "06259fc696aa",
  "eh": "ef982ecd62f4",
  "ko": "  “설마, 리델을 데려가겠다는 거야!”\n  “설마, 아가씨와 사랑의 도피를 할 생각이세요!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4674,
  "addr": "0x02A0A7",
  "jh": "835f30a5c99c",
  "eh": "3a0757f97472",
  "ko": "  길은 멍하니 입을 벌렸다.\n  “아니, 나는 그럴 생각은...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4675,
  "addr": "0x02A0CA",
  "jh": "3b1d7bbfed78",
  "eh": "5d1b12c776e2",
  "ko": "  하지만 이어지는 두 사람의 파워풀한 외침에 그 목소리는 허무하게 묻혀 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4676,
  "addr": "0x02A0F8",
  "jh": "3b9791a0faaa",
  "eh": "527092c59387",
  "ko": "  “사랑의 도피! 어쩜 이리 로맨틱할까! 당장 모두에게 알려야지!”\n  시녀는 덩실덩실 춤을 추며 나가 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4677,
  "addr": "0x02A143",
  "jh": "1f8f72058288",
  "eh": "00f7e31e3ab0",
  "ko": "  “너 이 자식~, 얼어붙은 불꽃은 어쩔 건데!”\n  키드는 노발대발하며 길의 멱살을 잡았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4678,
  "addr": "0x02A172",
  "jh": "ce864f9556c7",
  "eh": "83f041bef83f",
  "ko": "  리델 본인도 조금도 기쁘지 않은 듯 버럭 화를 내기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4679,
  "addr": "0x02A197",
  "jh": "2eabd8d28225",
  "eh": "0e27b79623aa",
  "ko": "  그야 그렇겠지. 옛날에 약속했다고 해서 그렇게 쉽게 결단할 수 있을 리가 없다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4680,
  "addr": "0x02A1C2",
  "jh": "fecc0066f6b9",
  "eh": "6d3bdfaa56d8",
  "ko": "  아가씨라면 좋은 생활을 버릴 마음도 들지 않겠지.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4681,
  "addr": "0x02A1E5",
  "jh": "0370f107ffee",
  "eh": "c012623212e3",
  "ko": "  허둥대는 리델을 보며 생각했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4682,
  "addr": "0x02A200",
  "jh": "767c28cba4a3",
  "eh": "8dae9f8dcf62",
  "ko": "  • 역시 도둑이 싫은 거겠지.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4683,
  "addr": "0x02A21C",
  "jh": "dbcf15594593",
  "eh": "d1843424469c",
  "ko": "  • 갑자기 집을 나가는 건 못 하겠지.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4684,
  "addr": "0x02A238",
  "jh": "ae5600c26f13",
  "eh": "1b3378783e1f",
  "ko": "  “도둑의 신부가 되는 건 싫어요! 남의 물건을 훔치는 건 부끄러운 일이에요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4685,
  "addr": "0x02A268",
  "jh": "ceb9d2a87575",
  "eh": "040ce1695f64",
  "ko": "  “뭐라고! 이, 못난이가!”\n  키드가 고함쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4686,
  "addr": "0x02A287",
  "jh": "b95fea35a4c1",
  "eh": "60070c280dc6",
  "ko": "  “도적도 어엿한 직업이야! 그치, 길?”\n  맞장구를 바라며 키드가 불렀다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4687,
  "addr": "0x02A2BC",
  "jh": "b13b19eb572d",
  "eh": "8bbfd7293318",
  "ko": "  “리델이 싫다면 나는 도둑을 그만두겠다. 성실하게 일하겠어! 그러니 함께...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4688,
  "addr": "0x02A2EA",
  "jh": "50e40c9a7205",
  "eh": "4ab9ca8d4ec1",
  "ko": "  “...기, 길??”\n  길의 말에 우리는 당황했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4689,
  "addr": "0x02A310",
  "jh": "60e0222105f0",
  "eh": "9c2fd52b39bb",
  "ko": "  “나, 집을 나갈 생각 없어요!”\n  리델은 엄한 말투로 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4690,
  "addr": "0x02A33A",
  "jh": "14dd71f6d52b",
  "eh": "22cca568ea3c",
  "ko": "  “가난하게 살라는 거예요? 아버님도 허락하실 리가 없어요!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4691,
  "addr": "0x02A369",
  "jh": "e6f0eb8cc2de",
  "eh": "785f52e7dec8",
  "ko": "  “걱정 마라! 결혼 자금과 신혼집 계약금은 제대로 저축해 두었다. 신혼여행 경비는 축의금에서 마련하자!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4692,
  "addr": "0x02A3BB",
  "jh": "963d00c22723",
  "eh": "023cecdd9ad3",
  "ko": "  축의금이라고 말하는 대목에서 길은 나와 키드를 돌아보았다.\n  “기대하고 있겠다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4693,
  "addr": "0x02A3F4",
  "jh": "6450df4d7672",
  "eh": "81c9af2e3a4c",
  "ko": "  길의 결심은 굳다. 하지만 여기서 구애할 필요는 없다고 생각하는데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4694,
  "addr": "0x02A41E",
  "jh": "b871fd7e4590",
  "eh": "0751b80b55c2",
  "ko": "  그때, 저택 전체에 경보가 울려 퍼졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4695,
  "addr": "0x02A43B",
  "jh": "ad9c1f2783e9",
  "eh": "1102e47c49d6",
  "ko": "  “아까 그 할망구다!”\n  키드가 혀를 찼다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4696,
  "addr": "0x02A45C",
  "jh": "232661ec9a29",
  "eh": "e2096af6b97d",
  "ko": "  어떡하지? 허둥대는 나에게 길이 말했다.\n  “역시 물러나자.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4697,
  "addr": "0x02A486",
  "jh": "7300c005fccf",
  "eh": "4a289a53289a",
  "ko": "  리델이 안도한 표정을 지었다.\n  “그래요. 오늘 밤은 돌아가는 게 좋겠어요.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4698,
  "addr": "0x02A4B0",
  "jh": "200efae341e1",
  "eh": "f514e3d66562",
  "ko": "  다음에 올 때는 낮에, 도둑이 아니라 친구로서 와 주세요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4699,
  "addr": "0x02A4E1",
  "jh": "000abeb259cc",
  "eh": "d9570f230c03",
  "ko": "  “친구, 친구, 친구...\n  친구, 친구, {친구...}”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4700,
  "addr": "0x02A518",
  "jh": "5aa47e1b34ca",
  "eh": "f238e63c2596",
  "ko": "  길이 친구라는 말에 낮게 신음했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4701,
  "addr": "0x02A535",
  "jh": "784529740556",
  "eh": "48abf7390dcf",
  "ko": "  하지만 곧 다시 일어서며 격하게 내뱉었다.\n  “아니, 나는 포기하지 않는다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4702,
  "addr": "0x02A561",
  "jh": "9ab25792c28c",
  "eh": "3d6794077250",
  "ko": "  복도를 우당탕 뛰어다니는 소리가 났다.\n  “서두르자!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4703,
  "addr": "0x02A588",
  "jh": "4425aa955e57",
  "eh": "753b98a7f8d4",
  "ko": "  키드가 탈출을 재촉하자, 길이 가뿐하게 리델을 들쳐 멨다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4704,
  "addr": "0x02A5AA",
  "jh": "a28755fe16ff",
  "eh": "96fea3187b53",
  "ko": "  “데려가겠다!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4705,
  "addr": "0x02A5B7",
  "jh": "f4468a33d955",
  "eh": "8874388dc4f9",
  "ko": "  “거짓말, 진짜냐, 길!”\n  얼어붙은 듯 서 버린 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4706,
  "addr": "0x02A5D5",
  "jh": "2ee942839d69",
  "eh": "a1e555cf6ddd",
  "ko": "  “꺄악, 내려 줘요, 길!”\n  버둥거리는 리델.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4707,
  "addr": "0x02A5F3",
  "jh": "67bbca8a5536",
  "eh": "b07c9ea26d28",
  "ko": "  “뭐 하는 거냐! 서두르자!”\n  늠름하게 망토를 휘날리며 길이 달려 나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4708,
  "addr": "0x02A622",
  "jh": "39f0a09a1bad",
  "eh": "fce9c923a0ce",
  "ko": "  “어머나~”\n  리델의 비명이 길게 꼬리를 끌었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4709,
  "addr": "0x02A640",
  "jh": "3f9b728a7f52",
  "eh": "f2f0e4dd2ea8",
  "ko": "  “어, 어떡해? 키드?”\n  “큭, 젠장, 철수다! 다시 온다!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4710,
  "addr": "0x02A682",
  "jh": "42c93d34b194",
  "eh": "68899c151e83",
  "ko": "  우리는 전속력으로 달렸다!!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4711,
  "addr": "0x02A69A",
  "jh": "79e01a382144",
  "eh": "65b31a9c2ad7",
  "ko": "  가는 곳마다 호위 몬스터와 마주쳤지만, 날려 버리고 걷어차 흩어 버리며 질풍처럼 돌진하는 길.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4712,
  "addr": "0x02A6E4",
  "jh": "220c48cad330",
  "eh": "844d3627aee2",
  "ko": "  간신히 야마네코의 성을 빠져나왔다. 이제 온몸이 녹초다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4713,
  "addr": "0x02A720",
  "jh": "c6dedb5e4cc7",
  "eh": "92603ad70817",
  "ko": "  고요한 숲에 거친 숨소리만이 울렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4714,
  "addr": "0x02A73A",
  "jh": "b473295a7fb4",
  "eh": "5a38798eeb50",
  "ko": "  갑자기 등 뒤에서 커다란 소리가 났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4715,
  "addr": "0x02A77F",
  "jh": "532679333098",
  "eh": "e2e2bb8ff0ed",
  "ko": "  올려다보니 밤하늘에 불꽃이 터지고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4716,
  "addr": "0x02A79A",
  "jh": "c7c52d221977",
  "eh": "8c2311b9ffbc",
  "ko": "  멍하니 올려다보고 있는데, 옆에서 목소리가 났다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4717,
  "addr": "0x02A7B4",
  "jh": "52e008e425b0",
  "eh": "65be92d47350",
  "ko": "  “뭐야? 저건?”\n  키드가 뭔가를 보고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4718,
  "addr": "0x02A7CF",
  "jh": "3364862a3745",
  "eh": "214182658e16",
  "ko": "  성 안의 사람들이 발코니에, 창가에 주렁주렁 매달려 손을 흔들고 있는 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4719,
  "addr": "0x02A801",
  "jh": "75f8319db488",
  "eh": "49cfae5d46e5",
  "ko": "  서늘한 바람을 타고 만세 삼창이 들려왔다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4720,
  "addr": "0x02A824",
  "jh": "37f67512e5e5",
  "eh": "34a86602932e",
  "ko": "  “리델 아가씨, 축하드립니다!”\n  “행복하세요!”\n  “스위트 홈이 생기면 다 같이 놀러 갈게요!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4721,
  "addr": "0x02A870",
  "jh": "4517353295db",
  "eh": "8943d5c1cfb8",
  "ko": "  키드가 얼굴을 굳히며 지붕 위를 가리켰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4722,
  "addr": "0x02A888",
  "jh": "f9b46e6bdf05",
  "eh": "cafabfad1df6",
  "ko": "  그곳에는 눈물을 참으며 미소 짓는 야마네코 대군의 모습이...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4723,
  "addr": "0x02A8AD",
  "jh": "39386b112ec2",
  "eh": "fbe69afc6644",
  "ko": "  “와, 완전히 신부 아버지가 됐어...”\n  나와 길의 얼굴도 굳었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4724,
  "addr": "0x02A8D8",
  "jh": "b841dd9115be",
  "eh": "a760477e9f66",
  "ko": "  내내 울고 있던 리델이 살며시 고개를 들었다.\n  “이런 소동이 되어 버리다니...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4725,
  "addr": "0x02A90B",
  "jh": "79101e34edc7",
  "eh": "9bf6f5a08f8a",
  "ko": "  “미안하다, 리델. 내가 너무 억지를 부렸다.”\n  손수건으로 리델의 뺨을 닦으며 길이 순순히 고개를 숙였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4726,
  "addr": "0x02A94D",
  "jh": "bc286d6c38ec",
  "eh": "981a01e81054",
  "ko": "  “길... 여전하다니까...”\n  리델이 쿡 웃었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4727,
  "addr": "0x02A972",
  "jh": "d4f6f841b40c",
  "eh": "23fdaf65afff",
  "ko": "  먼 하늘이 하얗게 밝아 오기 시작했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4728,
  "addr": "0x02A985",
  "jh": "4ffb71be0ff7",
  "eh": "6f00be49059a",
  "ko": "  “어느새 날이 새 버렸네.”\n  키드가 한숨을 쉬었다.\n  “아~아, 얼어붙은 불꽃이!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4729,
  "addr": "0x02A9B9",
  "jh": "cb65cc982ee6",
  "eh": "5e3e9ca4a996",
  "ko": "  길이 그 아침 해를 가리켰다.\n  “보아라, 리델... 우리 둘의 새벽이다...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4730,
  "addr": "0x02A9F4",
  "jh": "fae67031c9be",
  "eh": "fd332627c143",
  "ko": "{사랑과 용기의 길, 사랑의 도피 편}\n완결\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4731,
  "addr": "0x02AA2B",
  "jh": "38e83ac3df76",
  "eh": "5bc07ae78f6b",
  "ko": "  아늑해 보이는 깔끔한 방이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4732,
  "addr": "0x02AA46",
  "jh": "f30678c8cbb9",
  "eh": "755995d02a15",
  "ko": "  책상이나 선반 위의 소품들에서는 쓰임새보다 귀여움이 느껴졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4733,
  "addr": "0x02AA6F",
  "jh": "a95da61bbad8",
  "eh": "666b2c05477c",
  "ko": "  호화로운 책상과 푹신푹신한 침대가 우아한 생활을 연상시켰다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4734,
  "addr": "0x02AA9D",
  "jh": "3effc4163015",
  "eh": "7ab93c1c502b",
  "ko": "  많은 물건으로 가득한데도, 방 안은 쥐 죽은 듯 고요하고 쓸쓸해 보였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4735,
  "addr": "0x02AACD",
  "jh": "5a43aad4a112",
  "eh": "0e4417deb6bc",
  "ko": "  키드가 그 물건들을 재빨리 살피더니 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4736,
  "addr": "0x02AAEB",
  "jh": "6915b904873a",
  "eh": "45abca2319c5",
  "ko": "  “야마네코 딸의 방이네.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4737,
  "addr": "0x02AB22",
  "jh": "90166c6956df",
  "eh": "547c9a78c198",
  "ko": "  책상 위의 쓰다 만 편지와 아직 따뜻한 찻잔이 이 방 여주인의 분위기를 전해 주고 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4738,
  "addr": "0x02AB66",
  "jh": "49bb8cc0d6d4",
  "eh": "4357d5fccfbf",
  "ko": "  지금은 아무도 없는 모양이다. 우리는 방 안을 조사하기로 했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4739,
  "addr": "0x02AB8B",
  "jh": "dacaacbba9fd",
  "eh": "fcfe32f0522e",
  "ko": "  장식된 아름다운 꽃들, 깜빡 두고 간 흰 삼베 손수건, 작은 향수병.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4740,
  "addr": "0x02ABC6",
  "jh": "d28a52889e22",
  "eh": "424c69c741e2",
  "ko": "  어느 것도 나에게는 낯선 것들이었고, 그다지 중요한 물건 같지도 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4741,
  "addr": "0x02ABF1",
  "jh": "c45c1a07c441",
  "eh": "fdaa18351fc7",
  "ko": "  키드도 같은 생각인지, 그리 진지하게 조사하지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 4742,
  "addr": "0x02AC10",
