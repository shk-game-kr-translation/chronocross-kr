[
 {
  "i": 3750,
  "addr": "0x021396",
  "jh": "407d885da0d9",
  "eh": "a4648db21b35",
  "ko": "  역시 길. 실력도 좋고 지식도 풍부하지만, 그 지식을 떠올리는 데 고대 공룡만큼 시간이 걸리는 건 어떻게 좀...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3751,
  "addr": "0x0213DC",
  "jh": "843ecf7f8200",
  "eh": "7f05370b38db",
  "ko": "  덕분에 몇 번이나 위험에 처했던가...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3752,
  "addr": "0x021412",
  "jh": "751df012a69d",
  "eh": "1e1a8be1ab67",
  "ko": "  “봉쥬~르, 아가씨~”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3753,
  "addr": "0x021437",
  "jh": "7afeb9508321",
  "eh": "b5ed83efa9ef",
  "ko": "  해바라기가 키드를 향해 입을 열었다.\n  생긴 것도 섬뜩하지만, 말투도 징그럽다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3754,
  "addr": "0x02146C",
  "jh": "d13eee27567f",
  "eh": "6634c8350dd3",
  "ko": "  아... 등골이 서늘해...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3755,
  "addr": "0x02147E",
  "jh": "6e81ddc790c6",
  "eh": "84d852748301",
  "ko": "  “누가! 아가씨야! 이! 변태 해바라기!!!”\n  물어뜯을 듯 내뱉는 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3756,
  "addr": "0x0214BD",
  "jh": "3ea45ebe35e6",
  "eh": "f1d3dfdb46a4",
  "ko": "  “오, 쏘~리, 차일드 거~얼. 그 쁘~띠 바스트를 보고 그만.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3757,
  "addr": "0x021502",
  "jh": "454a33af843e",
  "eh": "72469800553e",
  "ko": "  “뭐야, 너! 내 가슴이 없다고 말하고 싶은 거야!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3758,
  "addr": "0x021528",
  "jh": "190029d391b8",
  "eh": "bfafe8685f86",
  "ko": "  “오~ 예~스.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3759,
  "addr": "0x02153E",
  "jh": "46431259a901",
  "eh": "9c7a8c5ab62e",
  "ko": "  장난스러운 대답을 돌려주는 해바라기.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3760,
  "addr": "0x021551",
  "jh": "23be5d4929b4",
  "eh": "bba288dfd2b4",
  "ko": "  키드의 두 어깨가 잘게 떨리더니, 허리에 찬 단검이 번뜩였다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3761,
  "addr": "0x021579",
  "jh": "f662c88146b2",
  "eh": "90bb814fe14a",
  "ko": "  “해바라기 주제에 인간님을 모욕한 죄... 죽음으로 갚아라...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3762,
  "addr": "0x0215A6",
  "jh": "12c6e5f0d5f4",
  "eh": "d90030beec18",
  "ko": "  이 변태 해바라기 자식!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3763,
  "addr": "0x0215B8",
  "jh": "bf34a1a4c951",
  "eh": "ffe2446c8373",
  "ko": "  해바라기를 상대로 그렇게 열 낼 것까지는 없는데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3764,
  "addr": "0x0215D7",
  "jh": "79d2c0f82f0b",
  "eh": "9416af8b8933",
  "ko": "  그런 내 생각과는 상관없이, 머리 위로 치켜든 단검이 휘둘러졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3765,
  "addr": "0x02160C",
  "jh": "c93dbdb60de5",
  "eh": "dbd05466353e",
  "ko": "  “우갸아아아아아아아아악!!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3766,
  "addr": "0x02162C",
  "jh": "ce34537c250b",
  "eh": "bf24a464dcac",
  "ko": "  목소리라기보다는 고양이 백 마리가 한꺼번에 유리를 긁는 듯한 끔찍한 소리가 내 귀를 덮쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3767,
  "addr": "0x021666",
  "jh": "52b02ddb2afc",
  "eh": "45f005cab51c",
  "ko": "  다음 찰나, 두 다리를 지탱하던 힘이 풀리며 머리가 한순간 핑 돌았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3768,
  "addr": "0x0216A0",
  "jh": "f52763cb4ce2",
  "eh": "e1070779c339",
  "ko": "  “오~ 마이 갓! 쁘~띠 바스트 거~얼. 포~옥력은 안 되~요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3769,
  "addr": "0x0216EA",
  "jh": "bc40aa6b66b9",
  "eh": "1a4cf456a8d2",
  "ko": "  어, 키드는 분명히 꽃을 베어 떨어뜨렸고, 그 꽃도 저기 굴러다니는데... 벌써 새 꽃이 돋아나 떠들고 있다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3770,
  "addr": "0x021733",
  "jh": "bdf2dcb4c491",
  "eh": "e08c8c7aba1a",
  "ko": "  “쯧쯧쯧, 그래서는...”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3771,
  "addr": "0x021755",
  "jh": "00da16326388",
  "eh": "d78cdbd1beea",
  "ko": "  “우갸아아아아아아아아악!!!!”\n  키드의 검이 번뜩. 또 그 비명이 귀를 덮치며 힘이 빠져나갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3772,
  "addr": "0x0217A4",
  "jh": "77a69a63ee74",
  "eh": "db95253a38b1",
  "ko": "  “멋진 상대는 못 찾아요~~~~”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3773,
  "addr": "0x0217E3",
  "jh": "4492015fa951",
  "eh": "3d784405f529",
  "ko": "  지조 없이 계속 돋아나는 해바라기를 베어 버리는 키드.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3774,
  "addr": "0x021808",
  "jh": "e7f3e27b024c",
  "eh": "5fca56ff3dd1",
  "ko": "  {그만해, 키드! 힘이~ 힘이... 빠져나가...}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3775,
  "addr": "0x02182C",
  "jh": "e750578f71c0",
  "eh": "dfb2b8e6d370",
  "ko": "  • 몸을 돌보지 않고 키드를 말린다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3776,
  "addr": "0x021840",
  "jh": "973e3d7eb90f",
  "eh": "5a0f1b2dde69",
  "ko": "  • 길에게 키드를 말려 달라고 부탁한다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3777,
  "addr": "0x021858",
  "jh": "c93dbdb60de5",
  "eh": "dbd05466353e",
  "ko": "  “우갸아아아아아아아아악!!!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3778,
  "addr": "0x021877",
  "jh": "dd639ea654a9",
  "eh": "2b2cdabe0b05",
  "ko": "  “그만해! 키드!”\n  키드를 끌어안고 호소했지만, 지금의 키드에게는 내 목소리가 들리지 않는 듯 허무하게 튕겨 나가고 말았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3779,
  "addr": "0x0218B9",
  "jh": "c8545c9801e2",
  "eh": "653ccebcba64",
  "ko": "  아아, 한심해...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3780,
  "addr": "0x0218CD",
  "jh": "e3b3b05da13f",
  "eh": "a1a178e7b483",
  "ko": "  • 다시 한 번 몸을 돌보지 않고 키드를 말린다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3781,
  "addr": "0x0218E7",
  "jh": "973e3d7eb90f",
  "eh": "5a0f1b2dde69",
  "ko": "  • 길에게 키드를 말려 달라고 부탁한다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3782,
  "addr": "0x0218F8",
  "jh": "9a70c62e333d",
  "eh": "5cb60168ace0",
  "ko": "  한심한 얘기지만, 남자인 나보다 키드가 더 세다. 여기선 길에게 부탁할 수밖에 없다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3783,
  "addr": "0x021923",
  "jh": "fdaddc68360b",
  "eh": "13e5c7b9410b",
  "ko": "  말을 걸려고 길 쪽을 돌아보니, 팔짱을 낀 채 동상처럼 땅에 서 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3784,
  "addr": "0x021954",
  "jh": "f3276f3b2d82",
  "eh": "2dc18b833ccc",
  "ko": "  아까부터 이어지는 해바라기의 비명에도 굴하지 않는 늠름한 모습이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3785,
  "addr": "0x021976",
  "jh": "aa33a7a5bfde",
  "eh": "fec298be1aa3",
  "ko": "  아니, 아마 안 들리는 거다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3786,
  "addr": "0x02198A",
  "jh": "992a6ec7e213",
  "eh": "aabb8f03776e",
  "ko": "  그 가면은 해바라기와 키드 쪽을 향하고 있지만, 그 아래의 두 눈은 아무것도 보고 있지 않을 것이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3787,
  "addr": "0x0219BD",
  "jh": "26a6dde00837",
  "eh": "ffe01b501ddd",
  "ko": "  모든 것이 지금 머릿속 생각으로 향해 있는 거다... 분명...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3788,
  "addr": "0x0219E6",
  "jh": "4bb5087774a4",
  "eh": "ce26196befa0",
  "ko": "  “키드!!!”\n  결과는 같았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3789,
  "addr": "0x021A01",
  "jh": "28a8692492a8",
  "eh": "e82fac445b85",
  "ko": "  아까보다 요란하게 날아갔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3790,
  "addr": "0x021A23",
  "jh": "50f63f460616",
  "eh": "a8358101ba78",
  "ko": "  “쁘~띠 바스트 거~얼. 바보처럼 검을 휘둘러도 소용없어~요.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3791,
  "addr": "0x021A5E",
  "jh": "405c94a345c6",
  "eh": "8e9d776686cc",
  "ko": "  두 어깨를 거칠게 들썩이는 키드.\n  오른손에 쥔 단검을 내던졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3792,
  "addr": "0x021A8D",
  "jh": "2a3b845f9b1c",
  "eh": "f159b085de9e",
  "ko": "  “생각났다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3793,
  "addr": "0x021A9C",
  "jh": "7d23919d5bcb",
  "eh": "0cecb8f3707c",
  "ko": "  그 녀석은 맨드라 몬스터다! 베거나, 절대로 뽑으려 하지 마라!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3794,
  "addr": "0x021AC8",
  "jh": "cc187ce01810",
  "eh": "5469a0dae09d",
  "ko": "  이제야 생각났구나, 길...\n  하지만 이미 늦었어...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3795,
  "addr": "0x021AEC",
  "jh": "3994982e0a3b",
  "eh": "bef8121232db",
  "ko": "  “으랴아아아아!!!”\n  포효를 지르며 키드의 두 손이 해바라기 줄기를 단단히 움켜쥐었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3796,
  "addr": "0x021B21",
  "jh": "cc2321992827",
  "eh": "ba49e384beae",
  "ko": "  해바라기가 입꼬리로 엷게 웃었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3797,
  "addr": "0x021B4C",
  "jh": "22158aa69ae0",
  "eh": "fde22a81007c",
  "ko": "  해바라기를 중심으로 사방의 땅이 찢어지며 무너져 내렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3798,
  "addr": "0x021B75",
  "jh": "a3018530ff53",
  "eh": "7d4c5daf6225",
  "ko": "  “키드!!!”\n  주위의 나무들이 쓰러지고, 솟구친 흙이 순식간에 키드를 삼켜 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3799,
  "addr": "0x021BAC",
  "jh": "24be80a77135",
  "eh": "0a47e0c28c0c",
  "ko": "  엄청난 흙더미와 밀려난 나무들이 내 시야를 뒤덮었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3800,
  "addr": "0x021BD5",
  "jh": "3e95ce6b902b",
  "eh": "ad8f7e611aad",
  "ko": "  간발의 차이로 힘센 팔에 끌어당겨져, 나는 그 자리를 빠져나왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3801,
  "addr": "0x021BFE",
  "jh": "63c4aba9e85f",
  "eh": "84a9ec71e8d6",
  "ko": "  “길...”\n  나를 옆구리에 끼고 도약했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3802,
  "addr": "0x021C1A",
  "jh": "13d9fd239d67",
  "eh": "3c066cff8dc3",
  "ko": "  “멍하니 있지 마라! 당장 도망쳐!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3803,
  "addr": "0x021C32",
  "jh": "4aed1ea65045",
  "eh": "b55b4698d08c",
  "ko": "  “하지만! 키드가!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3804,
  "addr": "0x021C3E",
  "jh": "2aca5d726fb8",
  "eh": "2102e4386b47",
  "ko": "  “알고 있다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3805,
  "addr": "0x021C4D",
  "jh": "9f76ddbf274c",
  "eh": "252bfad7f49d",
  "ko": "  크게 돔 모양으로 퍼진 흙먼지의 가장자리에 내려서는 길.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3806,
  "addr": "0x021C77",
  "jh": "aa305f5a8b89",
  "eh": "bf3477a06e24",
  "ko": "  • 흙먼지 속으로 뛰어든다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3807,
  "addr": "0x021C8D",
  "jh": "bb2912ff45c6",
  "eh": "d572d89e1750",
  "ko": "  • 그 자리에서 키드의 이름을 외친다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3808,
  "addr": "0x021CA2",
  "jh": "3ab056639500",
  "eh": "d59538eec8ab",
  "ko": "  길의 손에서 풀려나자마자 나는 흙먼지 속으로 뛰어들려 했지만, 길의 큰 손에 어깨를 붙잡혀 저지당했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3809,
  "addr": "0x021CE3",
  "jh": "b1d178ed2f64",
  "eh": "de563dbac68f",
  "ko": "  “서두르지 마라. 키드는커녕 아무것도 안 보일 거다. 가라앉을 때까지 기다려.”\n  확실히 길의 말대로다. 이런 흙먼지 속에서는 아무것도 안 보이고, 이런 마음으로는 안 돼! 냉정함을 유지해야 해.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3810,
  "addr": "0x021D4E",
  "jh": "4de5194b429c",
  "eh": "ec1923c1e89c",
  "ko": "  “키드! 키드! 키드!”\n  나는 흙먼지를 향해 몇 번이고 외쳤다.\n  한시라도 빨리 키드에게 가고 싶지만, 이렇게 흙먼지가 자욱해서는 아무것도 안 보인다. 오히려 내 쪽이 위험하다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3811,
  "addr": "0x021DB3",
  "jh": "96779e54010e",
  "eh": "b8709b6696f5",
  "ko": "  초조한 마음을 억누르며 흙먼지가 가라앉기를 기다렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3812,
  "addr": "0x021DE7",
  "jh": "3f95d52b477c",
  "eh": "42c981c2ecbf",
  "ko": "  “어, 뭐지...”\n  흙먼지가 걷혀 가는 가운데, 하나의 거대한 실루엣이 있었다.\n  하지만 이렇게 커다란 건 여기 없었을 텐데...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3813,
  "addr": "0x021E37",
  "jh": "32ecd8f29c5e",
  "eh": "729d9700e69e",
  "ko": "  그림자가 점차 달빛을 받으며 뚜렷한 모습이 되어 갔다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3814,
  "addr": "0x021E77",
  "jh": "a4b4f6038497",
  "eh": "5a2b044a068e",
  "ko": "  “...키드!!!”\n  나는 키드의 모습을 발견하고 외쳤다!\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3815,
  "addr": "0x021E96",
  "jh": "12241fb01043",
  "eh": "88e102bcd845",
  "ko": "  그림자는 내 키의 일고여덟 배는 될 듯한 거대한 괴물이었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3816,
  "addr": "0x021EC0",
  "jh": "8d6e292ecb7b",
  "eh": "3f31d18e8615",
  "ko": "  고릴라를 떠올리게 하는 거대한 몸. 온통 드러난 근육을 식물 덩굴이 뒤덮고, 손발가락은 갑각류의 날카로운 집게를 연상시켰다.\n  그리고 해바라기를 본뜬 금빛 목도리.\n  하지만 그곳에 목은 없고, 그 대신...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3817,
  "addr": "0x021F3E",
  "jh": "d3a158de12eb",
  "eh": "b756b6f3c91d",
  "ko": "  “어이, 코피 사내.”\n  어, 한순간 그게 나라는 걸 깨닫지 못했다.\n  집게손가락으로 코밑을 문질러 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3818,
  "addr": "0x021F81",
  "jh": "cf3315c0634e",
  "eh": "beb9b89a60d3",
  "ko": "  “아, 피다...”\n  그래! 그곳에 괴물의 머리는 없고, 키드의 상반신이...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3819,
  "addr": "0x021FB7",
  "jh": "3e682f7560ce",
  "eh": "b0c2fe54039e",
  "ko": "  아니, 그건 평소의 키드 모습이 아니라...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3820,
  "addr": "0x021FD2",
  "jh": "8a1d3f1dcb35",
  "eh": "7c375a195cc9",
  "ko": "  “빨리 구하지 않으면, 자신의 분노의 감정 때문에 키드는 죽는다.”\n  불쑥 길이 말했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3821,
  "addr": "0x022004",
  "jh": "00f9b08b955a",
  "eh": "bb4e1c189919",
  "ko": "  {키드가 죽는다!!!}\n  그 말에 심장이 조여 왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3822,
  "addr": "0x022029",
  "jh": "f491fb5b0867",
  "eh": "c6b490fab663",
  "ko": "  • 키드를 본다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3823,
  "addr": "0x022036",
  "jh": "7d432df027c8",
  "eh": "3b46ca45f536",
  "ko": "  • 구할 방법을 길에게 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3824,
  "addr": "0x02204A",
  "jh": "c81c2cd95981",
  "eh": "b3ed1e09be74",
  "ko": "  그녀의 얼굴에는 표정이 없고, 희미하게 보이는 두 눈동자가 공허하게 흔들렸다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3825,
  "addr": "0x022075",
  "jh": "27f2342cfbf1",
  "eh": "867c7522fe19",
  "ko": "  피부는 변색되어 풀 같은 초록색이다.\n  그 가슴에 해바라기가 피어 있다.\n  하반신은 괴물의 목도리 속에 쏙 파묻혀 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3826,
  "addr": "0x0220E7",
  "jh": "e98965e06ac3",
  "eh": "9e1fd4cff63c",
  "ko": "  아, 이럴 때 또 코피가...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3827,
  "addr": "0x022102",
  "jh": "85fd5f4b6918",
  "eh": "feb635d03190",
  "ko": "  • 다시 한 번 키드를 본다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3828,
  "addr": "0x022113",
  "jh": "7d432df027c8",
  "eh": "7e29ea8aae1a",
  "ko": "  • 구할 방법을 길에게 묻는다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3829,
  "addr": "0x022127",
  "jh": "bba933f519c9",
  "eh": "4400427687d8",
  "ko": "  “어떡해! 어떡하면! 키드를 구할 수 있어!!”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3830,
  "addr": "0x022147",
  "jh": "c8a14c53361e",
  "eh": "a3fec50d8e96",
  "ko": "  키드의 죽음... 의식하면 할수록 초조해졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3831,
  "addr": "0x022168",
  "jh": "8aed643c401f",
  "eh": "7889a0705e8e",
  "ko": "  “진정해라, 코피 사내. 방법은 있다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3832,
  "addr": "0x022185",
  "jh": "0816f8d33322",
  "eh": "ec854b7c0f7f",
  "ko": "  지금 키드는 '분노'의 감정에 지배되어 괴물과 이어져 있다.\n  그 분노의 감정을 키드에게서 없애지 않는 한, 구할 수 없다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3833,
  "addr": "0x0221DA",
  "jh": "103dfeaf72ab",
  "eh": "b32538f440f1",
  "ko": "  “그 방법은!? 어떻게 하는데!?”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3834,
  "addr": "0x0221F2",
  "jh": "703ed4e460fc",
  "eh": "ad9289f5a3b4",
  "ko": "  “그건,",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3835,
  "addr": "0x0221F9",
  "jh": "9399a2069ddd",
  "eh": "8dd700842adc",
  "ko": " '사랑'이다.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3836,
  "addr": "0x022203",
  "jh": "aa4e75e8a97c",
  "eh": "4082b92b4835",
  "ko": "  “사랑...”\n  “그래, 사랑이다. 그게 유일한 방법이다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3837,
  "addr": "0x022226",
  "jh": "a3307727ddb2",
  "eh": "b007ab88b969",
  "ko": "  나는 준비에 들어가겠다.\n  그동안 키드의 몸을 지키며 사랑을 보여 줘라. 그리고 마법을 너무 많이 쓰게 하지 마라.”\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3838,
  "addr": "0x022262",
  "jh": "dc88147e1ae7",
  "eh": "251172562571",
  "ko": "  “어, 키드는 마법을 못 쓰는데.”\n  나는 바로 그 사실을 떠올리고 물어보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3839,
  "addr": "0x022294",
  "jh": "a5e035f68ff6",
  "eh": "0a4a428c8558",
  "ko": "  “지금부터는 쓸 수 있다.”\n  간단한 대답이 돌아왔다.\n  어째서... 마법이란 그런 건가?\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3840,
  "addr": "0x0222CB",
  "jh": "41f8a9444e37",
  "eh": "9ef03117128e",
  "ko": "  “[NAME], 사랑을 보여 줘라.”\n  부끄러운 기색도 없이 그렇게 말을 남기고, 길은 자신의 그림자 속으로 몸을 가라앉혔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3841,
  "addr": "0x0222FF",
  "jh": "1cd2fa334e07",
  "eh": "be4d0c8aa906",
  "ko": "  “잠깐만!!! 길!!! 길!!!”\n  필사적으로 불러 세웠지만 이미 늦었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3842,
  "addr": "0x02233B",
  "jh": "c72c97f0c55b",
  "eh": "9b886218c04c",
  "ko": "  혼자 남겨졌다...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3843,
  "addr": "0x02234E",
  "jh": "0d3d3bc08f50",
  "eh": "67b8485f0a01",
  "ko": "  {사랑...}\n  조금 낯간지러운 그 말이 머릿속에서 메아리쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3844,
  "addr": "0x022376",
  "jh": "1085eb40e5b8",
  "eh": "f0877be5f86d",
  "ko": "  사랑을 보여 주라니, 어떻게 하면 되는 거지?\n  하고 고민하고 있는데, 머리 위에서 문제의 그녀가 중얼거리는 소리가 들려왔다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3845,
  "addr": "0x0223C3",
  "jh": "b18b0d908ecb",
  "eh": "0a095720bb6d",
  "ko": "          {“작다고...”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3846,
  "addr": "0x0223D7",
  "jh": "906b3201a81f",
  "eh": "cc60ef5d0242",
  "ko": "          {“작지 않거든...”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3847,
  "addr": "0x0223EF",
  "jh": "f52778a11d1e",
  "eh": "9cc6f8066b89",
  "ko": "          {“다른 놈들이 쓸데없이 클 뿐이야...”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3848,
  "addr": "0x022413",
  "jh": "6ec0e9dec8cf",
  "eh": "71b2200d0e2e",
  "ko": "          {“바보 취급이나 하고...”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3849,
  "addr": "0x022429",
  "jh": "a870e36eed01",
  "eh": "5b7de468bf87",
  "ko": "          {“다들 바보 취급이나 하고!!”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3850,
  "addr": "0x02244B",
  "jh": "0a5d125e9769",
  "eh": "fb73c32c3d24",
  "ko": "          {“죽여 버릴 거야!!!}",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3851,
  "addr": "0x02245A",
  "jh": "c5a5edd1ada2",
  "eh": "8a88e335e349",
  "ko": " {전부! 죽여!!!”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3852,
  "addr": "0x022479",
  "jh": "f80f78e191ef",
  "eh": "a7b5f3467adb",
  "ko": "  두 눈동자를 분노의 불꽃으로 이글거리며 키드가 포효했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3853,
  "addr": "0x02249D",
  "jh": "a32ddccb5177",
  "eh": "cd57f366542a",
  "ko": "  그런 키드와 딱 눈이 마주쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3854,
  "addr": "0x0224B5",
  "jh": "427edc50a638",
  "eh": "cf66066e7412",
  "ko": "  다짜고짜 괴물의 거석 같은 철퇴가 머리 위로 치켜들어졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3855,
  "addr": "0x0224E3",
  "jh": "ec037d11d554",
  "eh": "f6a3a2474aa7",
  "ko": "  • 받아 낸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3856,
  "addr": "0x0224F3",
  "jh": "8e065b1c5b13",
  "eh": "c28545797c5b",
  "ko": "  • 뒤로 달려 도망친다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3857,
  "addr": "0x022504",
  "jh": "4f6dc96b8938",
  "eh": "4a8594526288",
  "ko": "  아슬아슬하게 옆으로 굴러 피했다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3858,
  "addr": "0x02251C",
  "jh": "d34739fe7380",
  "eh": "76da5a52484c",
  "ko": "  철퇴가 땅을 꿰뚫으며 흙먼지가 솟구쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3859,
  "addr": "0x02253D",
  "jh": "56cce95b5486",
  "eh": "d3cc14d2d13d",
  "ko": "  {“받을 수 있을 리가 없잖아!!! 이런 걸!!!”}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3860,
  "addr": "0x02255B",
  "jh": "04e865577752",
  "eh": "a02dd5c0408c",
  "ko": "  순간적으로 그 자리에서 달려 도망쳤다.\n  땅이 꿰뚫리는 엄청난 굉음과 함께 흙먼지가 등 뒤로 쏟아졌다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3861,
  "addr": "0x02259E",
  "jh": "68cd17f541d6",
  "eh": "9fb5522745a0",
  "ko": "  멈춰 서서,\n  “나야, 키드! [NAME]이라고!”\n  내 이름을 외쳤다. 하지만 키드의 두 눈에서 분노의 불꽃은 꺼지지 않았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3862,
  "addr": "0x0225DC",
  "jh": "4f0530986d3f",
  "eh": "7e0a54a3fed2",
  "ko": "  땅을 울리며 괴물이 한 발을 내디뎠다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3863,
  "addr": "0x0225F8",
  "jh": "dd17a184a97c",
  "eh": "0755db5fd3ca",
  "ko": "  위험해!",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3864,
  "addr": "0x0225FE",
  "jh": "c9277553da2f",
  "eh": "db9ec713259f",
  "ko": " 도망치자...\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3865,
  "addr": "0x02260B",
  "jh": "a3176efaa07d",
  "eh": "301f1ab2d251",
  "ko": "  “뭐냐, 이 녀석은 고브!?”\n  소란을 듣고 온 것인지, 고블린 병사 세 마리의 모습이 괴물 뒤에 있었다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3866,
  "addr": "0x022644",
  "jh": "26dfbcd82cb4",
  "eh": "28d19664e6bf",
  "ko": "  “봐라 고브! 저런 데에 꼬맹이가 있다 고브!?”\n  그 말에 키드의 뺨이 경련하는 것을 나는 똑똑히 보았다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3867,
  "addr": "0x022684",
  "jh": "ea049ea6235a",
  "eh": "56f026e86f91",
  "ko": "  괴물의 몸이 홱 돌아서더니,\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3868,
  "addr": "0x022698",
  "jh": "5ae04f2f3f0a",
  "eh": "dcfad606e1d3",
  "ko": "  “{웅얼웅얼웅얼웅얼...}\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3869,
  "addr": "0x0226A3",
  "jh": "c165c5fa8142",
  "eh": "afc9945e2dd3",
  "ko": "  파이어볼!!!”\n  {큰일이다! 마법이다!}\n  길의 말이 뇌리를 스쳤다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3870,
  "addr": "0x0226F8",
  "jh": "ee095895b999",
  "eh": "54029d5624c5",
  "ko": "  키드가 날린 거대한 화구가 세 마리에게 격돌, 순식간에 숯덩이로 만들어 버렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3871,
  "addr": "0x022728",
  "jh": "4ee5ba432bd8",
  "eh": "cb632e9c84e3",
  "ko": "  {휴...}\n  나는 키드를 보며 가슴을 쓸어내렸다.\n",
  "status": "draft",
  "note": ""
 },
 {
  "i": 3872,
  "addr": "0x022744",
  "jh": "a80f89a9a7c4",
  "eh": "3ad2bcc5d4ff",
  "ko": "  무슨 일이 일어나는지는 모르겠지만, 무사한 모양이다...\n",
  "status": "draft",
  "note": ""
 },
 {
